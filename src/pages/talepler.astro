---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// JSON dosyalarını oku
const dataDir = path.join(process.cwd(), 'src/data/talepler');
let talepler = [];

if (fs.existsSync(dataDir)) {
  const files = fs.readdirSync(dataDir).filter(file => file.endsWith('.json'));
  talepler = files.map(file => {
    const content = fs.readFileSync(path.join(dataDir, file), 'utf-8');
    return JSON.parse(content);
  });
}

// Tarihe göre yeninden eskiye sırala
talepler.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
---

<BaseLayout title="MeetWork - B2B İş Talepleri">
  <div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
      <h1 class="fw-bold mb-0">Güncel İş ve Hizmet Talepleri</h1>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/ihaleler?yeni=1" class="btn btn-danger fw-bold">Ücretsiz Talep / İhale Gir</a>
        <a href="/ihaleler" class="btn btn-dark fw-bold">Canlı E-İhaleler & Teklif Ver</a>
        <a href="/talepler-panel" class="btn btn-outline-secondary">Eski Talepler</a>
      </div>
    </div>
    
    <!-- WOW Efektli Sayaç Banner -->
    <div class="card bg-danger bg-gradient text-white shadow-lg border-0 mb-5 rounded-4 overflow-hidden position-relative">
      <div class="card-body p-4 p-md-5 text-center position-relative" style="z-index: 1;">
        <h3 class="fw-bold mb-3 text-white-50 text-uppercase tracking-wider">Sistemde Teklif Bekleyen Aktif Talep Sayısı</h3>
        <div class="display-1 fw-bolder lh-1 mb-3" style="font-size: clamp(4rem, 8vw, 6rem); text-shadow: 0 4px 15px rgba(0,0,0,0.2);">
          {3105 + talepler.length}
        </div>
        <p class="lead mt-3 mb-0 fw-medium">Siz de rekabete katılın, geç kalmadan teklifinizi verip yeni iş fırsatlarını yakalayın!</p>
      </div>
      <!-- Dekoratif arka plan ikonu -->
      <i class="bi bi-briefcase-fill position-absolute text-dark" style="opacity: 0.15; font-size: 20rem; right: -5%; top: 50%; transform: translateY(-50%) rotate(-15deg); pointer-events: none;"></i>
    </div>

    <!-- 🤝 BİRLİKTE ALALIM (ORTAK SATIN ALMA HAVUZLARI - MEETWORK × DEPODANDİREKT CANLI SENKRON) -->
    <div class="mw-panel-card p-4 mb-5 shadow-sm border border-success">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
        <div>
          <span class="badge bg-success me-1">🤝 BİRLİKTE ALALIM (ORTAK ALIM HAVUZU)</span>
          <span class="badge bg-warning text-dark">⚡ Canlı Kontenjan Kilidi Aktif</span>
          <h4 class="h5 fw-bold mb-0 mt-1">
            Fabrika Çıkış Fiyatına Toptan Ortak Satın Alma Havuzları (MeetWork × DepodanDirekt)
          </h4>
          <small class="text-muted">Küçük partiler halinde katılın, 1 Palet / 1 Konteyner hedefi dolduğunda tüm katılımcılar fabrika çıkış iskontosundan yararlanır!</small>
        </div>
        <a href="https://depodandirekt.com" target="_blank" class="btn btn-sm btn-outline-success fw-bold">
          DepodanDirekt Tüm Kampanyalar →
        </a>
      </div>
      <div id="mwGroupBuysContainer" class="row g-3">
        <div class="col-12 text-center py-3 text-muted small">Ortak satın alma havuzları yükleniyor...</div>
      </div>
    </div>

    <!-- 🤝 BİRLİKTE ALALIM HAVUZUNA KATILIM MODALI (KOTA KİLİTLİ) -->
    <div class="modal fade" id="mwJoinGroupBuyModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content mw-panel-card border-success">
          <div class="modal-header border-bottom">
            <h6 class="modal-title fw-bold">
              <i class="bi bi-people-fill text-success me-1"></i> "Birlikte Alalım" Ortak Alım Havuzuna Katıl
            </h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
          </div>
          <div class="modal-body">
            <form id="mwJoinGroupBuyForm">
              <input type="hidden" id="gbJoinCampaignId" />
              <div class="p-2 rounded border mb-3 small" style="background: var(--mw-surface-alt);">
                <div class="fw-bold mb-1" id="gbJoinTitle">Havuz Başlığı</div>
                <div class="d-flex justify-content-between text-muted">
                  <span>Kalan Kontenjan Kilidi:</span>
                  <strong class="text-danger" id="gbJoinRemaining">90 Adet</strong>
                </div>
                <div class="d-flex justify-content-between text-success fw-bold mt-1">
                  <span>Ortak Alım Birim Fiyatı:</span>
                  <strong id="gbJoinPrice">1.390 TL</strong>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold mb-1">Talep Ettiğiniz Miktar *</label>
                <input type="number" id="gbJoinQty" class="form-control form-control-sm tabular-nums" min="1" value="15" required />
                <small class="text-muted" id="gbJoinMinNote" style="font-size:0.7rem;">Hedef miktarı aşmamak için kalan kontenjan kadar talep girebilirsiniz.</small>
              </div>
              <div id="gbJoinFeedback" class="small fw-bold mb-2" style="display:none;"></div>
              <button type="submit" class="btn btn-success btn-sm w-100 fw-bold py-2">
                🤝 Kontenjanımı Ayır & Ortak Alım Havuzuna Katıl
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <div class="mb-4 d-flex flex-wrap gap-2">
          <div class="btn-group shadow-sm" role="group" id="dateFilterGroup">
            <button type="button" class="btn btn-outline-danger active fw-semibold" data-filter="all">Tümü</button>
            <button type="button" class="btn btn-outline-danger fw-semibold" data-filter="today">Bugün</button>
            <button type="button" class="btn btn-outline-danger fw-semibold" data-filter="yesterday">Dün</button>
            <button type="button" class="btn btn-outline-danger fw-semibold" data-filter="week">Son 7 Gün</button>
          </div>
          
          <!-- Category Filter -->
          <div class="dropdown shadow-sm">
            <button class="btn btn-outline-danger fw-semibold dropdown-toggle" type="button" id="categoryDropdown" data-bs-toggle="dropdown" aria-expanded="false">
              Tüm Sektörler
            </button>
            <ul class="dropdown-menu shadow" aria-labelledby="categoryDropdown" style="max-height: 300px; overflow-y: auto;">
              <li><a class="dropdown-item category-filter active" href="#" data-category="all">Tüm Sektörler</a></li>
              {Array.from(new Set(talepler.map(t => t.category).filter(Boolean))).sort().map(cat => (
                 <li><a class="dropdown-item category-filter" href="#" data-category={cat}>{cat}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="list-group shadow-sm" id="taleplerList">
          {talepler.length === 0 ? (
            <div class="text-center py-5">
              <p class="text-muted">Şu an gösterilecek aktif talep bulunmamaktadır.</p>
            </div>
          ) : (
            talepler.map((talep) => (
              <a href={`/talepler/${talep.slug}`} class="list-group-item list-group-item-action p-4 border-0 border-bottom talep-item" data-publish-date={talep.publishDate} data-category={talep.category}>
                <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                  <h5 class="mb-0 fw-bold text-dark">
                    {talep.categoryEmoji && <span class="badge align-text-bottom me-2" style={`background-color: ${talep.categoryColor};`}>{talep.categoryEmoji} {talep.category}</span>}
                    {talep.title}
                  </h5>
                  <span class="badge bg-danger">{talep.status}</span>
                </div>
                <div class="d-flex w-100 justify-content-between align-items-center">
                  <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> Yayın Tarihi: {new Date(talep.publishDate).toLocaleDateString('tr-TR')}</small>
                  <small class="text-danger fw-semibold">İlan No: {talep.id}</small>
                </div>
              </a>
            ))
          )}
          <div id="empty-state" style="display: none;" class="text-center py-5">
            <p class="text-muted mb-0">Seçtiğiniz tarihte henüz bir talep işlenmemiş.</p>
          </div>
          <!-- Infinite Scroll Trigger -->
          <div id="load-more-trigger" class="text-center py-4">
            <div class="spinner-border text-danger" role="status" id="loading-spinner" style="display: none;">
              <span class="visually-hidden">Yükleniyor...</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const filterBtns = document.querySelectorAll('#dateFilterGroup .btn');
  const items = Array.from(document.querySelectorAll('.talep-item'));
  const emptyState = document.getElementById('empty-state');
  const trigger = document.getElementById('load-more-trigger');
  const spinner = document.getElementById('loading-spinner');
  
  let currentFilter = 'all';
  let currentCategory = 'all';
  let visibleLimit = 25;
  const LOAD_STEP = 25;
  
  function applyFiltersAndRender() {
    const now = new Date();
    now.setHours(0,0,0,0);
    
    // Önce filtreye uyanları bul
    const matchedItems = items.filter(item => {
      // 1. Tarih Filtresi
      const itemDateStr = item.getAttribute('data-publish-date');
      const itemDate = new Date(itemDateStr);
      const itemDateMidnight = new Date(itemDate);
      itemDateMidnight.setHours(0,0,0,0);
      
      const diffTime = now.getTime() - itemDateMidnight.getTime();
      const diffDays = Math.floor(diffTime / (1000 * 3600 * 24));
      
      let dateMatch = false;
      if(currentFilter === 'all') dateMatch = true;
      else if (currentFilter === 'today') dateMatch = diffDays === 0;
      else if (currentFilter === 'yesterday') dateMatch = diffDays === 1;
      else if (currentFilter === 'week') dateMatch = diffDays >= 0 && diffDays <= 7;
      
      // 2. Kategori Filtresi
      const itemCategory = item.getAttribute('data-category');
      let categoryMatch = false;
      if (currentCategory === 'all') categoryMatch = true;
      else if (itemCategory === currentCategory) categoryMatch = true;
      
      return dateMatch && categoryMatch;
    });
    
    // Ekranda gösterme/gizleme işlemleri
    items.forEach(item => item.style.display = 'none'); // Önce hepsini gizle
    
    const itemsToShow = matchedItems.slice(0, visibleLimit);
    itemsToShow.forEach(item => item.style.display = 'block'); // Sadece limite kadar olanları göster
    
    // Boş durum kontrolü
    if(emptyState) {
      emptyState.style.display = matchedItems.length === 0 ? 'block' : 'none';
    }
    
    // Yükleme animasyonunu gizle/göster
    if (matchedItems.length > visibleLimit) {
      spinner.style.display = 'inline-block';
    } else {
      spinner.style.display = 'none';
    }
  }

  // Filtre Butonları (Tarih)
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      currentFilter = btn.getAttribute('data-filter');
      visibleLimit = LOAD_STEP; // Filtre değişince limiti sıfırla
      applyFiltersAndRender();
    });
  });
  
  // Kategori Dropdown Seçimi
  const categoryLinks = document.querySelectorAll('.category-filter');
  const dropdownBtn = document.getElementById('categoryDropdown');
  
  categoryLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      
      // Aktif sınıfı güncelle
      categoryLinks.forEach(l => l.classList.remove('active'));
      link.classList.add('active');
      
      currentCategory = link.getAttribute('data-category');
      
      // Dropdown textini güncelle
      if(currentCategory === 'all') {
        dropdownBtn.textContent = 'Tüm Sektörler';
      } else {
        dropdownBtn.textContent = currentCategory;
      }
      
      visibleLimit = LOAD_STEP;
      applyFiltersAndRender();
    });
  });
  
  // İlk Yükleme
  applyFiltersAndRender();
  
  // Sonsuz Kaydırma (Intersection Observer)
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        visibleLimit += LOAD_STEP;
        applyFiltersAndRender();
      }
    }, { rootMargin: '100px' });
    
    observer.observe(trigger);
  }

  // 🤝 Birlikte Alalım (Ortak Satın Alma Havuzları) Canlı Yükleme & Kota Kilitli Katılım
  const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';
  const gbContainer = document.getElementById('mwGroupBuysContainer');

  window.mwOpenJoinGroupBuy = function (campaignId, title, remaining, unit, groupPrice, currency, minQty) {
    document.getElementById('gbJoinCampaignId').value = campaignId;
    document.getElementById('gbJoinTitle').textContent = title;
    document.getElementById('gbJoinRemaining').textContent = `${remaining} ${unit}`;
    document.getElementById('gbJoinPrice').textContent = `${Number(groupPrice).toLocaleString('tr-TR')} ${currency} / ${unit}`;
    const qtyInput = document.getElementById('gbJoinQty');
    qtyInput.min = String(Math.min(Number(minQty || 1), Number(remaining || 1)));
    qtyInput.max = String(remaining);
    qtyInput.value = String(Math.min(Number(minQty || 10), Number(remaining || 10)));
    document.getElementById('gbJoinMinNote').textContent = `Min. katılım: ${minQty} ${unit} • Kalan üst sınır (Kota Kilidi): ${remaining} ${unit}`;
    const fb = document.getElementById('gbJoinFeedback');
    if (fb) fb.style.display = 'none';
    const modalEl = document.getElementById('mwJoinGroupBuyModal');
    if (modalEl && window.bootstrap) new window.bootstrap.Modal(modalEl).show();
  };

  async function loadGroupBuys() {
    if (!gbContainer) return;
    try {
      const res = await fetch(`${API_URL}/api/bridge/group-buys`);
      const data = await res.json();
      const pools = data.pools || [];
      if (pools.length === 0) {
        gbContainer.innerHTML = `<div class="col-12 text-center text-muted small py-2">Aktif ortak alım havuzu bulunmuyor.</div>`;
        return;
      }

      gbContainer.innerHTML = pools.map(p => {
        const pct = Math.min(100, Math.round((Number(p.current_qty) / Math.max(1, Number(p.target_qty))) * 100));
        const rem = Math.max(0, Number(p.target_qty) - Number(p.current_qty));
        const discountPct = Math.round(((Number(p.normal_unit_price) - Number(p.group_unit_price)) / Math.max(1, Number(p.normal_unit_price))) * 100);
        return `
          <div class="col-md-4">
            <div class="p-3 rounded border h-100 d-flex flex-column justify-content-between" style="background: var(--mw-surface); border-left: 4px solid #16a34a !important;">
              <div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="badge bg-success" style="font-size:0.66rem;">-%${discountPct} Fabrika Çıkış İndirimi</span>
                  <small class="text-muted fw-bold tabular-nums">#${p.campaign_id}</small>
                </div>
                <h6 class="fw-bold small mb-1">${p.title}</h6>
                <div class="small text-muted mb-2" style="font-size:0.73rem;">
                  🏭 <strong>Üretici:</strong> ${p.supplier_name} • 👥 <strong>${p.participants_count || 1} Firma Katıldı</strong>
                </div>
                <div class="d-flex justify-content-between small mb-1">
                  <span class="text-muted text-decoration-line-through">Normal: ${Number(p.normal_unit_price).toLocaleString('tr-TR')} ${p.currency}</span>
                  <strong class="text-success">Havuz Fiyatı: ${Number(p.group_unit_price).toLocaleString('tr-TR')} ${p.currency} / ${p.unit}</strong>
                </div>
                <div class="progress mb-1" style="height: 8px;">
                  <div class="progress-bar bg-success" role="progressbar" style="width: ${pct}%"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-2" style="font-size:0.7rem;">
                  <span>Toplanan: <strong>${p.current_qty} / ${p.target_qty} ${p.unit} (%${pct})</strong></span>
                  <span class="text-danger fw-bold">Kalan: ${rem} ${p.unit}</span>
                </div>
              </div>
              <div class="d-flex gap-2 pt-2 border-top">
                ${rem > 0 ? `
                  <button type="button" class="btn btn-success btn-sm w-100 fw-bold" onclick="window.mwOpenJoinGroupBuy('${p.campaign_id}', '${(p.title || '').replace(/'/g, '')}', ${rem}, '${p.unit}', ${p.group_unit_price}, '${p.currency}', ${p.min_order_qty || 5})">
                    🤝 Havuza Katıl (${rem} ${p.unit} Kaldı)
                  </button>
                ` : `
                  <span class="badge bg-secondary w-100 py-2">🎉 Havuz %100 Doldu</span>
                `}
              </div>
            </div>
          </div>
        `;
      }).join('');
    } catch (_) {}
  }

  loadGroupBuys();

  const gbForm = document.getElementById('mwJoinGroupBuyForm');
  if (gbForm) {
    gbForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fb = document.getElementById('gbJoinFeedback');
      try {
        const res = await fetch(`${API_URL}/api/bridge/group-buy-join`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            campaign_id: document.getElementById('gbJoinCampaignId').value,
            requested_qty: Number(document.getElementById('gbJoinQty').value || 10)
          })
        });
        const out = await res.json();
        if (fb) {
          fb.style.display = 'block';
          fb.className = `small fw-bold mb-2 ${out.success ? 'text-success' : 'text-danger'}`;
          fb.textContent = out.message || 'İşlem tamamlandı.';
        }
        if (out.success) {
          await loadGroupBuys();
        }
      } catch (_) {}
    });
  }
});
</script>
