---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// JSON dosyalarını oku
const dataDir = path.join(process.cwd(), 'src/data/talepler');
let talepler = [];

if (fs.existsSync(dataDir)) {
  const files = fs.readdirSync(dataDir).filter(file => file.endsWith('.json'));
  talepler = files.map(file => {
    const content = fs.readFileSync(path.join(dataDir, file), 'utf-8');
    return JSON.parse(content);
  });
}

// Tarihe göre yeninden eskiye sırala
talepler.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
---

<BaseLayout title="MeetWork - B2B İş Talepleri">
  <div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
      <h1 class="fw-bold text-dark mb-0">Güncel İş ve Hizmet Talepleri</h1>
      <div class="d-flex gap-2 flex-wrap">
        <a href="https://panel.meetwork.net/" class="btn btn-danger">Ücretsiz Talep Gir</a>
        <a href="https://panel.meetwork.net/" class="btn btn-primary">Ücretsiz Teklif Gir</a>
        <a href="/talepler-panel" class="btn btn-outline-secondary">Eski Talepler</a>
      </div>
    </div>
    
    <p class="text-muted mb-5">Sistemimize düşen en güncel B2B iş fırsatları ve talepleri aşağıda listelenmiştir. Detayları görmek ve iletişime geçmek için taleplere tıklayınız.</p>

    <div class="row">
      <div class="col-12">
        <div class="list-group shadow-sm">
          {talepler.length === 0 ? (
            <div class="text-center py-5">
              <p class="text-muted">Şu an gösterilecek aktif talep bulunmamaktadır.</p>
            </div>
          ) : (
            talepler.map((talep) => (
              <a href={`/talepler/${talep.slug}`} class="list-group-item list-group-item-action p-4 border-0 border-bottom">
                <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                  <h5 class="mb-0 fw-bold text-dark">{talep.title}</h5>
                  <span class="badge bg-danger">{talep.status}</span>
                </div>
                <div class="d-flex w-100 justify-content-between align-items-center">
                  <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> Yayın Tarihi: {new Date(talep.publishDate).toLocaleDateString('tr-TR')}</small>
                  <small class="text-danger fw-semibold">İlan No: {talep.id}</small>
                </div>
              </a>
            ))
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
