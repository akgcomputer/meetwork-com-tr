---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// JSON dosyalarını oku
const dataDir = path.join(process.cwd(), 'src/data/talepler');
let talepler = [];

if (fs.existsSync(dataDir)) {
  const files = fs.readdirSync(dataDir).filter(file => file.endsWith('.json'));
  talepler = files.map(file => {
    const content = fs.readFileSync(path.join(dataDir, file), 'utf-8');
    return JSON.parse(content);
  });
}

// Tarihe göre yeninden eskiye sırala
talepler.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
---

<BaseLayout title="MeetWork - B2B İş Talepleri">
  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="fw-bold text-dark">Güncel İş ve Hizmet Talepleri</h1>
      <a href="/talepler-panel" class="btn btn-outline-danger">Panel'e Git</a>
    </div>
    
    <p class="text-muted mb-5">Sistemimize düşen en güncel B2B iş fırsatları ve talepleri aşağıda listelenmiştir. Detayları görmek ve iletişime geçmek için taleplere tıklayınız.</p>

    <div class="row g-4">
      {talepler.length === 0 ? (
        <div class="col-12 text-center py-5">
          <p class="text-muted">Şu an gösterilecek aktif talep bulunmamaktadır.</p>
        </div>
      ) : (
        talepler.map((talep) => (
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="badge bg-danger">{talep.status}</span>
                  <small class="text-muted">{new Date(talep.publishDate).toLocaleDateString('tr-TR')}</small>
                </div>
                <h5 class="card-title fw-bold mt-3">
                  <a href={`/talepler/${talep.slug}`} class="text-decoration-none text-dark stretched-link">
                    {talep.title}
                  </a>
                </h5>
                <p class="card-text text-muted small">{talep.company}</p>
              </div>
              <div class="card-footer bg-white border-top-0 pb-3">
                <span class="text-danger fw-semibold small">İlan No: {talep.id}</span>
              </div>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</BaseLayout>
