  <script is:inline>
    (function () {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';
      let loadedTendersCache = [];

      function methodBadge(m) {
        if (m === 'open_decrement') return '<span class="badge bg-danger">📉 Açık Eksiltme (+Son 2 Dk Korumalı)</span>';
        if (m === 'sealed_envelope') return '<span class="badge bg-dark">✉️ Kapalı Zarf</span>';
        if (m === 'english_auction') return '<span class="badge bg-warning text-dark">🏆 İngiliz Usulü</span>';
        return '<span class="badge bg-secondary">⚡ Hızlı Teklif Talebi</span>';
      }

      function trustLockBadge(minTrust) {
        const lvl = Number(minTrust || 1);
        if (lvl >= 3) return '<span class="badge bg-warning text-dark fw-bold">🔒 Sadece 🥇 Gold Onaylılar</span>';
        if (lvl === 2) return '<span class="badge bg-secondary text-white fw-bold">🔒 Sadece 🥈 Silver & Gold Onaylılar</span>';
        return '<span class="badge bg-success-subtle text-success">🔗 Hızlı Teklif Linki Açık</span>';
      }

      window.mwOpenSafePayModal = function (id, title, lowestBid) {
        document.getElementById('spayTenderId').value = id;
        document.getElementById('spayTenderTitle').value = title;
        if (lowestBid && Number(lowestBid) > 0) {
          document.getElementById('spaySubtotal').value = Number(lowestBid);
        }
        const rb = document.getElementById('spayResultBox');
        if (rb) rb.style.display = 'none';
        const modalEl = document.getElementById('mwTenderToSafePayModal');
        if (window.bootstrap && modalEl) {
          new window.bootstrap.Modal(modalEl).show();
        }
      };

      async function loadTenders(method = 'all') {
        const listEl = document.getElementById('mwLiveTendersList');
        if (!listEl) return;
        try {
          const qs = method !== 'all' ? `?method=${encodeURIComponent(method)}` : '';
          const res = await fetch(`${API_URL}/api/tenders${qs}`);
          const data = await res.json();
          const tenders = data.tenders || [];
          loadedTendersCache = tenders;

          if (tenders.length === 0) {
            listEl.innerHTML = `
              <div class="col-12">
                <div class="mw-panel-card p-4 text-center">
                  <i class="bi bi-hammer fs-2 text-danger"></i>
                  <h6 class="fw-bold mt-2">Bu kategoride aktif canlı e-ihale bulunmuyor</h6>
                  <p class="small text-muted mb-3">İlk Açık Eksiltme veya Kapalı Zarf ihalenizi hemen başlatıp tedarikçilerinize davet gönderebilirsiniz.</p>
                  <button class="btn btn-sm btn-danger fw-bold" data-bs-toggle="modal" data-bs-target="#newTenderModal">+ Yeni E-İhale Başlat</button>
                </div>
              </div>`;
            return;
          }

          const urlParams = new URLSearchParams(window.location.search);
          const magicSlug = urlParams.get('tender') || urlParams.get('ihale') || '';

          listEl.innerHTML = tenders.map((t) => {
            const isHighlighted = magicSlug && (t.slug === magicSlug || t.id === magicSlug || t.tender_no === magicSlug);
            return `
            <div class="col-md-6">
              <div class="mw-panel-card p-3 h-100 d-flex flex-column justify-content-between shadow-sm ${isHighlighted ? 'border-danger border-3' : ''}" style="border-left: 4px solid #ef4444 !important;">
                <div>
                  ${isHighlighted ? `<div class="badge bg-danger w-100 py-2 mb-2">⚡ HIZLI TEKLİF MASASI (30 Saniyede Teklif Verin)</div>` : ''}
                  <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-2">
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                      ${methodBadge(t.tender_method)}
                      ${trustLockBadge(t.min_trust_level)}
                      ${t.is_group_buy ? '<span class="badge bg-success">🤝 Birlikte Alalım Havuzu</span>' : ''}
                    </div>
                    <small class="text-muted fw-bold tabular-nums">#${t.tender_no}</small>
                  </div>
                  <h6 class="fw-bold mb-1">${t.title}</h6>
                  <div class="small text-muted mb-2">
                    <strong>Alıcı:</strong> ${t.buyer_name} • <strong>Miktar:</strong> <span class="tabular-nums">${t.quantity} ${t.unit}</span> • <strong>Teslim:</strong> ${t.delivery_location || 'İstanbul'}
                  </div>
                  <p class="small text-muted mb-2">${t.description}</p>
                </div>

                <div class="pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color:var(--mw-border)!important;">
                  <div class="small tabular-nums">
                    <span class="text-muted">Teklif Sayısı:</span> <strong>${t.bids_count || 0}</strong>
                    ${t.tender_method === 'open_decrement' && t.lowest_bid ? ` • <span class="text-danger fw-bold">En Düşük: ${Number(t.lowest_bid).toLocaleString('tr-TR')} ${t.currency}</span>` : ''}
                    ${t.tender_method === 'sealed_envelope' ? ` • <span class="text-muted fst-italic">🔒 Zarf Kapalı</span>` : ''}
                  </div>
                  <div class="d-flex gap-1">
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-success fw-bold"
                      title="Kazanan Teklifi Güvenli Ödeme Havuzuna (Proforma) & StokPratik Siparişe Aktar"
                      onclick="window.mwOpenSafePayModal('${t.id}', '${(t.title || '').replace(/'/g, '')}', '${t.lowest_bid || 55000}')"
                    >
                      🛡️ Güvenli Ödeme Proforması
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm btn-danger fw-bold"
                      onclick="window.mwOpenBidModal('${t.id}', '${(t.title || '').replace(/'/g, '')}')"
                    >
                      ⚡ Teklif Ver
                    </button>
                  </div>
                </div>
              </div>
            </div>
          `;
          }).join('');

          const mobTendersList = document.getElementById('mwMobileLiveTendersList');
          if (mobTendersList) {
            mobTendersList.innerHTML = tenders.map((t) => `
              <article class="bg-surface-card rounded-2xl p-space-md shadow-sm border border-border-light flex flex-col gap-3">
                <div class="flex items-center justify-between flex-wrap gap-1">
                  <span class="px-2.5 py-0.5 rounded-full bg-cherry-vibrant/10 text-cherry-vibrant font-label-sm text-label-sm font-bold">
                    🔴 Canlı E-İhale • #${t.tender_no || t.id}
                  </span>
                  <span class="font-label-sm text-label-sm text-on-surface-variant">${t.delivery_location || 'İstanbul'}</span>
                </div>
                <div>
                  <h3 class="font-headline-sm text-headline-sm text-navy-deep font-bold">${t.title}</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">${t.description || ''}</p>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-border-subtle flex-wrap gap-2">
                  <span class="font-label-md text-label-md text-navy-deep font-bold">Miktar: ${t.quantity} ${t.unit}</span>
                  <div class="flex items-center gap-1.5">
                    <button type="button" class="px-3 py-1.5 rounded-xl bg-trust-emerald text-white font-label-sm text-label-sm font-bold" onclick="window.mwOpenSafePayModal('${t.id}', '${(t.title || '').replace(/'/g, '')}', '${t.lowest_bid || 55000}')">
                      🛡️ Güvenli Ödeme
                    </button>
                    <button type="button" class="px-3.5 py-1.5 rounded-xl bg-cherry-vibrant text-white font-label-sm text-label-sm font-bold" onclick="window.mwOpenBidModal('${t.id}', '${(t.title || '').replace(/'/g, '')}')">
                      ⚡ Teklif Ver
                    </button>
                  </div>
                </div>
              </article>
            `).join('');
          }

          if (magicSlug) {
            const targetT = tenders.find((t) => t.slug === magicSlug || t.id === magicSlug || t.tender_no === magicSlug);
            if (targetT) {
              window.mwOpenBidModal(targetT.id, targetT.title);
            }
          }
        } catch (_) {}
      }

      window.mwOpenBidModal = function (id, title) {
        document.getElementById('bidTenderId').value = id;
        document.getElementById('bidTenderTitleBox').textContent = title;
        const modalEl = document.getElementById('bidTenderModal');
        if (window.bootstrap && modalEl) {
          new window.bootstrap.Modal(modalEl).show();
        }
      };

      document.addEventListener('DOMContentLoaded', () => {
        try {
          const u = JSON.parse(localStorage.getItem('mw_user') || 'null');
          if (u) {
            const bName = document.getElementById('ntBuyerName');
            if (bName) bName.value = u.company_name || u.full_name || '';
            const sName = document.getElementById('bidSupplierName');
            if (sName) sName.value = u.company_name || u.full_name || '';
            const sPhone = document.getElementById('bidSupplierPhone');
            if (sPhone && u.phone) sPhone.value = u.phone;
          }
        } catch (_) {}

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('yeni') === '1') {
          setTimeout(() => {
            const triggerBtn = document.querySelector('[data-bs-target="#newTenderModal"]');
            if (triggerBtn) triggerBtn.click();
          }, 350);
        }

        loadTenders();

        document.querySelectorAll('.mw-tender-filter').forEach((btn) => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.mw-tender-filter').forEach(b => b.className = 'btn btn-sm btn-outline-danger mw-tender-filter');
            btn.className = 'btn btn-sm btn-danger mw-tender-filter';
            loadTenders(btn.getAttribute('data-method'));
          });
        });

        document.getElementById('mwCreateTenderForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          let u = null;
          try { u = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}

          const payload = {
            company_id: u ? u.company_id : '',
            trust_level: u ? u.trust_level : 1,
            min_trust_level: Number(document.getElementById('ntMinTrustLevel')?.value || 1),
            tender_method: document.getElementById('ntMethod').value,
            category: document.getElementById('ntCategory').value,
            title: document.getElementById('ntTitle').value,
            quantity: document.getElementById('ntQuantity').value,
            unit: document.getElementById('ntUnit').value,
            target_price: document.getElementById('ntTargetPrice').value,
            payment_terms: document.getElementById('ntPaymentTerms').value,
            buyer_name: document.getElementById('ntBuyerName').value,
            delivery_location: document.getElementById('ntDeliveryCity').value,
            description: document.getElementById('ntDescription').value,
            is_group_buy: document.getElementById('ntIsGroupBuy').checked ? 1 : 0
          };

          try {
            const res = await fetch(`${API_URL}/api/tenders`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const out = await res.json();
            if (out.success) {
              alert(`${out.message}\n\nÖzel Davet Linkiniz (Magic Link):\n${out.magic_link}`);
              window.location.reload();
            }
          } catch (_) {}
        });

        document.getElementById('mwBidForm').addEventListener('submit', async (e) => {
          e.preventDefault();
          let u = null;
          try { u = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}

          const tenderId = document.getElementById('bidTenderId').value;
          const payload = {
            supplier_company_id: u ? u.company_id : '',
            supplier_trust_level: u ? u.trust_level : 1,
            supplier_name: document.getElementById('bidSupplierName').value,
            supplier_phone: document.getElementById('bidSupplierPhone').value,
            supplier_vkn: document.getElementById('bidSupplierVkn').value,
            price: document.getElementById('bidPrice').value,
            delivery_days: document.getElementById('bidDeliveryDays').value,
            note: document.getElementById('bidNote').value
          };

          try {
            const res = await fetch(`${API_URL}/api/tenders/${encodeURIComponent(tenderId)}/bid`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const out = await res.json();
            if (!out.success) {
              alert(out.message || 'Teklif iletilemedi.');
              return;
            }

            // Close bid modal
            const bidModalEl = document.getElementById('bidTenderModal');
            if (bidModalEl && window.bootstrap) {
              window.bootstrap.Modal.getInstance(bidModalEl)?.hide();
            }

            await loadTenders();

            // If user is not logged in, trigger Magic Link Viral Hook Modal!
            if (!u && out.prefill_signup) {
              document.getElementById('viralHookRankBanner').textContent =
                `Şu an bu ihalede ${out.bid_rank || 1}. sıradasınız! (Toplam ${out.total_bids || 1} teklif)`;
              document.getElementById('viralHookSubBanner').textContent = out.viral_hook_text || out.message;
              document.getElementById('vhCompanyName').value = out.prefill_signup.company_name || payload.supplier_name;
              document.getElementById('vhPhone').value = out.prefill_signup.phone || payload.supplier_phone;
              document.getElementById('vhVkn').value = out.prefill_signup.vkn || payload.supplier_vkn || '';
              const vhModal = new window.bootstrap.Modal(document.getElementById('magicViralHookModal'));
              vhModal.show();
            } else {
              alert(out.message);
            }
          } catch (_) {}
        });

        // Viral Hook 1-Click Signup Submit
        document.getElementById('mwViralQuickSignupForm')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const payload = {
            company_name: document.getElementById('vhCompanyName').value,
            full_name: document.getElementById('vhCompanyName').value,
            phone: document.getElementById('vhPhone').value,
            vkn: document.getElementById('vhVkn').value,
            email: document.getElementById('vhEmail').value,
            password: document.getElementById('vhPassword').value,
            sector: 'Toptan & Dış Ticaret (İhracat/İthalat)',
            city: 'İstanbul'
          };
          try {
            const res = await fetch(`${API_URL}/api/auth/register`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const out = await res.json();
            if (out.success && out.user) {
              localStorage.setItem('mw_user', JSON.stringify(out.user));
              localStorage.setItem('mw_token', out.token || '');
              alert('🎉 Kurumsal üyeliğiniz tek tıkla oluşturuldu! Artık rakip teklif bildirimlerini anında alacaksınız.');
              window.location.reload();
            } else {
              alert(out.message || 'Kayıt tamamlanamadı.');
            }
          } catch (_) {}
        });

        // 🛡️ İhaleden "Güvenli Ödeme Havuzuna (Proforma)" & StokPratik Siparişe Aktarım
        document.getElementById('mwTenderToSafePayForm')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const freightRaw = document.getElementById('spayFreightCost').value;
          const payload = {
            tender_id: document.getElementById('spayTenderId').value,
            title: document.getElementById('spayTenderTitle').value,
            subtotal: Number(document.getElementById('spaySubtotal').value || 55000),
            vat_rate: Number(document.getElementById('spayVatRate').value || 20),
            freight_cost: freightRaw === '' ? null : Number(freightRaw),
            currency: document.getElementById('spayCurrency').value || 'TRY',
            incoterms: document.getElementById('spayIncoterms').value || 'EXW'
          };
          const rb = document.getElementById('spayResultBox');
          try {
            const res = await fetch(`${API_URL}/api/bridge/tender-to-escrow`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const out = await res.json();
            if (rb) {
              rb.style.display = 'block';
              rb.innerHTML = `
                <div class="fw-bold text-success mb-1">✅ ${out.message}</div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                  <a href="${out.dd_checkout_url || 'https://depodandirekt.com'}" target="_blank" class="btn btn-sm btn-success fw-bold">
                    🛡️ DepodanDirekt Güvenli Ödeme Proformasını Aç →
                  </a>
                  <a href="${out.sp_purchase_order_url || 'https://stokpratik.com'}" target="_blank" class="btn btn-sm btn-dark fw-bold">
                    📦 StokPratik Satınalma Siparişini Gör →
                  </a>
                </div>
              `;
            }
          } catch (_) {}
        });
      });
    })();
  </script>
</BaseLayout>
