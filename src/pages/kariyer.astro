---
import BaseLayout from '../layouts/BaseLayout.astro';

const CITIES = [
  'İstanbul', 'Ankara', 'İzmir', 'Bursa', 'Kocaeli', 'Gaziantep', 'Konya',
  'Kayseri', 'Antalya', 'Adana', 'Mersin', 'Denizli', 'Manisa', 'Sakarya', 'Eskişehir'
];

const DEPARTMENTS = [
  'Yazılım, Teknoloji & Ar-Ge',
  'Dış Ticaret & İhracat',
  'Üretim, Mühendislik & Fabrika',
  'Finans, Muhasebe & ERP',
  'B2B Satış & Satınalma',
  'Lojistik, Depo & Filo'
];

const TARGET_SECTORS = [
  'Tekstil',
  'Tekstil & Hazır Giyim',
  'Makine & Ekipman Üretimi',
  'Yazılım & Bilişim',
  'Gıda, Tarım & İçecek',
  'Metal & Çelik Üretim',
  'Lojistik, Nakliyat & Filo',
  'Otomotiv & Yan Sanayi',
  'Plastik, Kauçuk & Ambalaj',
  'İnşaat, Yapı & Gayrimenkul'
];

const TARGET_POSITIONS = [
  'IT Uzmanı',
  'Full-Stack Yazılım Uzmanı',
  'İhracat Müdürü',
  'Dış Ticaret Operasyon Uzmanı',
  'Üretim Planlama & Fabrika Şefi',
  'CNC Lazer & CAM Uzmanı',
  'ERP & Finansman Yöneticisi',
  'Ön Muhasebe & E-Fatura Uzmanı',
  'Satınalma & İhale Müdürü',
  'Lojistik Operasyon Yöneticisi'
];
---

<BaseLayout
  title="Doğrulanmış Adayı Bulun | MeetWork Kariyer & İK Vitrini"
  description="MeetWork doğrulanmış aday havuzu. Sektör, pozisyon, uzmanlık etiketi ve devlet istihdam teşviki uyumuyla aradığınız personeli veya uzmanı hemen bulun."
>
  <style is:global>
    .mw-career-hero {
      background: linear-gradient(135deg, #0b0b0e 0%, #1a1c24 60%, #7f1d1d 100%);
      border-radius: 14px;
      border: 1px solid rgba(220, 53, 69, 0.35);
      color: #ffffff;
    }
    .mw-candidate-card {
      background: var(--mw-surface);
      border: 1px solid var(--mw-border);
      border-top: 3px solid var(--mw-red);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      height: 100%;
      transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
    }
    .mw-candidate-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.11);
      border-color: var(--mw-red);
    }
    .mw-candidate-photo {
      width: 58px;
      height: 58px;
      border-radius: 12px;
      object-fit: cover;
      border: 2px solid rgba(220, 53, 69, 0.35);
      flex-shrink: 0;
      background: #1e293b;
    }
    .mw-candidate-h2 {
      font-size: 1.02rem;
      font-weight: 800;
      margin: 0;
      line-height: 1.25;
      color: var(--mw-text);
    }
    .mw-candidate-h3 {
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--mw-red);
      margin: 2px 0 3px 0;
      line-height: 1.3;
    }
    .mw-candidate-meta {
      font-size: 0.72rem;
      color: var(--mw-text-muted);
      font-weight: 600;
    }
    .mw-subsidy-strip {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.14) 0%, rgba(5, 150, 105, 0.06) 100%);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: #065f46;
      border-radius: 8px;
      padding: 5px 8px;
      font-size: 0.7rem;
      font-weight: 700;
      line-height: 1.35;
    }
    [data-theme="dark"] .mw-subsidy-strip {
      color: #6ee7b7;
      border-color: rgba(52, 211, 153, 0.35);
    }
    .mw-skill-chip {
      display: inline-flex;
      align-items: center;
      padding: 2px 7px;
      border-radius: 6px;
      font-size: 0.68rem;
      font-weight: 600;
      background: var(--mw-surface-alt);
      border: 1px solid var(--mw-border);
      color: var(--mw-text);
    }
    .mw-lang-chip {
      display: inline-flex;
      align-items: center;
      padding: 2px 7px;
      border-radius: 6px;
      font-size: 0.68rem;
      font-weight: 700;
      background: rgba(13, 110, 253, 0.1);
      border: 1px solid rgba(13, 110, 253, 0.3);
      color: #0d6efd;
    }
    [data-theme="dark"] .mw-lang-chip {
      color: #60a5fa;
    }
    .mw-target-box {
      background: var(--mw-surface-alt);
      border: 1px dashed var(--mw-border);
      border-radius: 8px;
      padding: 6px 9px;
      font-size: 0.73rem;
    }
    .mw-quick-filter-tag {
      font-size: 0.7rem;
      padding: 3px 8px;
      border-radius: 20px;
      border: 1px solid var(--mw-border);
      background: var(--mw-surface-alt);
      color: var(--mw-text);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .mw-quick-filter-tag:hover,
    .mw-quick-filter-tag.active {
      background: var(--mw-red);
      color: #fff;
      border-color: var(--mw-red);
    }
  </style>

  <!-- ÜST KARİYER BAŞLIĞI VE BAĞIMSIZ SAYFA NAVİGASYONU -->
  <section class="mw-career-hero p-3 p-md-4 mb-4 shadow-sm">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
      <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
          <span class="badge bg-danger">MEETWORK KARİYER & İK</span>
          <span class="badge bg-success"><i class="bi bi-cash-coin me-1"></i>SGK 6111 • İŞKUR • KOSGEB • TÜBİTAK Teşvikli İstihdam</span>
        </div>
        <h1 class="h4 fw-black mb-1">🔍 Doğrulanmış Adayı Bulun</h1>
        <p class="small text-white-50 mb-0">
          Açık profil, doğrulanmış yetenek etiketleri, hedef sektör/pozisyon ve devlet istihdam teşviki uyumuyla aradığınız uzmana doğrudan mülakat teklifi gönderin.
        </p>
      </div>

      <!-- Çok Sayfalı Net Navigasyon Butonları -->
      <div class="d-flex flex-wrap gap-2 flex-shrink-0">
        <a href="/kariyer" class="btn btn-danger btn-sm fw-bold px-3">
          🔍 Doğrulanmış Adayı Bulun
        </a>
        <a href="/kariyer/is-ara" class="btn btn-outline-light btn-sm fw-bold px-3">
          📢 İş İlanlarını İncele
        </a>
        <a href="/kariyer/cv-olustur" class="btn btn-warning text-dark btn-sm fw-bold px-3">
          <i class="bi bi-person-vcard-fill me-1"></i> İş Arıyorum / Özgeçmiş (CV) Oluştur
        </a>
        <a href="/kariyer/profilim" class="btn btn-info text-dark btn-sm fw-bold px-3">
          👤 Aday Profilim & Başvurularım
        </a>
        <!-- Sadece Kurumsal Giriş Yapmış İşverenlere Görünür -->
        <a href="/isletmeler#mwEmployerHrPanel" id="mwEmployerPostJobBtn" class="btn btn-success btn-sm fw-bold px-3" style="display:none;">
          <i class="bi bi-building-fill-add me-1"></i> İşletmem İçin İlan Aç
        </a>
      </div>
    </div>
  </section>

  <!-- ANA SAYFA DÜZENİ: SOL SÜTUN FİLTRELER (%25) + SAĞ SÜTUN YAN YANA 3 ADAY KARTI (%75) -->
  <div class="row g-3 g-lg-4">

    <!-- SOL SÜTUN: FİLTRELER (Mobilde Açılır/Kapanır, Masaüstünde Sabit) -->
    <div class="col-lg-3">
      <!-- Mobil Filtre Aç/Kapat Butonu -->
      <div class="d-lg-none mb-2">
        <button
          class="btn btn-outline-danger w-100 fw-bold btn-sm d-flex justify-content-between align-items-center py-2"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mwCareerSidebarCollapse"
          aria-expanded="false"
        >
          <span><i class="bi bi-funnel-fill me-1"></i> Aday Filtrelerini Göster / Gizle</span>
          <i class="bi bi-chevron-down"></i>
        </button>
      </div>

      <div class="collapse d-lg-block" id="mwCareerSidebarCollapse">
        <div class="mw-panel-card p-3 shadow-sm sticky-top" style="top: 86px;">
          <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
            <h2 class="h6 fw-bold mb-0">
              <i class="bi bi-sliders text-danger me-1"></i> Aday Filtreleme
            </h2>
            <button type="button" id="fltResetAllBtn" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-semibold" style="font-size:0.74rem;">
              Temizle
            </button>
          </div>

          <form id="mwCandidateFilterForm" class="d-flex flex-column gap-3">
            <div>
              <label class="form-label small fw-bold mb-1">Departman / Uzmanlık</label>
              <select id="fltDepartment" class="form-select form-select-sm">
                <option value="Tümü">Tüm Departmanlar</option>
                {DEPARTMENTS.map(d => <option value={d}>{d}</option>)}
              </select>
            </div>

            <div>
              <label class="form-label small fw-bold mb-1">İş Aradığı Sektör</label>
              <select id="fltTargetSector" class="form-select form-select-sm">
                <option value="Tümü">Tüm Sektörler</option>
                {TARGET_SECTORS.map(s => <option value={s}>{s}</option>)}
              </select>
            </div>

            <div>
              <label class="form-label small fw-bold mb-1">İş Aradığı Pozisyon</label>
              <select id="fltTargetPosition" class="form-select form-select-sm">
                <option value="Tümü">Tüm Pozisyonlar</option>
                {TARGET_POSITIONS.map(p => <option value={p}>{p}</option>)}
              </select>
            </div>

            <div>
              <label class="form-label small fw-bold mb-1">Şehir</label>
              <select id="fltCity" class="form-select form-select-sm">
                <option value="Tümü">81 İl (Tümü)</option>
                {CITIES.map(c => <option value={c}>{c}</option>)}
              </select>
            </div>

            <div>
              <label class="form-label small fw-bold mb-1">Çalışma Şekli</label>
              <select id="fltWorkMode" class="form-select form-select-sm">
                <option value="Tümü">Tüm Çalışma Modelleri</option>
                <option value="Tam Zamanlı">Tam Zamanlı (Saha / Ofis)</option>
                <option value="Hibrit">Hibrit</option>
                <option value="Uzaktan">Uzaktan (Remote)</option>
                <option value="Proje Bazlı">⚡ Dönemsel / Proje Bazlı Uzman</option>
              </select>
            </div>

            <div>
              <label class="form-label small fw-bold mb-1">Yetenek Etiketi, ERP veya Makine Ara</label>
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-transparent text-danger"><i class="bi bi-search"></i></span>
                <input
                  type="text"
                  id="fltSkillQuery"
                  class="form-control"
                  placeholder="Örn: CNC, StokPratik, İhracat..."
                />
              </div>
            </div>

            <div>
              <div class="small fw-bold mb-1" style="font-size:0.74rem;">Hızlı Etiketler:</div>
              <div class="d-flex flex-wrap gap-1">
                <button type="button" class="mw-quick-filter-tag" data-skill="StokPratik">StokPratik</button>
                <button type="button" class="mw-quick-filter-tag" data-skill="TypeScript">TypeScript & Node.js</button>
                <button type="button" class="mw-quick-filter-tag" data-skill="CNC">CNC Lazer</button>
                <button type="button" class="mw-quick-filter-tag" data-skill="İhracat">İhracat</button>
                <button type="button" class="mw-quick-filter-tag" data-skill="E-Fatura">E-Fatura</button>
                <button type="button" class="mw-quick-filter-tag" data-skill="TÜBİTAK">TÜBİTAK Ar-Ge</button>
                <button type="button" class="mw-quick-filter-tag" data-skill="SolidWorks">SolidWorks</button>
              </div>
            </div>
          </form>

          <hr class="my-3" />

          <div class="p-2 rounded border text-center" style="background:var(--mw-surface-alt);">
            <div class="small fw-bold mb-1">Siz de İş mi Arıyorsunuz?</div>
            <p class="text-muted mb-2" style="font-size:0.72rem;">
              90 saniyede fotoğrafınız, yetenek etiketleriniz ve aradığınız sektörle özgeçmişinizi oluşturun.
            </p>
            <a href="/kariyer/cv-olustur" class="btn btn-danger btn-sm w-100 fw-bold">
              İş Arıyorum / Özgeçmiş (CV) Oluştur
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- SAĞ SÜTUN: YAN YANA 3 DAR KİŞİ KARTI (col-xl-4 col-md-6 col-12) -->
    <div class="col-lg-9">
      <!-- Üst Bilgi Bandı -->
      <div class="mw-panel-card p-2 px-3 mb-3 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="small fw-bold">
          🔍 Toplam <span id="mwTalentCountBadge" class="text-danger tabular-nums">6</span> doğrulanmış aday listeleniyor
          <span id="mwActiveFilterNotice" class="badge bg-danger-subtle text-danger ms-1" style="display:none;">Arama Kriterlerine Göre %Uyum Sıralı</span>
        </div>
        <div class="d-flex align-items-center gap-2 small">
          <a href="/kariyer/is-ara" class="text-danger fw-bold text-decoration-none" style="font-size:0.78rem;">
            📢 Açık İş İlanlarına Git →
          </a>
        </div>
      </div>

      <!-- 3 Sütunlu Aday Kartları Grid Alanı -->
      <div class="row g-3" id="mwTalentsGridContainer">
        <!-- JS ile yan yana 3'lü kompakt kartlar buraya yüklenir -->
      </div>
    </div>

  </div>

  <!-- MÜLAKAT TEKLİFİ GÖNDERME MODALI -->
  <div class="modal fade" id="mwInviteTalentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content mw-panel-card border-danger">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-handshake text-danger me-1"></i> Adaya Doğrudan Mülakat Teklifi Gönder
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>
        <div class="modal-body">
          <form id="mwInviteTalentForm" class="row g-3">
            <input type="hidden" id="invTalentId" />
            <div class="col-12">
              <div class="p-2 rounded border small" style="background:var(--mw-surface-alt);">
                <strong>Seçilen Aday:</strong> <span id="invTalentName" class="text-danger fw-bold"></span>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold mb-1">İşveren Firma Adınız *</label>
              <input type="text" id="invCompanyName" class="form-control form-control-sm" placeholder="Örn: Anadolu Çelik A.Ş." required />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold mb-1">İletişim Telefonunuz *</label>
              <input type="tel" id="invContactPhone" class="form-control form-control-sm" placeholder="0532 000 00 00" required />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold mb-1">Teklif Edilen Pozisyon *</label>
              <input type="text" id="invJobTitle" class="form-control form-control-sm" placeholder="Örn: IT Uzmanı / İhracat Müdürü" required />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold mb-1">Önerilen Maaş / Hakediş Bandı *</label>
              <input type="text" id="invOfferedSalary" class="form-control form-control-sm" placeholder="Örn: 75.000 TL + Prim" required />
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold mb-1">Mülakat Davet Notunuz</label>
              <textarea id="invMessage" class="form-control form-control-sm" rows="2" placeholder="Merhaba, profilinizi ve uzmanlık etiketlerinizi inceledik. Online veya yüz yüze tanışmak isteriz."></textarea>
            </div>
            <div id="invFeedback" class="col-12 small" style="display:none;"></div>
            <div class="col-12">
              <button type="submit" class="btn btn-danger w-100 fw-bold">
                <i class="bi bi-send-check-fill me-1"></i> Mülakat & Maaş Teklifini İlet
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';
      let allTalents = [];

      const FALLBACK_TALENTS = [
        {
          id: 'tln_emir_aksu',
          full_name: 'Emir Aksu',
          photo_url: 'https://ui-avatars.com/api/?name=Emir+Aksu&background=dc3545&color=fff&size=200&bold=true',
