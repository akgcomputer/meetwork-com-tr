      // Dinamik Arama/Filtre Uyum Hesaplayıcısı (Rastgele değil, aktif filtrelere göre gerçek hesaplama)
      function computeDynamicMatch(talent, filters) {
        let activeCriteria = 0;
        let matchedPoints = 0;

        if (filters.dep !== 'Tümü') {
          activeCriteria++;
          if (String(talent.department || '') === filters.dep) matchedPoints += 1;
        }
        if (filters.sector !== 'Tümü') {
          activeCriteria++;
          const tSec = String(talent.target_sector || '').toLocaleLowerCase('tr-TR');
          const fSec = filters.sector.toLocaleLowerCase('tr-TR');
          if (tSec.includes(fSec) || fSec.includes(tSec)) matchedPoints += 1;
        }
        if (filters.pos !== 'Tümü') {
          activeCriteria++;
          const tPos = String(talent.target_position || '').toLocaleLowerCase('tr-TR');
          const fPos = filters.pos.toLocaleLowerCase('tr-TR');
          if (tPos.includes(fPos) || fPos.includes(tPos)) matchedPoints += 1;
        }
        if (filters.city !== 'Tümü') {
          activeCriteria++;
          if (String(talent.city || '') === filters.city) matchedPoints += 1;
        }
        if (filters.mode !== 'Tümü') {
          activeCriteria++;
          if (String(talent.work_mode || '').toLocaleLowerCase('tr-TR').includes(filters.mode.toLocaleLowerCase('tr-TR'))) {
            matchedPoints += 1;
          }
        }
        if (filters.q) {
          activeCriteria++;
          const hay = [
            talent.full_name,
            talent.role_subtitle,
            talent.headline,
            talent.department,
            talent.target_sector,
            talent.target_position,
            talent.bio_summary,
            ...(talent.skills_list || []),
            ...(talent.languages_list || [])
          ].join(' ').toLocaleLowerCase('tr-TR');
          if (hay.includes(filters.q)) matchedPoints += 1;
        }

        if (activeCriteria === 0) {
          return { hasActiveFilter: false, score: 100, matchesAll: true };
        }

        const ratio = matchedPoints / activeCriteria;
        const pct = Math.round(ratio * 100);
        return {
          hasActiveFilter: true,
          score: pct,
          matchesAll: matchedPoints === activeCriteria,
          matchedPoints,
          activeCriteria
        };
      }

      function renderTalentsGrid() {
        const grid = document.getElementById('mwTalentsGridContainer');
        const countEl = document.getElementById('mwTalentCountBadge');
        const filterNotice = document.getElementById('mwActiveFilterNotice');
        if (!grid) return;

        const filters = {
          dep: (document.getElementById('fltDepartment') || {}).value || 'Tümü',
          sector: (document.getElementById('fltTargetSector') || {}).value || 'Tümü',
          pos: (document.getElementById('fltTargetPosition') || {}).value || 'Tümü',
          city: (document.getElementById('fltCity') || {}).value || 'Tümü',
          mode: (document.getElementById('fltWorkMode') || {}).value || 'Tümü',
          q: ((document.getElementById('fltSkillQuery') || {}).value || '').trim().toLocaleLowerCase('tr-TR')
        };

        const sourceList = allTalents.length > 0 ? allTalents : FALLBACK_TALENTS;

        const evaluated = sourceList.map((t) => {
          const match = computeDynamicMatch(t, filters);
          return { talent: t, match };
        });

        // Filtre aktifse en az 1 kriteri tutan veya tüm kriterleri tutanları filtrele ve uyum yüzdesine göre sırala
        const hasFilter = evaluated[0] && evaluated[0].match.hasActiveFilter;
        if (filterNotice) {
          filterNotice.style.display = hasFilter ? 'inline-block' : 'none';
        }

        let filtered = evaluated;
        if (hasFilter) {
          filtered = evaluated.filter(item => item.match.matchesAll);
          filtered.sort((a, b) => b.match.score - a.match.score);
        }

        if (countEl) countEl.textContent = String(filtered.length);

        if (filtered.length === 0) {
          grid.innerHTML = `
            <div class="col-12">
              <div class="mw-panel-card p-4 text-center">
                <i class="bi bi-search fs-2 text-danger"></i>
                <h6 class="fw-bold mt-2 mb-1">Seçtiğiniz tüm filtre kriterleriyle eşleşen aday bulunamadı</h6>
                <p class="small text-muted mb-3">Filtrelerden birini gevşeterek tüm doğrulanmış adayları görüntüleyebilirsiniz.</p>
                <button type="button" class="btn btn-sm btn-outline-danger fw-bold" onclick="document.getElementById('fltResetAllBtn').click()">
                  Filtreleri Sıfırla & Tüm Adayları Göster
                </button>
              </div>
            </div>
          `;
          return;
        }

        grid.innerHTML = filtered.map(({ talent: t, match }) => {
          const realName = t.full_name || t.display_name || 'Doğrulanmış Aday';
          const photoUrl = t.photo_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(realName)}&background=dc3545&color=fff&size=200&bold=true`;
          const roleSub = t.role_subtitle || t.headline || 'B2B Uzman Aday';
          const dept = t.department || 'B2B Uzmanlık';
          const skills = Array.isArray(t.skills_list) ? t.skills_list : [];
          const langs = Array.isArray(t.languages_list) ? t.languages_list : [];
          const targetSector = t.target_sector || 'Tekstil';
          const targetPosition = t.target_position || 'IT Uzmanı';

          const badgeHtml = match.hasActiveFilter
            ? `<span class="badge bg-success tabular-nums" style="font-size:0.68rem;">%${match.score} Uyum & Doğrulama</span>`
            : `<span class="badge bg-dark-subtle text-body border" style="font-size:0.66rem;"><i class="bi bi-patch-check-fill text-success me-1"></i>Doğrulanmış Özgeçmiş</span>`;

          const availStatus = t.availability_status || 'looking';
          const availBadge = availStatus === 'open_to_offers'
            ? `<span class="badge bg-warning text-dark" style="font-size:0.63rem;">🟡 İş Tekliflerine Açık</span>`
            : `<span class="badge bg-success" style="font-size:0.63rem;">🟢 Aktif İş Arıyor</span>`;
          const viewsCount = Number(t.views_count || 24);
          const noticePeriod = t.notice_period || 'Hemen Başlayabilir';

          return `
            <div class="col-xl-4 col-md-6 col-12">
              <article class="mw-candidate-card p-3 shadow-sm">
                <!-- 1. Fotoğraf Sağında İsim (h2), Altında Uzmanlık (h3), Altında Konum & Deneyim -->
                <div class="d-flex align-items-start gap-2 mb-2">
                  <img
                    src="${photoUrl}"
                    alt="${realName}"
                    class="mw-candidate-photo"
                    loading="lazy"
                  />
                  <div class="min-w-0 flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start gap-1">
                      <h2 class="mw-candidate-h2 text-truncate" title="${realName}">
                        👤 ${realName}
                      </h2>
                      <span class="text-muted tabular-nums flex-shrink-0" style="font-size:0.66rem;" title="Profil Ziyaret Sayısı">
                        👁️ ${viewsCount}
                      </span>
                    </div>
                    <h3 class="mw-candidate-h3">
                      &gt; (${roleSub}) • ${dept}
                    </h3>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-1 mt-1">
                      <span class="mw-candidate-meta">
                        📍 ${t.city || 'İstanbul'} • ⏱️ ${t.experience_years || 5} Yıl Deneyim
                      </span>
                      ${badgeHtml}
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-1 mt-1">
                      ${availBadge}
                      <span class="badge bg-light text-secondary border" style="font-size:0.62rem;">⏳ ${noticePeriod}</span>
                    </div>
                  </div>
                </div>

                <!-- 2. Pozisyon Başlığı -->
                <div class="fw-bold small mb-2" style="font-size:0.8rem; line-height:1.35;">
                  ${t.headline || roleSub}
                </div>

                <!-- 3. Devlet İstihdam Teşviki Bandı -->
                <div class="mw-subsidy-strip mb-2">
                  ${t.subsidy_badge || '💰 SGK 6111 & KOSGEB Nitelikli Personel Teşvikine Uygun'}
                </div>

                <!-- 4. Yetenek & Yabancı Dil Etiketleri -->
                <div class="d-flex flex-wrap gap-1 mb-2">
                  ${skills.slice(0, 6).map(sk => `<span class="mw-skill-chip">${sk}</span>`).join('')}
                  ${langs.map(lg => `<span class="mw-lang-chip">🗣️ ${lg}</span>`).join('')}
                </div>

                <!-- 5. Kısa Uzmanlık Özeti -->
                <p class="small text-muted mb-2" style="font-size:0.74rem; line-height:1.45;">
                  ${t.bio_summary || ''}
                </p>

                <!-- 6. İş Aradığı Sektör & Pozisyon -->
                <div class="mw-target-box mb-2">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted">İş aradığı sektör :</span>
                    <strong class="text-danger">${targetSector}</strong>
                  </div>
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">İş aradığı pozisyon :</span>
                    <strong style="color:var(--mw-text);">${targetPosition}</strong>
                  </div>
                </div>

                <!-- 7. Alt Maaş Beklentisi & Mülakat Teklifi Butonu -->
                <div class="mt-auto pt-2 border-top" style="border-color:var(--mw-border)!important;">
                  <div class="d-flex justify-content-between align-items-end mb-2">
                    <div>
                      <div class="text-muted" style="font-size:0.66rem;">
                        Maaş / Hakediş Beklentisi (${t.work_mode || 'Tam Zamanlı'})
                      </div>
                      <div class="fw-black text-danger tabular-nums" style="font-size:0.9rem;">
                        ${t.salary_expectation || '60.000 TL – 85.000 TL'}
                      </div>
                    </div>
                  </div>
                  <button
                    type="button"
                    class="btn btn-danger btn-sm w-100 fw-bold py-1"
                    onclick="window.mwOpenInviteModal('${t.id}', '${realName.replace(/'/g, "\\'")}', '${targetPosition.replace(/'/g, "\\'")}', '${(t.salary_expectation || '').replace(/'/g, "\\'")}')"
                  >
                    🤝 Mülakat Teklifi Gönder
                  </button>
                </div>
              </article>
            </div>
          `;
        }).join('');
      }

      async function loadTalentsFromApi() {
        renderTalentsGrid();
        try {
          const res = await fetch(`${API_URL}/api/career/overview`);
          const data = await res.json();
          if (data && Array.isArray(data.talents) && data.talents.length > 0) {
            allTalents = data.talents;
            renderTalentsGrid();
          }
        } catch (_) {}
      }

      window.mwOpenInviteModal = function (id, name, pos, salary) {
        // Profil ziyaret sayacını artır
        if (id) {
          fetch(`${API_URL}/api/career/talent/${encodeURIComponent(id)}/view`, { method: 'POST' }).catch(() => {});
        }
        document.getElementById('invTalentId').value = id;
        document.getElementById('invTalentName').textContent = name;
        document.getElementById('invJobTitle').value = pos || '';
        document.getElementById('invOfferedSalary').value = salary || '';
        const fb = document.getElementById('invFeedback');
        if (fb) fb.style.display = 'none';

        try {
          const u = JSON.parse(localStorage.getItem('mw_user') || 'null');
          if (u) {
            if (u.company_name) document.getElementById('invCompanyName').value = u.company_name;
            if (u.phone) document.getElementById('invContactPhone').value = u.phone;
          }
        } catch (_) {}

        const modalEl = document.getElementById('mwInviteTalentModal');
        if (modalEl && window.bootstrap) {
          new window.bootstrap.Modal(modalEl).show();
        }
      };

      document.addEventListener('DOMContentLoaded', () => {
        // Sadece kurumsal üye girişi varsa "İşletmem İçin İlan Aç" butonunu göster
        try {
          const u = JSON.parse(localStorage.getItem('mw_user') || 'null');
          const empBtn = document.getElementById('mwEmployerPostJobBtn');
          if (u && u.company_id && empBtn) {
            empBtn.style.display = 'inline-flex';
            if (u.company_slug) {
              empBtn.setAttribute('href', `/isletmeler?firma=${encodeURIComponent(u.company_slug)}#mwEmployerHrPanel`);
            }
          }
        } catch (_) {}

        loadTalentsFromApi();

        ['fltDepartment', 'fltTargetSector', 'fltTargetPosition', 'fltCity', 'fltWorkMode'].forEach((id) => {
          const el = document.getElementById(id);
          if (el) el.addEventListener('change', renderTalentsGrid);
        });

        const sq = document.getElementById('fltSkillQuery');
        if (sq) sq.addEventListener('input', renderTalentsGrid);

        document.querySelectorAll('.mw-quick-filter-tag').forEach((btn) => {
          btn.addEventListener('click', () => {
            const val = btn.getAttribute('data-skill') || '';
            const input = document.getElementById('fltSkillQuery');
            if (!input) return;
            if (input.value === val) {
              input.value = '';
              btn.classList.remove('active');
            } else {
              document.querySelectorAll('.mw-quick-filter-tag').forEach(b => b.classList.remove('active'));
              input.value = val;
              btn.classList.add('active');
            }
            renderTalentsGrid();
          });
        });

        const resetBtn = document.getElementById('fltResetAllBtn');
        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            document.getElementById('mwCandidateFilterForm').reset();
            document.querySelectorAll('.mw-quick-filter-tag').forEach(b => b.classList.remove('active'));
            renderTalentsGrid();
          });
        }

        const invForm = document.getElementById('mwInviteTalentForm');
        if (invForm) {
          invForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            let u = null;
            try { u = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}
            const fb = document.getElementById('invFeedback');

            const payload = {
              interaction_type: 'employer_invite',
              talent_id: document.getElementById('invTalentId').value,
              talent_name: document.getElementById('invTalentName').textContent,
              company_id: u ? u.company_id : '',
              company_name: document.getElementById('invCompanyName').value,
              contact_phone: document.getElementById('invContactPhone').value,
              job_title: document.getElementById('invJobTitle').value,
              offered_salary: document.getElementById('invOfferedSalary').value,
              message: document.getElementById('invMessage').value
            };

            try {
              const res = await fetch(`${API_URL}/api/career/interact`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              const out = await res.json();
              if (fb) {
                fb.style.display = 'block';
                fb.className = 'col-12 small fw-bold text-success';
                fb.textContent = out.message || '✓ Mülakat teklifiniz adaya başarıyla iletildi!';
              }
            } catch (_) {}
          });
        }
      });
    })();
  </script>
</BaseLayout>
