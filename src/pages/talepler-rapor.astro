---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// JSON dosyalarının bulunduğu dizin
const dataDir = path.join(process.cwd(), 'src/data/talepler');

// Tüm dosyaları oku
const files = fs.readdirSync(dataDir).filter(file => file.endsWith('.json'));

const rfqs = [];
for (const file of files) {
  const filePath = path.join(dataDir, file);
  const fileContent = fs.readFileSync(filePath, 'utf-8');
  try {
    const data = JSON.parse(fileContent);
    rfqs.push(data);
  } catch (e) {
    console.error("JSON parse hatası:", file);
  }
}

// Son 7 günü hesapla
const now = new Date();
const sevenDaysAgo = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));

const recentRfqs = rfqs.filter(rfq => {
  if (!rfq.publishDate) return false;
  const pubDate = new Date(rfq.publishDate);
  return pubDate >= sevenDaysAgo;
});

// Tarihe göre sırala (en yeni en üstte)
recentRfqs.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

// Gün bazında grupla
const groupedByDay = {};
recentRfqs.forEach(rfq => {
  const dateObj = new Date(rfq.publishDate);
  // YYYY-MM-DD formatı
  const dateStr = dateObj.toISOString().split('T')[0];
  // Saat ve dakika (HH:MM)
  const timeStr = dateObj.toTimeString().split(' ')[0].substring(0, 5);
  
  if (!groupedByDay[dateStr]) {
    groupedByDay[dateStr] = {
      date: dateStr,
      count: 0,
      times: new Set(),
      items: []
    };
  }
  groupedByDay[dateStr].count += 1;
  groupedByDay[dateStr].times.add(timeStr);
  groupedByDay[dateStr].items.push(rfq);
});

// Grupları diziye çevirip tarihe göre sırala
const reportDays = Object.values(groupedByDay).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// İstatistikler
const totalRecent = recentRfqs.length;
---

<BaseLayout title="MeetWork Haftalık Otomasyon Raporu">
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-800 mb-2">Haftalık Otomasyon Raporu</h1>
      <p class="text-slate-600">Sisteme son 7 gün içinde otomatik olarak eklenen iş taleplerinin özeti.</p>
    </div>

    <!-- Özet Kartları -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-sm font-medium text-slate-500 mb-1">Son 7 Günde Eklenen</h3>
        <p class="text-4xl font-bold text-blue-600">{totalRecent}</p>
        <p class="text-sm text-slate-500 mt-2">Yeni B2B Talebi</p>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-sm font-medium text-slate-500 mb-1">Sosyal Medya Otomasyonu</h3>
        <div class="flex items-center gap-2 mt-2">
          <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-medium">LinkedIn</span>
          <span class="px-2 py-1 bg-pink-100 text-pink-700 rounded text-xs font-medium">Instagram Story</span>
        </div>
        <p class="text-sm text-slate-500 mt-2">Platformlarında anında paylaşıldı</p>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-sm font-medium text-slate-500 mb-1">Sistem Durumu</h3>
        <div class="flex items-center gap-2 mt-2">
          <div class="w-3 h-3 rounded-full bg-green-500 animate-pulse"></div>
          <span class="text-lg font-bold text-slate-800">Aktif</span>
        </div>
        <p class="text-sm text-slate-500 mt-2">Otomatik tarama devrede</p>
      </div>
    </div>

    <!-- Gün Gün Rapor -->
    <h2 class="text-2xl font-bold text-slate-800 mb-6">Günlük Kırılım</h2>
    
    {reportDays.length === 0 ? (
      <div class="bg-yellow-50 text-yellow-800 p-6 rounded-lg">
        Son 7 gün içinde sisteme eklenen yeni bir talep bulunamadı.
      </div>
    ) : (
      <div class="space-y-6">
        {reportDays.map((dayObj, index) => (
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <!-- Gün Başlığı -->
            <div class="bg-slate-50 px-6 py-4 border-b border-slate-200 flex justify-between items-center">
              <div>
                <h3 class="text-lg font-bold text-slate-800">
                  {new Date(dayObj.date).toLocaleDateString('tr-TR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
                </h3>
                <p class="text-sm text-slate-500">
                  Toplam <span class="font-bold text-blue-600">{dayObj.count}</span> talep eklendi.
                </p>
              </div>
              <div class="text-right">
                <p class="text-xs text-slate-400">İşlem Saatleri</p>
                <p class="text-sm font-medium text-slate-700">{Array.from(dayObj.times).sort().join(', ')}</p>
              </div>
            </div>
            
            <!-- İçerik Listesi (İlk 5'i göster, gerisini özetle) -->
            <div class="p-6">
              <ul class="space-y-3">
                {dayObj.items.slice(0, 5).map(item => (
                  <li class="flex items-start gap-3 text-sm">
                    <span class="text-green-500 mt-0.5">✓</span>
                    <div>
                      <span class="font-medium text-slate-700">{item.title}</span>
                      <span class="text-slate-400 ml-2">({item.category})</span>
                    </div>
                  </li>
                ))}
              </ul>
              {dayObj.items.length > 5 && (
                <p class="text-sm text-slate-500 mt-4 italic">...ve {dayObj.items.length - 5} talep daha.</p>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </main>
</BaseLayout>
