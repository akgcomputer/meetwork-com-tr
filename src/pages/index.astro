        window.__mwStoriesList = stories;

        const row = document.getElementById('mwHomeStoriesRow');
        if (row) {
          const addBtnHtml = `
            <div class="mw-story-item" data-bs-toggle="modal" data-bs-target="#mwAddStoryModal">
              <div class="mw-story-add-ring">
                <i class="bi bi-plus-lg"></i>
