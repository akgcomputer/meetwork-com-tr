            return `
              <button type="button" onclick="window.mwOpenStory(${idx})" class="flex flex-col items-center gap-1.5 shrink-0 group focus:outline-none border-0 bg-transparent p-0">
                <div class="relative p-0.5 rounded-full bg-gradient-to-tr from-secondary-container via-cherry-vibrant to-gold-badge">
                  <div class="w-16 h-16 rounded-full bg-surface-card p-0.5 flex items-center justify-center">
