        const initials = (post.company_name || post.author_name || 'MW').slice(0, 2).toUpperCase();
        const tag = post.tag || 'İş & Sektör Paylaşımı';
        const vitrinUrl = post.company_slug ? `/isletmeler?firma=${encodeURIComponent(post.company_slug)}` : '/isletmeler';
        return `
          <article class="bg-surface-card rounded-2xl p-4 shadow-sm border border-border-light flex flex-col gap-3 relative transition-shadow hover:shadow-md">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-cherry-vibrant text-white flex items-center justify-center font-bold text-sm shrink-0">
                  ${initials}
                </div>
                <div class="flex flex-col">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="font-label-lg text-label-lg text-navy-deep font-bold">${post.company_name || post.author_name}</span>
                    <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full bg-trust-emerald/15 text-on-tertiary-container font-label-sm text-label-sm">
                      <span class="material-symbols-outlined text-[12px] text-trust-emerald">verified</span>
                      ${post.author_name || 'Onaylı Üye'}
                    </span>
                  </div>
                  <div class="flex items-center gap-2 font-body-sm text-body-sm text-on-surface-variant">
                    <span>${tag}</span>
                    <span>•</span>
                    <span>${new Date(post.created_at || Date.now()).toLocaleDateString('tr-TR')}</span>
                  </div>
                </div>
              </div>
              <a href="${vitrinUrl}" class="px-2.5 py-1 rounded-lg bg-surface-container text-navy-deep font-label-sm text-label-sm font-bold shrink-0">
                Vitrin
              </a>
            </div>
            <div class="font-body-md text-body-md text-on-surface leading-relaxed whitespace-pre-line">${post.content}</div>
            <div class="pt-2 border-t border-border-subtle flex items-center justify-between">
              <button class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-cherry-vibrant hover:bg-border-subtle transition-colors" onclick="window.mwLikePost('${post.id}', this)" type="button">
                <span class="material-symbols-outlined text-[18px]">thumb_up</span>
                <span class="font-label-sm text-label-sm font-bold">${post.likes_count || 0}</span>
              </button>
              <div class="flex items-center gap-1.5">
                <a href="/ihaleler?yeni=1" class="px-2.5 py-1.5 rounded-lg bg-surface-container-low text-navy-deep font-label-sm text-label-sm font-bold">Teklif İste</a>
                <a href="/akilli-eslesme" class="px-2.5 py-1.5 rounded-lg bg-navy-deep text-on-secondary font-label-sm text-label-sm font-bold">+ Ağa Ekle</a>
              </div>
            </div>
          </article>
        `;
      }

      function renderFeedStream() {
        const feedContainer = document.getElementById('mwHomeSocialFeed');
        const mobLiveContainer = document.getElementById('mwMobileLivePostsContainer');

        const apiPosts = cachedFeedData.posts || [];
        const combinedPosts = [...apiPosts, ...fallbackSocialPosts];
        const seenKeys = new Set();
        const posts = combinedPosts.filter((p) => {
          const key = `${p.author_name || ''}_${(p.content || '').slice(0, 40)}`;
          if (seenKeys.has(key)) return false;
          seenKeys.add(key);
          return true;
        });
        const listings = cachedFeedData.vitrinListings || [];
        const tenders = cachedFeedData.activeTenders || [];

        if (mobLiveContainer) {
          if (currentFilter === 'tenders') {
            mobLiveContainer.innerHTML = tenders.map((t) => `
              <article class="bg-surface-card rounded-2xl p-4 shadow-sm border-l-4 border-cherry-vibrant flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <span class="px-2 py-0.5 rounded bg-cherry-vibrant text-white font-label-sm text-label-sm font-bold">🔴 Canlı Alım İhalesi</span>
                  <span class="font-label-sm text-label-sm text-on-surface-variant">#${t.tender_no || t.id}</span>
                </div>
                <h4 class="font-label-lg text-label-lg text-navy-deep font-bold">${t.title}</h4>
                <p class="font-body-sm text-body-sm text-on-surface-variant">${t.description || ''}</p>
                <div class="flex items-center justify-between pt-2 border-t border-border-subtle">
                  <span class="font-label-md text-label-md text-trust-emerald font-bold">${Number(t.start_price || 0).toLocaleString('tr-TR')} ${t.currency || 'TRY'}</span>
                  <a href="/ihaleler" class="px-3 py-1.5 rounded-lg bg-cherry-vibrant text-white font-label-sm text-label-sm font-bold">Teklif Ver</a>
                </div>
              </article>
            `).join('');
          } else if (currentFilter === 'listings') {
            mobLiveContainer.innerHTML = listings.map((item) => `
              <article class="bg-surface-card rounded-2xl p-4 shadow-sm border-l-4 border-navy-deep flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <span class="px-2 py-0.5 rounded bg-navy-deep text-white font-label-sm text-label-sm font-bold">${item.main_category} • ${item.listing_type}</span>
                  <span class="font-label-sm text-label-sm text-on-surface-variant">#${item.listing_no}</span>
                </div>
                <h4 class="font-label-lg text-label-lg text-navy-deep font-bold">${item.title}</h4>
                <div class="flex items-center justify-between pt-2 border-t border-border-subtle">
                  <span class="font-label-md text-label-md text-cherry-vibrant font-bold">${Number(item.price || 0).toLocaleString('tr-TR')} ${item.currency || 'TRY'}</span>
                  <a href="/ilanlar?ilan=${encodeURIComponent(item.slug || item.listing_no)}" class="px-3 py-1.5 rounded-lg bg-navy-deep text-white font-label-sm text-label-sm font-bold">İlanı İncele</a>
                </div>
              </article>
            `).join('');
          } else {
            mobLiveContainer.innerHTML = posts.map((p) => renderMobilePostCard(p)).join('');
          }
        }

        if (!feedContainer) return;

        if (currentFilter === 'posts') {
          feedContainer.innerHTML = posts.map((p, idx) => renderPostCard(p, getZebraClass(idx))).join('');
          return;
        }
        if (currentFilter === 'listings') {
          feedContainer.innerHTML = listings.length > 0
            ? listings.map((item, idx) => renderInlineListingCard(item, getZebraClass(idx))).join('')
            : '<div class="mw-panel-card mw-zebra-odd p-4 text-center small text-muted">Vitrin ilanı bulunamadı.</div>';
          return;
        }
        if (currentFilter === 'tenders') {
          feedContainer.innerHTML = tenders.length > 0
            ? tenders.map((t, idx) => renderInlineTenderCard(t, getZebraClass(idx))).join('')
            : '<div class="mw-panel-card mw-zebra-odd p-4 text-center small text-muted">Aktif e-ihale bulunamadı.</div>';
          return;
        }

        const rawItems = [];
        posts.forEach((p) => rawItems.push({ type: 'post', data: p }));
        const maxExtra = Math.max(listings.length, tenders.length);
        for (let i = 0; i < maxExtra; i++) {
          if (listings[i] && i < 3) rawItems.push({ type: 'listing', data: listings[i] });
          if (tenders[i] && i < 2) rawItems.push({ type: 'tender', data: tenders[i] });
        }

        const streamHtml = rawItems.map((entry, idx) => {
          const zClass = getZebraClass(idx);
          if (entry.type === 'post') return renderPostCard(entry.data, zClass);
          if (entry.type === 'listing') return renderInlineListingCard(entry.data, zClass);
          return renderInlineTenderCard(entry.data, zClass);
        });

        feedContainer.innerHTML = streamHtml.join('');
      }

      async function loadHomeFeed() {
        const matchPreview = document.getElementById('mwHomeMatchPreview');
        renderStoriesBar();

        try {
          const res = await fetch(`${API_URL}/api/feed`);
          const data = await res.json();
          cachedFeedData = data || {};
          renderStoriesBar();
          renderFeedStream();

          if (matchPreview) {
            const comps = data.featuredCompanies || [];
            if (comps.length > 0) {
              matchPreview.innerHTML = comps.slice(0, 3).map((c, idx) => `
                <div class="p-2 rounded border d-flex justify-content-between align-items-center" style="border-color:var(--mw-border)!important;">
                  <div class="text-truncate pe-2">
                    <div class="d-flex align-items-center gap-1">
                      <span class="badge ${idx < 2 ? 'bg-danger' : 'bg-dark'}" style="font-size:0.6rem;">
                        ${idx < 2 ? '🎯 Hedef' : '🎲 Sürpriz'}
                      </span>
                      <a href="/isletmeler?firma=${encodeURIComponent(c.slug)}" class="fw-bold small text-decoration-none text-truncate" style="color:var(--mw-text); font-size:0.78rem;">
                        ${c.name}
                      </a>
                    </div>
                    <small class="text-muted d-block mt-1" style="font-size:0.68rem;">${c.sector} • ${c.city || 'Türkiye'}</small>
                  </div>
                  <a href="/akilli-eslesme" class="btn btn-sm btn-outline-danger py-0 px-2 flex-shrink-0" style="font-size:0.7rem;">
                    + Tanış
                  </a>
                </div>
              `).join('');
            }
          }
        } catch (_) {
          renderStoriesBar();
          renderFeedStream();
        }
      }

      window.mwLikePost = async function (postId, btnEl) {
        const span = btnEl.querySelector('span');
        if (span) span.textContent = String(Number(span.textContent || 0) + 1);
        if (!String(postId).startsWith('seed-')) {
          try {
            await fetch(`${API_URL}/api/posts/${postId}/like`, { method: 'POST' });
          } catch (_) {}
        }
      };

      async function handleQuickPostSubmit(contentInputEl, tagSelectEl, feedbackEl, submitBtnEl) {
        if (!contentInputEl || !submitBtnEl) return;
        const text = contentInputEl.value.trim();
        if (!text) return;

        let user = null;
        try { user = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}
        const selectedTag = tagSelectEl ? tagSelectEl.value : 'İş & Sektör Paylaşımı';

        submitBtnEl.disabled = true;
        try {
          const res = await fetch(`${API_URL}/api/posts`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              user_id: user ? user.user_id : 'guest',
              company_id: user ? user.company_id : '',
              author_name: user ? user.full_name : 'MeetWork İş Ağı Üyesi',
              company_name: user ? user.company_name : 'Doğrulanmış İş Ağı',
              company_slug: user ? user.company_slug : '',
              trust_level: user ? user.trust_level : 1,
              content: `[${selectedTag}] ${text}`
            })
          });
          const out = await res.json();
          if (out.success) {
            contentInputEl.value = '';
            if (feedbackEl) {
              feedbackEl.style.display = 'block';
              feedbackEl.className = 'small mt-2 text-success fw-bold';
              feedbackEl.textContent = '✓ Paylaşımınız canlı iş ağı akışına eklendi!';
            }
            loadHomeFeed();
          }
        } catch (_) {}
        submitBtnEl.disabled = false;
      }

      document.addEventListener('DOMContentLoaded', () => {
        hydrateUserSidebar();
        loadHomeFeed();

        // Filtre sekmeleri (Geniş Ekran + Mobil/Tablet senkron)
        const filterButtons = document.querySelectorAll('[data-feed-filter]');
        filterButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            currentFilter = btn.getAttribute('data-feed-filter') || 'all';
            filterButtons.forEach((b) => {
              const isAct = (b.getAttribute('data-feed-filter') || 'all') === currentFilter;
              if (b.classList.contains('mw-mob-filter-pill')) {
                b.className = isAct
                  ? 'mw-mob-filter-pill px-3 py-1.5 rounded-full bg-cherry-vibrant text-white font-label-sm text-label-sm font-bold shrink-0'
                  : 'mw-mob-filter-pill px-3 py-1.5 rounded-full bg-surface-card text-navy-deep border border-border-light font-label-sm text-label-sm shrink-0';
              } else {
                b.classList.toggle('btn-danger', isAct);
                b.classList.toggle('btn-outline-secondary', !isAct);
              }
            });
            renderFeedStream();
          });
        });

        // Yeni Hikaye Ekleme Formu
        const storyForm = document.getElementById('mwAddStoryForm');
        if (storyForm) {
          storyForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            let user = null;
            try { user = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}

            const title = document.getElementById('mwStoryTitle').value.trim();
            const content = document.getElementById('mwStoryContent').value.trim();
            const category = document.getElementById('mwStoryCategory').value;
            const bg_gradient = document.getElementById('mwStoryGradient').value;
            const fb = document.getElementById('mwAddStoryFeedback');

            try {
              const res = await fetch(`${API_URL}/api/stories`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  company_id: user ? user.company_id : '',
                  company_name: user ? user.company_name : 'MeetWork Üye İşletme',
                  company_slug: user ? user.company_slug : '',
                  author_name: user ? user.full_name : 'İş Ağı Üyesi',
                  trust_level: user ? user.trust_level : 2,
                  title,
                  content,
                  category,
                  bg_gradient
                })
              });
              const out = await res.json();
              if (out.success) {
                storyForm.reset();
                if (fb) {
                  fb.style.display = 'block';
                  fb.className = 'small mb-2 text-success fw-bold';
                  fb.textContent = '✓ Hikayeniz canlı vitrine eklendi!';
                }
                loadHomeFeed();
              }
            } catch (_) {}
          });
        }

        // Geniş Ekran Hızlı Post Paylaşımı
        const submitBtn = document.getElementById('mwQuickPostSubmit');
        const contentInput = document.getElementById('mwQuickPostContent');
        const tagSelect = document.getElementById('mwQuickPostTag');
        const feedback = document.getElementById('mwQuickPostFeedback');
        if (submitBtn && contentInput) {
          submitBtn.addEventListener('click', () => handleQuickPostSubmit(contentInput, tagSelect, feedback, submitBtn));
        }

        // Mobil & Tablet Hızlı Post Paylaşımı
        const mobSubmitBtn = document.getElementById('mwMobQuickPostSubmit');
        const mobContentInput = document.getElementById('mwMobQuickPostContent');
        const mobTagSelect = document.getElementById('mwMobQuickPostTag');
        const mobFeedback = document.getElementById('mwMobQuickPostFeedback');
        if (mobSubmitBtn && mobContentInput) {
          mobSubmitBtn.addEventListener('click', () => handleQuickPostSubmit(mobContentInput, mobTagSelect, mobFeedback, mobSubmitBtn));
        }
      });
    })();
  </script>
