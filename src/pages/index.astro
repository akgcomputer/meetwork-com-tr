              <span class="fw-bold text-truncate w-100 text-center" style="font-size: 0.7rem;">Hikaye Ekle</span>
            </div>
          `;

          const itemsHtml = stories.map((st, idx) => {
            const initials = (st.company_name || 'MW').slice(0, 2).toUpperCase();
            const isGold = Number(st.trust_level) >= 3;
            const isSilver = Number(st.trust_level) === 2;
            const ringClass = isGold ? 'mw-story-ring-gold' : (isSilver ? 'mw-story-ring-silver' : '');
            const bg = st.bg_gradient || 'linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%)';
            const catStr = String(st.category || '');
            let pillText = '📢 Gündem';
            let pillClass = 'bg-dark text-white';
            if (catStr.includes('İhale')) { pillText = '🔴 İhale'; pillClass = 'bg-danger text-white'; }
            else if (catStr.includes('Fırsat') || catStr.includes('Stok')) { pillText = '📦 Fırsat'; pillClass = 'bg-warning text-dark'; }
            else if (catStr.includes('Yatırım') || catStr.includes('Fabrika')) { pillText = '🏭 Yatırım'; pillClass = 'bg-success text-white'; }
            return `
              <div class="mw-story-item" onclick="window.mwOpenStory(${idx})">
                <div class="mw-story-ring ${ringClass}">
                  <div class="mw-story-inner" style="background: ${bg};">
                    ${initials}
                  </div>
                </div>
                <span class="mw-story-pill ${pillClass}">${pillText}</span>
                <span class="fw-semibold text-truncate w-100 text-center" style="font-size: 0.68rem;">${st.company_name}</span>
              </div>
            `;
          }).join('');

          row.innerHTML = addBtnHtml + itemsHtml;
        }

        const mobDynamicStories = document.getElementById('mwMobileDynamicStories');
