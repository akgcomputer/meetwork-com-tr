---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Mevcut gerçek talepler (src/data/talepler) verisini oku
const dataDir = path.join(process.cwd(), 'src/data/talepler');
let talepler: any[] = [];
if (fs.existsSync(dataDir)) {
  const files = fs.readdirSync(dataDir).filter(file => file.endsWith('.json'));
  talepler = files.map(file => {
    try {
      return JSON.parse(fs.readFileSync(path.join(dataDir, file), 'utf-8'));
    } catch (_) {
      return null;
    }
  }).filter(Boolean);
}
talepler.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
const recentTalepler = talepler.slice(0, 6);
---

<BaseLayout
  title="MeetWork | İş Ağı, Sosyal Medya, İlan Pazarı, E-İhale & ERP Ekosistemi"
  description="Türkiye'nin yeni nesil B2B ve ticari iş ağı. Sosyal medya akışı, Emlak/Vasıta/Sanayi ilan pazarı, Akıllı Eşleşme (2+1), E-İhale, StokPratik ERP ve DepodanDirekt Toptan İhracat tek çatı altında."
>
  <!-- Üst Hızlı Mod Geçiş Bandı (5 Ana Sütun) -->
  <div class="mw-panel-card p-3 mb-4 shadow-sm">
    <div class="row g-2 align-items-center">
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/ilanlar?category=Emlak" class="btn btn-outline-danger w-100 text-start d-flex align-items-center gap-2 py-2">
          <i class="bi bi-houses-fill fs-5"></i>
          <div class="lh-1">
            <div class="fw-bold small">Emlak İlanları</div>
            <small class="text-muted" style="font-size:0.7rem;">Daire, Dükkan, Fabrika</small>
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/ilanlar?category=Vasıta" class="btn btn-outline-danger w-100 text-start d-flex align-items-center gap-2 py-2">
          <i class="bi bi-car-front-fill fs-5"></i>
          <div class="lh-1">
            <div class="fw-bold small">Vasıta (Oto/Ticari)</div>
            <small class="text-muted" style="font-size:0.7rem;">Binek, Ticari, Kiralık</small>
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/ilanlar?category=Sanayi%20%26%20Makine" class="btn btn-outline-danger w-100 text-start d-flex align-items-center gap-2 py-2">
          <i class="bi bi-gear-wide-connected fs-5"></i>
          <div class="lh-1">
            <div class="fw-bold small">Sanayi & 2. El</div>
            <small class="text-muted" style="font-size:0.7rem;">Makine, Demirbaş, Stok</small>
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/ihaleler" class="btn btn-outline-danger w-100 text-start d-flex align-items-center gap-2 py-2">
          <i class="bi bi-hammer fs-5"></i>
          <div class="lh-1">
            <div class="fw-bold small">E-İhale & Talepler</div>
            <small class="text-muted" style="font-size:0.7rem;">Açık Eksiltme & Zarf</small>
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/akilli-eslesme" class="btn btn-outline-danger w-100 text-start d-flex align-items-center gap-2 py-2">
          <i class="bi bi-diagram-3-fill fs-5"></i>
          <div class="lh-1">
            <div class="fw-bold small">Akıllı Eşleşme</div>
            <small class="text-muted" style="font-size:0.7rem;">2 Hedef + 1 Sürpriz</small>
          </div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/isletmeler" class="btn btn-danger w-100 text-start d-flex align-items-center gap-2 py-2">
          <i class="bi bi-globe2 fs-5"></i>
          <div class="lh-1">
            <div class="fw-bold small">ERP & İhracat</div>
            <small class="text-white-50" style="font-size:0.7rem;">CariNet & DepodanDirekt</small>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- ANA 3 SÜTUNLU HİBRİT MİMARİ: Sol (Sahibinden Kategori Ağacı) + Orta (Vitrin İlanları & LinkedIn Akışı) + Sağ (2+1 Eşleşme & Canlı İhale) -->
  <div class="row g-4 mb-5">
    <!-- SOL SÜTUN (%25): Sahibinden Kafası İlan Kategori Ağacı & Hızlı Erişim -->
    <div class="col-lg-3">
      <div class="mw-panel-card p-3 mb-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
          <h6 class="fw-bold mb-0"><i class="bi bi-list-ul text-danger me-1"></i> İlan Pazarı Kategorileri</h6>
          <a href="/ilanlar" class="small text-danger text-decoration-none fw-bold">Tümü</a>
        </div>

        <div class="d-flex flex-column gap-1">
          <a href="/ilanlar?category=Emlak" class="mw-sidebar-cat">
            <span><i class="bi bi-house-door-fill text-danger me-2"></i> Emlak</span>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill">Konut / İş Yeri</span>
          </a>
          <div class="ps-4 small d-flex flex-column gap-1 mb-2">
            <a href="/ilanlar?category=Emlak&sub_category=Daire" class="text-muted text-decoration-none">• Daire (Satılık / Kiralık)</a>
            <a href="/ilanlar?category=Emlak&sub_category=Dükkan%20%26%20Mağaza" class="text-muted text-decoration-none">• Dükkan & Mağaza</a>
            <a href="/ilanlar?category=Emlak&sub_category=Fabrika%20%26%20Depo" class="text-muted text-decoration-none">• İş Yeri, Fabrika & Depo</a>
            <a href="/ilanlar?category=Emlak&sub_category=Devren%20İş%20Yeri" class="text-muted text-decoration-none">• Devren Satılık İş Yeri</a>
          </div>

          <a href="/ilanlar?category=Vasıta" class="mw-sidebar-cat">
            <span><i class="bi bi-car-front-fill text-danger me-2"></i> Vasıta</span>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill">Binek / Ticari</span>
          </a>
          <div class="ps-4 small d-flex flex-column gap-1 mb-2">
            <a href="/ilanlar?category=Vasıta&sub_category=Otomobil%20(Binek)" class="text-muted text-decoration-none">• Otomobil (Binek Satılık)</a>
            <a href="/ilanlar?category=Vasıta&sub_category=Ticari%20Araç%20%26%20Panelvan" class="text-muted text-decoration-none">• Ticari Araç, Kamyon & Tır</a>
            <a href="/ilanlar?category=Vasıta&type=Kiralık" class="text-muted text-decoration-none">• Kiralık Binek & Ticari Filo</a>
          </div>

          <a href="/ilanlar?category=Sanayi%20%26%20Makine" class="mw-sidebar-cat">
            <span><i class="bi bi-cpu-fill text-danger me-2"></i> Sanayi & İş Makineleri</span>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill">Sıfır / 2.El</span>
          </a>
          <div class="ps-4 small d-flex flex-column gap-1 mb-2">
            <a href="/ilanlar?category=Sanayi%20%26%20Makine&sub_category=Üretim%20%26%20CNC%20Tezgahı" class="text-muted text-decoration-none">• Üretim, CNC & Torna</a>
            <a href="/ilanlar?category=Sanayi%20%26%20Makine&sub_category=Forklift%20%26%20İstif" class="text-muted text-decoration-none">• Forklift, Vinç & İstif</a>
            <a href="/ilanlar?category=Sanayi%20%26%20Makine&sub_category=Seri%20Sonu%20%26%20Fırsat%20Stok" class="text-muted text-decoration-none">• Seri Sonu & Fazla Stok</a>
          </div>

          <a href="/ilanlar?category=İkinci%20El%20%26%20Demirbaş" class="mw-sidebar-cat">
            <span><i class="bi bi-box2-heart-fill text-danger me-2"></i> 2. El Eşya & Demirbaş</span>
          </a>
          <a href="/ilanlar?category=Hizmet%20%26%20Fason" class="mw-sidebar-cat">
            <span><i class="bi bi-tools text-danger me-2"></i> Hizmet & Fason Kapasite</span>
          </a>
        </div>

        <hr class="my-3" />
        <a href="/ilanlar?yeni=1" class="btn btn-danger w-100 fw-bold btn-sm">
          <i class="bi bi-plus-circle me-1"></i> Ücretsiz İlan Ver
        </a>
      </div>

      <!-- Fiziksel Networking & Etkinlik Kartı -->
      <div class="mw-panel-card p-3 shadow-sm">
        <span class="badge bg-danger mb-2">Yüz Yüze B2B Networking</span>
        <h6 class="fw-bold">MeetWork Mini & Maxi Toplantılar</h6>
        <p class="small text-muted mb-3">
          Kahvaltılı iş toplantılarımıza katılın, yaka kartı QR kodu ve masa eşleşmesiyle doğrudan ticaret kurun.
        </p>
        <div class="d-grid gap-2">
          <a href="/etkinlik-takvimi" class="btn btn-outline-danger btn-sm fw-semibold">
            <i class="bi bi-calendar-event me-1"></i> Etkinlik Takvimini Gör
          </a>
          <a href="/meetwork-nedir" class="btn btn-link btn-sm text-decoration-none text-muted">
            MeetWork Nasıl Çalışır? →
          </a>
        </div>
      </div>
    </div>

    <!-- ORTA SÜTUN (%50): Vitrin İlanları + LinkedIn Tarzı Sosyal Medya & Ticaret Akışı -->
    <div class="col-lg-6">
      <!-- Paylaşım Yap / Hızlı Aksiyon Kutusu (LinkedIn Composer) -->
      <div class="mw-panel-card p-3 mb-4 shadow-sm">
        <div class="d-flex gap-2 align-items-start mb-2">
          <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width:42px;height:42px;">
            MW
          </div>
          <textarea
            id="mwQuickPostContent"
            class="form-control form-control-sm"
            rows="2"
            placeholder="İş dünyasıyla bir gelişme, yeni yatırım, ürün veya ticari fırsat paylaşın..."
          ></textarea>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2 border-top">
          <div class="d-flex flex-wrap gap-2">
            <a href="/ilanlar?yeni=1" class="btn btn-sm btn-outline-secondary">
              <i class="bi bi-camera-fill text-danger"></i> Satılık/Kiralık İlan
            </a>
            <a href="/ihaleler?yeni=1" class="btn btn-sm btn-outline-secondary">
              <i class="bi bi-hammer text-danger"></i> E-İhale / Talep Aç
            </a>
          </div>
          <button type="button" id="mwQuickPostSubmit" class="btn btn-sm btn-danger fw-bold px-3">
            <i class="bi bi-send-fill me-1"></i> Akışta Paylaş
          </button>
        </div>
        <div id="mwQuickPostFeedback" class="small mt-2" style="display:none;"></div>
      </div>

      <!-- SAHİBİNDEN KAFASI VİTRİN İLANLARI BÖLÜMÜ -->
      <div class="mw-panel-card p-3 mb-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0"><i class="bi bi-stars text-danger me-1"></i> Vitrin İlanları & Acil Fırsatlar</h6>
            <small class="text-muted">Emlak, Binek/Ticari Oto, Sanayi Makinesi & 2. El Fırsatlar</small>
          </div>
          <a href="/ilanlar" class="btn btn-sm btn-outline-danger fw-semibold">Tüm İlanlar</a>
        </div>

        <div id="mwHomeVitrinGrid" class="row g-2">
          <div class="col-12 text-center py-4 text-muted small">
            <div class="spinner-border spinner-border-sm text-danger me-2" role="status"></div>
            Canlı vitrin ilanları yükleniyor...
          </div>
        </div>
      </div>

      <!-- SOSYAL MEDYA + TİCARET AKIŞI (FEED) -->
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-bold mb-0"><i class="bi bi-activity text-danger me-1"></i> Canlı İş Ağı & Sosyal Akış</h6>
        <span class="badge bg-danger-subtle text-danger">Üyeliksiz Açık Erişim</span>
      </div>

      <div id="mwHomeSocialFeed" class="d-flex flex-column gap-3 mb-4">
        <!-- JS ile Canlı D1 Postları buraya yüklenir -->
      </div>
    </div>

    <!-- SAĞ SÜTUN (%25): Akıllı Eşleşme (2+1) + Canlı E-İhaleler + Ekosistem Köprüsü -->
    <div class="col-lg-3">
      <!-- 2+1 Akıllı Eşleşme Özeti -->
      <div class="mw-panel-card p-3 mb-4 shadow-sm border-danger">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="badge bg-danger">2 Hedef + 1 Sürpriz</span>
          <small class="text-muted fw-semibold">Akıllı Eşleşme</small>
        </div>
        <h6 class="fw-bold mb-1">Zaman Kaybetmeden Nokta Atışı İş Ağı</h6>
        <p class="small text-muted mb-3">
          Tanışmak istediğiniz <strong>en fazla 5 sektörü</strong> seçin; sistem size uygun <strong>2 hedef firma</strong> + farklı sektörden <strong>1 sürpriz fırsat firması</strong> eşleştirsin!
        </p>
        <div id="mwHomeMatchPreview" class="d-flex flex-column gap-2 mb-3"></div>
        <a href="/akilli-eslesme" class="btn btn-danger btn-sm w-100 fw-bold">
          <i class="bi bi-magic me-1"></i> Eşleşmelerimi Gör
        </a>
      </div>

      <!-- Aktif Satın Alma & E-İhale Radarı -->
      <div class="mw-panel-card p-3 mb-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
          <h6 class="fw-bold mb-0"><i class="bi bi-hammer text-danger me-1"></i> Canlı Talepler ({3105 + talepler.length})</h6>
          <a href="/ihaleler" class="small text-danger fw-bold text-decoration-none">Tümü</a>
        </div>
        <div class="d-flex flex-column gap-2">
          {recentTalepler.map((t) => (
            <a href={`/talepler/${t.slug}`} class="p-2 rounded border text-decoration-none d-block" style="border-color:var(--mw-border) !important;">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge bg-danger" style="font-size:0.65rem;">{t.category || 'Alım Talebi'}</span>
                <small class="text-muted" style="font-size:0.7rem;">#{t.id}</small>
              </div>
              <div class="fw-semibold small text-truncate" style="color:var(--mw-text);">{t.title}</div>
            </a>
          ))}
        </div>
        <a href="/ihaleler" class="btn btn-outline-danger btn-sm w-100 mt-3 fw-semibold">
          Teklif Ver / İhale Başlat
        </a>
      </div>

      <!-- StokPratik CariNet & DepodanDirekt Köprü Kartı -->
      <div class="mw-panel-card p-3 shadow-sm">
        <h6 class="fw-bold mb-2"><i class="bi bi-Cpu text-danger me-1"></i> Entegre Ticaret Gücü</h6>
        <div class="p-2 rounded mb-2" style="background:var(--mw-surface-alt);">
          <div class="fw-bold small text-danger">StokPratik ERP & CariNet</div>
          <small class="text-muted d-block mb-1">40+ entegrasyon, e-Fatura, depo barkod ve cariye özel B2B toptan ekranı.</small>
          <a href="https://stokpratik.com.tr" target="_blank" class="small fw-bold text-decoration-none text-danger">StokPratik'e Git →</a>
        </div>
        <div class="p-2 rounded" style="background:var(--mw-surface-alt);">
          <div class="fw-bold small text-danger">DepodanDirekt.com</div>
          <small class="text-muted d-block mb-1">Alibaba mantığı küresel ihracat ve fabrikadan direkt toptan pazaryeri.</small>
          <a href="https://depodandirekt.com" target="_blank" class="small fw-bold text-decoration-none text-danger">Toptan Pazaryerine Git →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- MEVCUT KURUMSAL BİLGİ, İŞLEYİŞ, ETKİNLİKLER VE TANITIM BÖLÜMLERİ (KORUNAN YAPI) -->
  <section class="mw-panel-card p-4 p-lg-5 mb-5 shadow-sm">
    <div class="text-center mb-4">
      <span class="badge bg-danger mb-2 px-3 py-2">MeetWork Kurumsal İşleyiş & Ekosistem Rehberi</span>
      <h2 class="fw-bold">MeetWork Nasıl Çalışır? Neden B2B Networking?</h2>
      <p class="text-muted mx-auto" style="max-width: 720px;">
        Fiziksel Mini & Maxi toplantılarımızdan küresel ülke/şehir temsilciliklerimize, dış ticaret desteklerinden kurumsal eşleştirme sistemimize kadar tüm bilgi sayfalarımıza buradan ulaşabilirsiniz.
      </p>
    </div>

    <div class="row g-3">
      <div class="col-md-3 col-sm-6">
        <div class="p-3 rounded h-100 border" style="border-color:var(--mw-border) !important;">
          <i class="bi bi-people-fill fs-3 text-danger"></i>
          <h6 class="fw-bold mt-2">Yüz Yüze Networking</h6>
          <p class="small text-muted mb-2">Mini (kahvaltılı/yemekli) ve Maxi etkinliklerle karar vericilerle aynı masada buluşun.</p>
          <a href="/etkinlik" class="small fw-bold text-danger text-decoration-none">Detaylı İncele →</a>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="p-3 rounded h-100 border" style="border-color:var(--mw-border) !important;">
          <i class="bi bi-globe-americas fs-3 text-danger"></i>
          <h6 class="fw-bold mt-2">Türkiye & Dünya Temsilcileri</h6>
          <p class="small text-muted mb-2">81 il ve onlarca ülkede yerel MeetWork temsilcilerimizle küresel ticaret ağınızı büyütün.</p>
          <a href="/meetwork-temsilciler-turkiye" class="small fw-bold text-danger text-decoration-none">Temsilcilikler →</a>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="p-3 rounded h-100 border" style="border-color:var(--mw-border) !important;">
          <i class="bi bi-rocket-takeoff-fill fs-3 text-danger"></i>
          <h6 class="fw-bold mt-2">PRO Dijital Dönüşüm & Teşvikler</h6>
          <p class="small text-muted mb-2">Ticaret Bakanlığı ihracat destekleri, hibe/teşvik rehberleri ve ücretsiz PRO avantajları.</p>
          <a href="/dijital-donusum" class="small fw-bold text-danger text-decoration-none">Avantajları Gör →</a>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="p-3 rounded h-100 border" style="border-color:var(--mw-border) !important;">
          <i class="bi bi-calculator-fill fs-3 text-danger"></i>
          <h6 class="fw-bold mt-2">Ticari Hesaplama & Rehberler</h6>
          <p class="small text-muted mb-2">Pazaryeri komisyon hesaplayıcı, şirket değerleme, konşimento ve dış ticaret sözlüğü.</p>
          <a href="/hesaplama" class="small fw-bold text-danger text-decoration-none">Araçları Kullan →</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';

      function getTrustBadge(level) {
        if (Number(level) >= 3) return '<span class="mw-trust-badge-3"><i class="bi bi-patch-check-fill"></i> MeetWork Gold Onaylı</span>';
        if (Number(level) === 2) return '<span class="mw-trust-badge-2"><i class="bi bi-shield-check"></i> StokPratik VKN Onaylı</span>';
        return '<span class="mw-trust-badge-1"><i class="bi bi-check-circle"></i> Kayıtlı Üye</span>';
      }

      async function loadHomeFeed() {
        const vitrinGrid = document.getElementById('mwHomeVitrinGrid');
        const feedContainer = document.getElementById('mwHomeSocialFeed');
        const matchPreview = document.getElementById('mwHomeMatchPreview');

        try {
          const res = await fetch(`${API_URL}/api/feed`);
          const data = await res.json();

          // 1. Vitrin İlanları
          if (vitrinGrid) {
            const listings = data.vitrinListings || [];
            if (listings.length === 0) {
              vitrinGrid.innerHTML = `
                <div class="col-12 text-center py-4">
                  <p class="small text-muted mb-2">Henüz vitrine eklenmiş ilan bulunmuyor. İlk ilanı ücretsiz siz yayınlayın!</p>
                  <a href="/ilanlar?yeni=1" class="btn btn-sm btn-danger fw-bold">+ İlk İlanı Ücretsiz Ver</a>
                </div>`;
            } else {
              vitrinGrid.innerHTML = listings.slice(0, 6).map((item) => `
                <div class="col-sm-6 col-md-4">
                  <a href="/ilanlar?ilan=${encodeURIComponent(item.slug || item.listing_no)}" class="mw-vitrin-card p-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="badge ${item.is_urgent ? 'bg-danger' : 'bg-dark'}" style="font-size:0.65rem;">
                        ${item.is_urgent ? 'ACİL' : item.listing_type} • ${item.main_category}
                      </span>
                      <small class="text-muted" style="font-size:0.65rem;">#${item.listing_no}</small>
                    </div>
                    <div class="fw-bold small mb-1 text-truncate">${item.title}</div>
                    <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top" style="border-color:var(--mw-border)!important;">
                      <span class="fw-bolder text-danger small">${Number(item.price).toLocaleString('tr-TR')} ${item.currency}</span>
                      <small class="text-muted" style="font-size:0.7rem;"><i class="bi bi-geo-alt"></i> ${item.seller_city}</small>
                    </div>
                  </a>
                </div>
              `).join('');
            }
          }

          // 2. Sosyal Medya Akışı
          if (feedContainer) {
            const posts = data.posts || [];
            if (posts.length === 0) {
              feedContainer.innerHTML = `
                <div class="mw-panel-card p-4 text-center">
                  <i class="bi bi-chat-square-quote fs-2 text-danger"></i>
                  <h6 class="fw-bold mt-2">MeetWork Sosyal Ticaret Akışı Hazır</h6>
                  <p class="small text-muted mb-0">Yukarıdaki kutudan ilk iş paylaşımınızı yapın veya yeni bir ilan/ihale yayınlayın.</p>
                </div>`;
            } else {
              feedContainer.innerHTML = posts.map((post) => `
                <div class="mw-panel-card p-3 shadow-sm">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex gap-2 align-items-center">
                      <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold" style="width:38px;height:38px;">
                        ${(post.company_name || post.author_name || 'M').slice(0, 2).toUpperCase()}
                      </div>
                      <div>
                        <div class="fw-bold small">
                          ${post.author_name}
                          ${post.company_name ? `<span class="text-muted fw-normal"> • ${post.company_name}</span>` : ''}
                        </div>
                        <div class="d-flex align-items-center gap-2">
                          ${getTrustBadge(post.trust_level)}
                          <small class="text-muted" style="font-size:0.7rem;">${new Date(post.created_at).toLocaleDateString('tr-TR')}</small>
                        </div>
                      </div>
                    </div>
                    <div class="d-flex gap-1">
                      <a href="/ihaleler?yeni=1" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:0.72rem;">Teklif İste</a>
                      ${post.company_slug ? `<a href="/isletmeler?firma=${encodeURIComponent(post.company_slug)}" class="btn btn-sm btn-dark py-0 px-2" style="font-size:0.72rem;">Mağaza / Stoklar</a>` : ''}
                    </div>
                  </div>
                  <p class="small mb-2" style="white-space:pre-line;">${post.content}</p>
                  <div class="d-flex justify-content-between align-items-center pt-2 border-top small" style="border-color:var(--mw-border)!important;">
                    <button type="button" class="btn btn-sm btn-link text-decoration-none text-danger p-0" onclick="window.mwLikePost('${post.id}', this)">
                      <i class="bi bi-hand-thumbs-up-fill"></i> Beğen (<span>${post.likes_count || 0}</span>)
                    </button>
                    <a href="/isletmeler" class="small text-muted text-decoration-none">
                      <i class="bi bi-box-seam text-danger"></i> B2B CariNet & Toptan Ürünlerini Gör →
                    </a>
                  </div>
                </div>
              `).join('');
            }
          }

          // 3. Öne Çıkan İşletmeler / Eşleşme Önizleme
          if (matchPreview) {
            const comps = data.featuredCompanies || [];
            if (comps.length > 0) {
              matchPreview.innerHTML = comps.slice(0, 3).map((c, idx) => `
                <a href="/isletmeler?firma=${encodeURIComponent(c.slug)}" class="p-2 rounded border text-decoration-none d-flex justify-content-between align-items-center" style="border-color:var(--mw-border)!important;">
                  <div class="text-truncate pe-2">
                    <div class="fw-bold small" style="color:var(--mw-text);">${c.name}</div>
                    <small class="text-muted" style="font-size:0.7rem;">${idx < 2 ? '🎯 Hedef:' : '🎲 Sürpriz:'} ${c.sector} (${c.city || 'Türkiye'})</small>
                  </div>
                  <span class="badge bg-danger">İncele</span>
                </a>
              `).join('');
            }
          }
        } catch (_) {}
      }

      window.mwLikePost = async function (postId, btnEl) {
        try {
          await fetch(`${API_URL}/api/posts/${postId}/like`, { method: 'POST' });
          const span = btnEl.querySelector('span');
          if (span) span.textContent = String(Number(span.textContent || 0) + 1);
        } catch (_) {}
      };

      document.addEventListener('DOMContentLoaded', () => {
        loadHomeFeed();

        const submitBtn = document.getElementById('mwQuickPostSubmit');
        const contentInput = document.getElementById('mwQuickPostContent');
        const feedback = document.getElementById('mwQuickPostFeedback');

        if (submitBtn && contentInput) {
          submitBtn.addEventListener('click', async () => {
            const text = contentInput.value.trim();
            if (!text) return;

            let user = null;
            try { user = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}

            submitBtn.disabled = true;
            try {
              const res = await fetch(`${API_URL}/api/posts`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  user_id: user ? user.user_id : 'guest',
                  company_id: user ? user.company_id : '',
                  author_name: user ? user.full_name : 'MeetWork Ziyaretçi Üye',
                  company_name: user ? user.company_name : 'Doğrulanmış İş Ağı',
                  company_slug: user ? user.company_slug : '',
                  trust_level: user ? user.trust_level : 1,
                  content: text
                })
              });
              const out = await res.json();
              if (out.success) {
                contentInput.value = '';
                if (feedback) {
                  feedback.style.display = 'block';
                  feedback.className = 'small mt-2 text-success fw-bold';
                  feedback.textContent = '✓ Paylaşımınız canlı akışa eklendi!';
                }
                loadHomeFeed();
              }
            } catch (_) {}
            submitBtn.disabled = false;
          });
        }
      });
    })();
  </script>
</BaseLayout>