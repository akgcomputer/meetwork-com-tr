              <option value="linear-gradient(135deg, #78350f 0%, #f59e0b 100%)">Altın Kehribar (Gold الفırsat)</option>
            </select>
          </div>
          <div id="mwAddStoryFeedback" class="small mb-2" style="display:none;"></div>
          <div class="d-grid">
            <button type="submit" class="btn btn-danger fw-bold">Hikayeyi Canlı Vitrine Ekle</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';
      document.querySelectorAll('.mw-mobile-crm-save-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const companyName = btn.getAttribute('data-company-name') || 'MeetWork İş Ortağı';
          const vkn = btn.getAttribute('data-vkn') || '2720912021';
          const sector = btn.getAttribute('data-sector') || 'Sanayi';
          const city = btn.getAttribute('data-city') || 'İstanbul';
          btn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">sync</span><span>Kaydediliyor...</span>';
          try {
            await fetch(`${API_URL}/api/bridge/crm-cari-sync`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                partner_company_name: companyName,
                partner_vkn: vkn,
                partner_sector: sector,
                partner_city: city,
                match_source: 'Canlı İş Akışı (Mobil)',
                create_sample_quote_draft: false
              })
            });
          } catch (_) {}
          btn.innerHTML = '<span class="material-symbols-outlined text-[16px] text-trust-emerald">check_circle</span><span>CRM\'e Aktarıldı</span>';
        });
      });
    });
  </script>
</BaseLayout>