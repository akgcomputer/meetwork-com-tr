      function getTrustBadge(level) {
        if (Number(level) >= 3) return '<span class="mw-trust-badge-3"><i class="bi bi-patch-check-fill"></i> Gold Onaylı</span>';
        if (Number(level) === 2) return '<span class="mw-trust-badge-2"><i class="bi bi-shield-check"></i> Silver Onaylı</span>';
        return '<span class="mw-trust-badge-1"><i class="bi bi-check-circle"></i> İş Ağı Üyesi</span>';
      }

      function hydrateUserSidebar() {
        let user = null;
        try { user = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}
        if (!user) return;

        const avatar = document.getElementById('mwSidebarAvatar');
        const composerAvatar = document.getElementById('mwComposerAvatar');
        const userName = document.getElementById('mwSidebarUserName');
        const compName = document.getElementById('mwSidebarCompanyName');
        const badgeWrap = document.getElementById('mwSidebarBadgeWrap');
        const actions = document.getElementById('mwSidebarAuthActions');

        const initials = (user.company_name || user.full_name || 'MW').slice(0, 2).toUpperCase();
        if (avatar) avatar.textContent = initials;
        if (composerAvatar) composerAvatar.textContent = initials;
        if (userName) userName.textContent = user.company_name || user.full_name || 'MeetWork Üyesi';
        if (compName) compName.textContent = `${user.full_name || 'Kurumsal Üye'} • ${user.sector || 'B2B İş Ağı'}`;
        if (badgeWrap) badgeWrap.innerHTML = getTrustBadge(user.trust_level || 2);

        if (actions) {
          const profileHref = user.company_slug ? `/isletmeler?firma=${encodeURIComponent(user.company_slug)}` : '/isletmeler';
          actions.innerHTML = `
            <a href="${profileHref}" class="btn btn-danger btn-sm fw-bold">
              <i class="bi bi-building-fill-check me-1"></i> İşletme Vitrinim
            </a>
            <div class="d-flex gap-1">
              <a href="/akilli-eslesme" class="btn btn-outline-secondary btn-sm flex-grow-1" style="font-size:0.75rem;">Akıllı Eşleşme</a>
              ${user.role === 'superadmin' ? '<a href="/yonetim" class="btn btn-dark btn-sm flex-grow-1" style="font-size:0.75rem;"><i class="bi bi-shield-lock-fill text-danger"></i> Yönetim</a>' : '<a href="/ilanlar?yeni=1" class="btn btn-outline-danger btn-sm flex-grow-1" style="font-size:0.75rem;">+ İlan Ver</a>'}
            </div>
          `;
        }
      }

      function renderStoriesBar() {
        const row = document.getElementById('mwHomeStoriesRow');
        if (!row) return;
        const stories = (cachedFeedData.stories && cachedFeedData.stories.length > 0)
          ? cachedFeedData.stories
          : fallbackStories;

        window.__mwStoriesList = stories;

        const addBtnHtml = `
          <div class="mw-story-item" data-bs-toggle="modal" data-bs-target="#mwAddStoryModal">
            <div class="mw-story-add-ring">
              <i class="bi bi-plus-lg"></i>
            </div>
            <span class="fw-bold text-truncate w-100 text-center" style="font-size: 0.7rem;">Hikaye Ekle</span>
          </div>
        `;

        const itemsHtml = stories.map((st, idx) => {
          const initials = (st.company_name || 'MW').slice(0, 2).toUpperCase();
          const isSilver = Number(st.trust_level) === 2;
          const bg = st.bg_gradient || 'linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%)';
          return `
            <div class="mw-story-item" onclick="window.mwOpenStory(${idx})">
              <div class="mw-story-ring ${isSilver ? 'mw-story-ring-silver' : ''}">
                <div class="mw-story-inner" style="background: ${bg};">
                  ${initials}
                </div>
              </div>
              <span class="fw-semibold text-truncate w-100 text-center" style="font-size: 0.69rem;">${st.company_name}</span>
            </div>
          `;
        }).join('');

        row.innerHTML = addBtnHtml + itemsHtml;
      }

      window.mwOpenStory = function (idx) {
        const stories = window.__mwStoriesList || fallbackStories;
        const st = stories[idx];
        if (!st) return;

        document.getElementById('mwStoryModalBody').style.background = st.bg_gradient || 'linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%)';
        document.getElementById('mwStoryViewAvatar').textContent = (st.company_name || 'MW').slice(0, 2).toUpperCase();
        document.getElementById('mwStoryViewCompany').textContent = st.company_name || 'MeetWork İşletmesi';
        document.getElementById('mwStoryViewCategory').textContent = st.category || 'İş Gündemi';
        document.getElementById('mwStoryViewBadge').textContent = Number(st.trust_level) >= 3 ? '★ Gold Onaylı İşletme' : '✓ Silver Onaylı İşletme';
        document.getElementById('mwStoryViewTitle').textContent = st.title || '';
        document.getElementById('mwStoryViewContent').textContent = st.content || '';
        const cta = document.getElementById('mwStoryViewCta');
        if (cta) {
          cta.textContent = (st.cta_label || 'İşletme Vitrinini İncele') + ' →';
          cta.setAttribute('href', st.cta_url || (st.company_slug ? `/isletmeler?firma=${st.company_slug}` : '/isletmeler'));
        }

        const modalEl = document.getElementById('mwStoryViewerModal');
        if (modalEl && window.bootstrap) {
          const modal = new window.bootstrap.Modal(modalEl);
          modal.show();
        }
      };

