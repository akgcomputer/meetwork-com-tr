        if (!st) return;

        document.getElementById('mwStoryModalBody').style.background = st.bg_gradient || 'linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%)';
        document.getElementById('mwStoryViewAvatar').textContent = (st.company_name || 'MW').slice(0, 2).toUpperCase();
        document.getElementById('mwStoryViewCompany').textContent = st.company_name || 'MeetWork İşletmesi';
        document.getElementById('mwStoryViewCategory').textContent = st.category || 'İş Gündemi';
        document.getElementById('mwStoryViewBadge').textContent = Number(st.trust_level) >= 3 ? '★ Gold Onaylı İşletme' : '✓ Silver Onaylı İşletme';
        document.getElementById('mwStoryViewTitle').textContent = st.title || '';
        document.getElementById('mwStoryViewContent').textContent = st.content || '';
        const cta = document.getElementById('mwStoryViewCta');
        if (cta) {
          cta.textContent = (st.cta_label || 'İşletme Vitrinini İncele') + ' →';
          cta.setAttribute('href', st.cta_url || (st.company_slug ? `/isletmeler?firma=${st.company_slug}` : '/isletmeler'));
        }

        const modalEl = document.getElementById('mwStoryViewerModal');
        if (modalEl && window.bootstrap) {
          const modal = new window.bootstrap.Modal(modalEl);
          modal.show();
        }
      };

