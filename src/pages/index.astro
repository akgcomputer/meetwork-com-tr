      function renderInlineTenderCard(tender, zebraClass) {
        return `
          <div class="mw-panel-card ${zebraClass || ''} p-3 shadow-sm border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="badge bg-success"><i class="bi bi-hammer me-1"></i> Canlı E-İhale • ${tender.tender_type || 'Açık Eksiltme'}</span>
              <small class="text-muted" style="font-size:0.7rem;">#${tender.tender_no || tender.id}</small>
            </div>
            <h6 class="fw-bold mb-1">${tender.title}</h6>
            <p class="small text-muted mb-2">${tender.description || 'Kurumsal tedarik ve satın alma ihalesi.'}</p>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color:var(--mw-border)!important;">
              <span class="small fw-bold text-success">Başlangıç / Hedef: ${Number(tender.start_price || 0).toLocaleString('tr-TR')} ${tender.currency || 'TRY'}</span>
              <a href="/ihaleler" class="btn btn-sm btn-danger py-0 px-3 fw-bold" style="font-size:0.75rem;">Teklif Ver</a>
            </div>
          </div>
        `;
      }

      function getZebraClass(index) {
        // index 0 -> 1. paylaşım (Hafif Gri), index 1 -> 2. paylaşım (Beyaz), index 2 -> 3. paylaşım (Hafif Gri), index 4 -> 5. paylaşım (Hafif Gri)
        return index % 2 === 0 ? 'mw-zebra-odd' : 'mw-zebra-even';
      }

      function renderFeedStream() {
        const feedContainer = document.getElementById('mwHomeSocialFeed');
        if (!feedContainer) return;

        const apiPosts = cachedFeedData.posts || [];
        const combinedPosts = [...apiPosts, ...fallbackSocialPosts];
        const seenKeys = new Set();
        const posts = combinedPosts.filter((p) => {
          const key = `${p.author_name || ''}_${(p.content || '').slice(0, 40)}`;
          if (seenKeys.has(key)) return false;
          seenKeys.add(key);
          return true;
        });
        const listings = cachedFeedData.vitrinListings || [];
        const tenders = cachedFeedData.activeTenders || [];

        if (currentFilter === 'posts') {
          feedContainer.innerHTML = posts.map((p, idx) => renderPostCard(p, getZebraClass(idx))).join('');
          return;
        }
        if (currentFilter === 'listings') {
          feedContainer.innerHTML = listings.length > 0
            ? listings.map((item, idx) => renderInlineListingCard(item, getZebraClass(idx))).join('')
            : '<div class="mw-panel-card mw-zebra-odd p-4 text-center small text-muted">Vitrin ilanı bulunamadı.</div>';
          return;
        }
        if (currentFilter === 'tenders') {
          feedContainer.innerHTML = tenders.length > 0
            ? tenders.map((t, idx) => renderInlineTenderCard(t, getZebraClass(idx))).join('')
            : '<div class="mw-panel-card mw-zebra-odd p-4 text-center small text-muted">Aktif e-ihale bulunamadı.</div>';
          return;
        }

        const rawItems = [];
        posts.forEach((p) => rawItems.push({ type: 'post', data: p }));
        const maxExtra = Math.max(listings.length, tenders.length);
        for (let i = 0; i < maxExtra; i++) {
          if (listings[i] && i < 3) rawItems.push({ type: 'listing', data: listings[i] });
          if (tenders[i] && i < 2) rawItems.push({ type: 'tender', data: tenders[i] });
        }

        const streamHtml = rawItems.map((entry, idx) => {
          const zClass = getZebraClass(idx);
          if (entry.type === 'post') return renderPostCard(entry.data, zClass);
          if (entry.type === 'listing') return renderInlineListingCard(entry.data, zClass);
          return renderInlineTenderCard(entry.data, zClass);
        });

        feedContainer.innerHTML = streamHtml.join('');
      }

      async function loadHomeFeed() {
        const matchPreview = document.getElementById('mwHomeMatchPreview');
        renderStoriesBar();

        try {
          const res = await fetch(`${API_URL}/api/feed`);
          const data = await res.json();
          cachedFeedData = data || {};
          renderStoriesBar();
          renderFeedStream();

          if (matchPreview) {
            const comps = data.featuredCompanies || [];
            if (comps.length > 0) {
              matchPreview.innerHTML = comps.slice(0, 3).map((c, idx) => `
                <div class="p-2 rounded border d-flex justify-content-between align-items-center" style="border-color:var(--mw-border)!important;">
                  <div class="text-truncate pe-2">
                    <div class="d-flex align-items-center gap-1">
                      <span class="badge ${idx < 2 ? 'bg-danger' : 'bg-dark'}" style="font-size:0.6rem;">
                        ${idx < 2 ? '🎯 Hedef' : '🎲 Sürpriz'}
                      </span>
                      <a href="/isletmeler?firma=${encodeURIComponent(c.slug)}" class="fw-bold small text-decoration-none text-truncate" style="color:var(--mw-text); font-size:0.78rem;">
                        ${c.name}
                      </a>
                    </div>
                    <small class="text-muted d-block mt-1" style="font-size:0.68rem;">${c.sector} • ${c.city || 'Türkiye'}</small>
                  </div>
                  <a href="/akilli-eslesme" class="btn btn-sm btn-outline-danger py-0 px-2 flex-shrink-0" style="font-size:0.7rem;">
                    + Tanış
                  </a>
                </div>
              `).join('');
            }
          }
        } catch (_) {
          renderStoriesBar();
          renderFeedStream();
        }
      }

      window.mwLikePost = async function (postId, btnEl) {
        const span = btnEl.querySelector('span');
        if (span) span.textContent = String(Number(span.textContent || 0) + 1);
        if (!String(postId).startsWith('seed-')) {
          try {
            await fetch(`${API_URL}/api/posts/${postId}/like`, { method: 'POST' });
          } catch (_) {}
        }
      };

      document.addEventListener('DOMContentLoaded', () => {
        hydrateUserSidebar();
        loadHomeFeed();

        // Filtre sekmeleri
        const filterButtons = document.querySelectorAll('[data-feed-filter]');
        filterButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterButtons.forEach((b) => {
              b.classList.remove('btn-danger');
              b.classList.add('btn-outline-secondary');
            });
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-danger');
            currentFilter = btn.getAttribute('data-feed-filter') || 'all';
            renderFeedStream();
          });
        });

        // Yeni Hikaye Ekleme Formu
        const storyForm = document.getElementById('mwAddStoryForm');
        if (storyForm) {
          storyForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            let user = null;
            try { user = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}

            const title = document.getElementById('mwStoryTitle').value.trim();
            const content = document.getElementById('mwStoryContent').value.trim();
            const category = document.getElementById('mwStoryCategory').value;
            const bg_gradient = document.getElementById('mwStoryGradient').value;
            const fb = document.getElementById('mwAddStoryFeedback');

            try {
              const res = await fetch(`${API_URL}/api/stories`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  company_id: user ? user.company_id : '',
                  company_name: user ? user.company_name : 'MeetWork Üye İşletme',
                  company_slug: user ? user.company_slug : '',
                  author_name: user ? user.full_name : 'İş Ağı Üyesi',
                  trust_level: user ? user.trust_level : 2,
                  title,
                  content,
                  category,
                  bg_gradient
                })
              });
              const out = await res.json();
              if (out.success) {
                storyForm.reset();
                if (fb) {
                  fb.style.display = 'block';
                  fb.className = 'small mb-2 text-success fw-bold';
                  fb.textContent = '✓ Hikayeniz canlı vitrine eklendi!';
                }
                loadHomeFeed();
              }
            } catch (_) {}
          });
        }

        // Hızlı Post Paylaşımı
        const submitBtn = document.getElementById('mwQuickPostSubmit');
        const contentInput = document.getElementById('mwQuickPostContent');
        const tagSelect = document.getElementById('mwQuickPostTag');
        const feedback = document.getElementById('mwQuickPostFeedback');

        if (submitBtn && contentInput) {
          submitBtn.addEventListener('click', async () => {
            const text = contentInput.value.trim();
            if (!text) return;

            let user = null;
            try { user = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}
            const selectedTag = tagSelect ? tagSelect.value : 'İş & Sektör Paylaşımı';

            submitBtn.disabled = true;
            try {
              const res = await fetch(`${API_URL}/api/posts`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  user_id: user ? user.user_id : 'guest',
                  company_id: user ? user.company_id : '',
                  author_name: user ? user.full_name : 'MeetWork İş Ağı Üyesi',
                  company_name: user ? user.company_name : 'Doğrulanmış İş Ağı',
                  company_slug: user ? user.company_slug : '',
                  trust_level: user ? user.trust_level : 1,
                  content: `[${selectedTag}] ${text}`
                })
              });
              const out = await res.json();
              if (out.success) {
                contentInput.value = '';
                if (feedback) {
                  feedback.style.display = 'block';
                  feedback.className = 'small mt-2 text-success fw-bold';
                  feedback.textContent = '✓ Paylaşımınız canlı iş ağı akışına eklendi!';
                }
                loadHomeFeed();
              }
            } catch (_) {}
            submitBtn.disabled = false;
          });
        }
      });
    })();
  </script>
</BaseLayout>