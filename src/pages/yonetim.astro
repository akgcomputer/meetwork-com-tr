---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SuperAdmin Yönetim Girişi | MeetWork"
  description="MeetWork SuperAdmin Şifreli Yönetim Merkezi."
>
  <!-- 1. ŞİFRELİ SUPERADMIN GİRİŞ EKRANI (Varsayılan Olarak Açık, Panel Gizli) -->
  <div id="saLoginWall" class="py-5">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-4">
        <div class="mw-panel-card p-4 p-md-5 shadow border-danger" style="border-top: 4px solid var(--mw-red) !important;">
          <div class="text-center mb-4">
            <div
              class="rounded-circle bg-danger text-white d-inline-flex align-items-center justify-content-center mb-3 shadow-sm"
              style="width: 60px; height: 60px; font-size: 1.6rem;"
            >
              <i class="bi bi-shield-lock-fill"></i>
            </div>
            <span class="badge bg-dark d-block mx-auto mb-2" style="width: fit-content;">YETKİLİ ERİŞİM KORUMASI</span>
            <h1 class="h4 fw-bold mb-1">SuperAdmin Yönetim Girişi</h1>
            <p class="small text-muted mb-0">
              Bu alan şifrelidir. Devam etmek için lütfen SuperAdmin yönetici bilgilerinizi girin.
            </p>
          </div>

          <div id="saLoginErrorBox" class="alert alert-danger small fw-semibold py-2" style="display: none;"></div>

          <form id="saLoginForm" autocomplete="off">
            <div class="mb-3">
              <label class="form-label small fw-bold mb-1">
                <i class="bi bi-envelope-fill text-danger me-1"></i> Yönetici E-Posta
              </label>
              <input
                type="email"
                id="saLoginEmail"
                class="form-control form-control-sm"
                placeholder="yonetim@meetwork.com.tr"
                required
              />
            </div>

            <div class="mb-4">
              <label class="form-label small fw-bold mb-1">
                <i class="bi bi-key-fill text-danger me-1"></i> Yönetici Şifresi
              </label>
              <input
                type="password"
                id="saLoginPassword"
                class="form-control form-control-sm"
                placeholder="••••••••••••"
                required
              />
            </div>

            <button type="submit" id="saLoginSubmitBtn" class="btn btn-danger w-100 fw-bold py-2">
              <i class="bi bi-unlock-fill me-1"></i> Doğrula ve Yönetim Panelini Aç
            </button>
          </form>

          <div class="text-center mt-3 pt-3 border-top" style="border-color: var(--mw-border) !important;">
            <a href="/" class="small text-muted text-decoration-none">
              <i class="bi bi-arrow-left me-1"></i> Ana Sayfaya Dön
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. KORUMALI SUPERADMIN KONTROL PANELİ (Şifre Doğrulanmadan Görünmez) -->
  <div id="saProtectedDashboard" style="display: none;">
    <!-- Üst Başlık ve Hızlı İstatistikler -->
    <div class="mw-panel-card p-4 mb-4 shadow-sm" style="border-top: 4px solid var(--mw-red)!important;">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <span class="badge bg-danger mb-1"><i class="bi bi-unlock-fill me-1"></i> ŞİFRELİ OTURUM AÇIK (SUPERADMIN)</span>
          <h2 class="h3 fw-bold mb-0">MeetWork SuperAdmin Kontrol Paneli</h2>
          <small class="text-muted">Üye işletmeleri, 3 kademeli güven rozetlerini, ihale/eşleşme kredilerini, vitrin ilanlarını, ihaleleri ve hibe başvurularını buradan yönetebilirsiniz.</small>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <button type="button" id="saRefreshBtn" class="btn btn-outline-danger btn-sm fw-bold">
            <i class="bi bi-arrow-clockwise me-1"></i> Verileri Yenile
          </button>
          <button type="button" id="saLockBtn" class="btn btn-dark btn-sm fw-bold">
            <i class="bi bi-lock-fill text-danger me-1"></i> Paneli Kilitle & Çıkış
          </button>
        </div>
      </div>

      <div class="row g-3 text-center">
        <div class="col-6 col-md-2">
          <div class="p-3 rounded border" style="background:var(--mw-surface-alt);">
            <div class="h3 fw-bolder text-danger mb-0" id="statCompanies">0</div>
            <small class="text-muted fw-semibold">Kayıtlı İşletme</small>
          </div>
        </div>
        <div class="col-6 col-md-2">
          <div class="p-3 rounded border" style="background:var(--mw-surface-alt);">
            <div class="h3 fw-bolder text-danger mb-0" id="statUsers">0</div>
            <small class="text-muted fw-semibold">Kullanıcı / Yetkili</small>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="p-3 rounded border" style="background:var(--mw-surface-alt);">
            <div class="h3 fw-bolder text-danger mb-0" id="statListings">0</div>
            <small class="text-muted fw-semibold">Aktif İlan (Emlak/Oto/Makine)</small>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="p-3 rounded border" style="background:var(--mw-surface-alt);">
            <div class="h3 fw-bolder text-danger mb-0" id="statTenders">0</div>
            <small class="text-muted fw-semibold">Canlı E-İhale & RFQ</small>
          </div>
        </div>
        <div class="col-12 col-md-2">
          <div class="p-3 rounded border" style="background:var(--mw-surface-alt);">
            <div class="h3 fw-bolder text-danger mb-0" id="statPosts">0</div>
            <small class="text-muted fw-semibold">Sosyal Paylaşım</small>
          </div>
        </div>
      </div>
    </div>

    <div id="saAlertBox" class="alert" style="display:none;"></div>

    <!-- Yönetim Sekmeleri -->
    <div class="mw-panel-card p-4 shadow-sm">
      <ul class="nav nav-pills mb-4 gap-2 border-bottom pb-3" id="saTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active fw-bold" data-bs-toggle="pill" data-bs-target="#sa-tab-companies" type="button" role="tab">
            <i class="bi bi-buildings-fill me-1"></i> İşletmeler, Güven Rozetleri & Krediler
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#sa-tab-listings" type="button" role="tab">
            <i class="bi bi-shop-window me-1"></i> İlan Pazarı & Vitrin Yönetimi
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#sa-tab-tenders" type="button" role="tab">
            <i class="bi bi-hammer me-1"></i> E-İhale & Satın Alma Yönetimi
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#sa-tab-posts" type="button" role="tab">
            <i class="bi bi-chat-square-text-fill me-1"></i> Sosyal Akış Moderasyonu
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#sa-tab-grants" type="button" role="tab">
            <i class="bi bi-cash-coin me-1"></i> Hibe Başvuruları
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#sa-tab-grant-programs" type="button" role="tab">
            <i class="bi bi-calendar-range me-1"></i> Hibe Havuzu & Çağrı Takvimi (16)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#sa-tab-jobs" type="button" role="tab">
            <i class="bi bi-briefcase-fill me-1"></i> İş İlanları Yönetimi
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#sa-tab-talents" type="button" role="tab">
            <i class="bi bi-person-badge-fill me-1"></i> Yetenek Havuzu (İK)
          </button>
        </li>
      </ul>

      <div class="tab-content">
        <!-- 1. İŞLETMELER, GÜVEN ROZETİ VE KREDİ YÖNETİMİ -->
        <div class="tab-pane fade show active" id="sa-tab-companies" role="tabpanel">
          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead>
                <tr class="text-muted">
                  <th>İşletme Adı & VKN</th>
                  <th>Sektör & Şehir</th>
                  <th>Güven Rozeti Kademesi</th>
                  <th>Üyelik Paketi</th>
                  <th>Eşleşme / İhale Kredisi</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody id="saCompaniesTable">
                <tr><td colspan="6" class="text-center py-4">Yükleniyor...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. İLAN PAZARI YÖNETİMİ -->
        <div class="tab-pane fade" id="sa-tab-listings" role="tabpanel">
          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead>
                <tr class="text-muted">
                  <th>İlan No</th>
                  <th>Başlık & Kategori</th>
                  <th>Fiyat</th>
                  <th>Satıcı & Şehir</th>
                  <th>Vitrin / Acil Durumu</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody id="saListingsTable">
                <tr><td colspan="6" class="text-center py-4">Yükleniyor...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. E-İHALE YÖNETİMİ -->
        <div class="tab-pane fade" id="sa-tab-tenders" role="tabpanel">
          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead>
                <tr class="text-muted">
                  <th>İhale No</th>
                  <th>Başlık & Usul</th>
                  <th>Alıcı İşletme</th>
                  <th>Miktar</th>
                  <th>Teklif Sayısı / En Düşük</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody id="saTendersTable">
                <tr><td colspan="6" class="text-center py-4">Yükleniyor...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 4. SOSYAL AKIŞ MODERASYONU -->
        <div class="tab-pane fade" id="sa-tab-posts" role="tabpanel">
          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead>
                <tr class="text-muted">
                  <th>Yazar / Firma</th>
                  <th>Paylaşım İçeriği</th>
                  <th>Beğeni</th>
                  <th>Tarih</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody id="saPostsTable">
                <tr><td colspan="5" class="text-center py-4">Yükleniyor...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 5. HİBE, FON & KREDİ BAŞVURULARI YÖNETİMİ -->
        <div class="tab-pane fade" id="sa-tab-grants" role="tabpanel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="small fw-bold text-muted">Tüm üye işletmelerin ve DD İnternet Ltd. Şti.'nin başlattığı aktif hibe, AB fonu ve kredi başvuruları:</span>
            <a href="/hibe-kredi-eslesme" class="btn btn-sm btn-danger fw-bold">
              <i class="bi bi-magic me-1"></i> Hibe & Fon Eşleştirme Ekranını Aç →
            </a>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead>
                <tr class="text-muted">
                  <th>Başvuru No</th>
                  <th>İşletme / STK</th>
                  <th>Program & Kurum</th>
                  <th>Proje Başlığı</th>
                  <th>Güncel Aşama</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody id="saGrantsTable">
                <tr><td colspan="6" class="text-center py-4">Yükleniyor...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 6. HİBE & FON HAVUZU (GÜN BAZLI ÇAĞRI TAKVİMİ & LİMİT) YÖNETİMİ -->
        <div class="tab-pane fade" id="sa-tab-grant-programs" role="tabpanel">
          <div class="p-3 rounded border mb-3" style="background: var(--mw-surface-alt);">
            <h6 class="fw-bold mb-2"><i class="bi bi-plus-circle-fill text-danger me-1"></i> Yeni Hibe / Teşvik / Kredi Programı Ekle veya Güncelle</h6>
            <form id="saAddGrantProgramForm" class="row g-2">
              <div class="col-md-3">
                <input type="text" id="sapCode" class="form-control form-control-sm" placeholder="Kod (Örn: KOSGEB-2026)" required />
              </div>
              <div class="col-md-5">
                <input type="text" id="sapTitle" class="form-control form-control-sm" placeholder="Program Başlığı" required />
              </div>
              <div class="col-md-4">
                <input type="text" id="sapProvider" class="form-control form-control-sm" placeholder="Kurum (Örn: KOSGEB / TÜBİTAK)" required />
              </div>
              <div class="col-md-2">
                <select id="sapScope" class="form-select form-select-sm">
                  <option value="yerel">🇹🇷 Yerel</option>
                  <option value="ab">🇪🇺 AB Fonu</option>
                  <option value="global">🌍 Global</option>
                </select>
              </div>
              <div class="col-md-3">
                <input type="text" id="sapRate" class="form-control form-control-sm" placeholder="Oran (Örn: %75 Hibe)" required />
              </div>
              <div class="col-md-3">
                <input type="text" id="sapMaxAmount" class="form-control form-control-sm" placeholder="Üst Limit (Örn: 5.000.000 TL)" required />
              </div>
              <div class="col-md-2">
                <input type="date" id="sapDeadlineDate" class="form-control form-control-sm" title="Son Başvuru Tarihi" />
              </div>
              <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-danger w-100 fw-bold">+ Havuza Ekle</button>
              </div>
            </form>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead>
                <tr class="text-muted">
                  <th>Kod & Program Adı</th>
                  <th>Kurum & Kapsam</th>
                  <th>Oran & Üst Limit</th>
                  <th>Son Başvuru Tarihi (Gün Bazlı)</th>
                  <th>Çağrı Durumu</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody id="saGrantProgramsTable">
                <tr><td colspan="6" class="text-center py-4">Yükleniyor...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 7. İŞ İLANLARI YÖNETİMİ (KARİYER MERKEZİ) -->
        <div class="tab-pane fade" id="sa-tab-jobs" role="tabpanel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="small fw-bold text-muted">İşverenlerin açtığı tam zamanlı ve dönemsel uzman iş ilanları:</span>
            <a href="/kariyer?tab=post-job" class="btn btn-sm btn-primary fw-bold">+ Yeni İş İlanı Aç →</a>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead>
                <tr class="text-muted">
                  <th>İlan No</th>
                  <th>Pozisyon & Departman</th>
                  <th>İşveren Firma</th>
                  <th>Maaş Aralığı & Şehir</th>
                  <th>Teşvik Notu</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody id="saJobsTable">
                <tr><td colspan="6" class="text-center py-4">Yükleniyor...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 8. YETENEK HAVUZU YÖNETİMİ (ADAY KARTLARI) -->
        <div class="tab-pane fade" id="sa-tab-talents" role="tabpanel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="small fw-bold text-muted">Kariyer merkezindeki adayların Yetenek Kartları, Gizli Radar durumu ve Devlet Teşvik rozetleri:</span>
            <a href="/kariyer" class="btn btn-sm btn-success fw-bold">Kariyer Merkezini Aç →</a>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead>
                <tr class="text-muted">
                  <th>Aday (Gerçek / Maskeli)</th>
                  <th>Uzmanlık & Departman</th>
                  <th>Deneyim & Şehir</th>
                  <th>Devlet İstihdam Teşviki Rozeti</th>
                  <th>Doğrulama</th>
                  <th>İşlem</th>
                </tr>
              </thead>
              <tbody id="saTalentsTable">
                <tr><td colspan="6" class="text-center py-4">Yükleniyor...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';
      let grantProgramsCache = [];

      function notify(msg, type = 'success') {
        const box = document.getElementById('saAlertBox');
        if (!box) return;
        box.style.display = 'block';
        box.className = `alert alert-${type} small fw-bold`;
        box.textContent = msg;
        setTimeout(() => { box.style.display = 'none'; }, 4000);
      }

      async function loadOverview() {
        try {
          const res = await fetch(`${API_URL}/api/superadmin/overview`);
          const data = await res.json();
          if (!data.success) return;

          document.getElementById('statCompanies').textContent = data.stats.total_companies;
          document.getElementById('statUsers').textContent = data.stats.total_users;
          document.getElementById('statListings').textContent = data.stats.total_listings;
          document.getElementById('statTenders').textContent = data.stats.total_tenders;
          document.getElementById('statPosts').textContent = data.stats.total_posts;

          const usersByComp = {};
          (data.users || []).forEach(u => {
            if (u.company_id) usersByComp[u.company_id] = u;
          });

          // Render Companies
          const compBody = document.getElementById('saCompaniesTable');
          compBody.innerHTML = (data.companies || []).map(c => {
            const u = usersByComp[c.id] || { match_credits: 3, tender_credits: 3 };
            return `
              <tr>
                <td>
                  <div class="fw-bold">${c.name}</div>
                  <small class="text-muted">VKN: ${c.vkn || 'Belirtilmedi'} • Slug: ${c.slug}</small>
                </td>
                <td>
                  <div>${c.sector}</div>
                  <small class="text-muted">${c.city || 'İstanbul'}</small>
                </td>
                <td>
                  <select class="form-select form-select-sm" id="trust_${c.id}">
                    <option value="1" ${Number(c.trust_level) === 1 ? 'selected' : ''}>Kademe 1: Standart Üye</option>
                    <option value="2" ${Number(c.trust_level) === 2 ? 'selected' : ''}>Kademe 2: Silver Onaylı</option>
                    <option value="3" ${Number(c.trust_level) >= 3 ? 'selected' : ''}>Kademe 3: Gold Onaylı</option>
                  </select>
                </td>
                <td>
                  <select class="form-select form-select-sm" id="tier_${c.id}">
                    <option value="free" ${c.membership_tier === 'free' ? 'selected' : ''}>Ücretsiz</option>
                    <option value="pro" ${c.membership_tier === 'pro' ? 'selected' : ''}>PRO Kurumsal</option>
                    <option value="gold" ${c.membership_tier === 'gold' ? 'selected' : ''}>GOLD (CariNet + VIP)</option>
                  </select>
                </td>
                <td>
                  <div class="d-flex gap-1 align-items-center">
                    <input type="number" class="form-control form-control-sm" style="width:65px;" id="mcred_${c.id}" value="${u.match_credits ?? 3}" title="Eşleşme Kredisi" />
                    <input type="number" class="form-control form-control-sm" style="width:65px;" id="tcred_${c.id}" value="${u.tender_credits ?? 3}" title="İhale Kredisi" />
                  </div>
                </td>
                <td>
                  <button class="btn btn-sm btn-danger fw-bold" onclick="window.saSaveCompany('${c.id}')">Kaydet</button>
                </td>
              </tr>
            `;
          }).join('') || '<tr><td colspan="6" class="text-center py-3">Kayıtlı işletme bulunmuyor.</td></tr>';

          // Render Listings
          const lstBody = document.getElementById('saListingsTable');
          lstBody.innerHTML = (data.listings || []).map(l => `
            <tr>
              <td class="fw-bold text-danger tabular-nums">#${l.listing_no}</td>
              <td>
                <div class="fw-bold">${l.title}</div>
                <small class="text-muted">${l.main_category} • ${l.listing_type}</small>
              </td>
              <td class="fw-bold tabular-nums">${Number(l.price).toLocaleString('tr-TR')} ${l.currency}</td>
              <td>${l.seller_name} (${l.seller_city})</td>
              <td>
                <button class="btn btn-sm ${l.is_vitrin ? 'btn-warning' : 'btn-outline-secondary'} me-1" onclick="window.saToggleListing('${l.id}', ${l.is_vitrin ? 0 : 1}, ${l.is_urgent})">
                  ⭐ Vitrin
                </button>
                <button class="btn btn-sm ${l.is_urgent ? 'btn-danger' : 'btn-outline-secondary'}" onclick="window.saToggleListing('${l.id}', ${l.is_vitrin}, ${l.is_urgent ? 0 : 1})">
                  🔥 Acil
                </button>
              </td>
              <td>
                <button class="btn btn-sm btn-outline-danger" onclick="window.saDeleteItem('listing', '${l.id}')"><i class="bi bi-trash"></i> Sil</button>
              </td>
            </tr>
          `).join('') || '<tr><td colspan="6" class="text-center py-3">Aktif ilan bulunmuyor.</td></tr>';

          // Render Tenders
          const tndBody = document.getElementById('saTendersTable');
          tndBody.innerHTML = (data.tenders || []).map(t => `
            <tr>
              <td class="fw-bold text-danger tabular-nums">#${t.tender_no}</td>
              <td>
                <div class="fw-bold">${t.title}</div>
                <span class="badge bg-danger">${t.tender_method}</span>
              </td>
              <td>${t.buyer_name}</td>
              <td>${t.quantity} ${t.unit}</td>
              <td>${t.bids_count || 0} Teklif ${t.lowest_bid ? `(${Number(t.lowest_bid).toLocaleString('tr-TR')} ${t.currency})` : ''}</td>
              <td>
                <button class="btn btn-sm btn-outline-danger" onclick="window.saDeleteItem('tender', '${t.id}')"><i class="bi bi-trash"></i> Sil</button>
              </td>
            </tr>
          `).join('') || '<tr><td colspan="6" class="text-center py-3">Aktif ihale bulunmuyor.</td></tr>';

          // Render Posts
          const pstBody = document.getElementById('saPostsTable');
          pstBody.innerHTML = (data.posts || []).map(p => `
            <tr>
              <td><strong>${p.author_name}</strong><div class="text-muted">${p.company_name || ''}</div></td>
              <td>${p.content}</td>
              <td>${p.likes_count || 0}</td>
              <td>${new Date(p.created_at).toLocaleDateString('tr-TR')}</td>
              <td>
                <button class="btn btn-sm btn-outline-danger" onclick="window.saDeleteItem('post', '${p.id}')"><i class="bi bi-trash"></i> Sil</button>
              </td>
            </tr>
          `).join('') || '<tr><td colspan="5" class="text-center py-3">Paylaşım bulunmuyor.</td></tr>';

          // Render Grant Applications
          const grBody = document.getElementById('saGrantsTable');
          if (grBody) {
            const stepOptions = [
              'Ön Analiz & Evrak Hazırlığı',
              'Resmi Kayıt (DYS / PRODİS / PIC)',
              'Proje Dosyası Yazılıyor',
              'Başvuru Tamamlandı / Onay Bekliyor',
              'Onaylandı / Hibe Kullanımda'
            ];
            grBody.innerHTML = (data.grant_applications || []).map(g => {
              const curStep = g.current_step || g.status_step || 'Ön Analiz & Evrak Hazırlığı';
              return `
                <tr>
                  <td class="fw-bold text-danger font-monospace">${g.application_no || g.id}</td>
                  <td>
                    <div class="fw-bold">${g.company_name}</div>
                    <div class="text-muted" style="font-size:0.75rem;">${g.contact_name || g.contact_person || ''} ${g.contact_phone ? '• ' + g.contact_phone : ''}</div>
                  </td>
                  <td>
                    <div class="fw-bold">${g.program_title}</div>
                    <span class="badge bg-dark-subtle text-body border">${g.provider || g.institution || ''}</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-1">%${g.match_score || 95} Uyum</span>
                  </td>
                  <td>
                    <div class="fw-semibold">${g.project_title || '-'}</div>
                    <div class="text-muted text-truncate" style="max-width:260px;font-size:0.75rem;" title="${(g.project_notes || g.project_summary || '').replace(/"/g, '&quot;')}">${g.project_notes || g.project_summary || ''}</div>
                  </td>
                  <td>
                    <select class="form-select form-select-sm fw-bold" onchange="window.saUpdateGrantStep('${g.id}', this.value)">
                      ${stepOptions.map(st => `<option value="${st}" ${curStep === st ? 'selected' : ''}>${st}</option>`).join('')}
                    </select>
                  </td>
                  <td>
                    <button class="btn btn-sm btn-outline-danger" onclick="window.saDeleteItem('grant_app', '${g.id}')" title="Sil"><i class="bi bi-trash"></i></button>
                  </td>
                </tr>
              `;
            }).join('') || '<tr><td colspan="6" class="text-center py-3">Henüz hibe/fon başvurusu bulunmuyor.</td></tr>';
          }

          // Render 6. Grant Programs Pool (Gün Bazlı Tarih & Çağrı Yönetimi)
          grantProgramsCache = data.grant_programs || [];
          const gpBody = document.getElementById('saGrantProgramsTable');
          if (gpBody) {
            gpBody.innerHTML = grantProgramsCache.map((gp) => `
              <tr>
                <td>
                  <div class="fw-bold">${gp.title}</div>
                  <small class="text-danger font-monospace">${gp.code}</small>
                </td>
                <td>
                  <div>${gp.provider}</div>
                  <span class="badge bg-secondary">${gp.scope}</span>
                </td>
                <td>
                  <input type="text" class="form-control form-control-sm mb-1" id="gprate_${gp.id}" value="${gp.grant_rate || ''}" />
                  <input type="text" class="form-control form-control-sm" id="gpmax_${gp.id}" value="${gp.max_amount || ''}" />
                </td>
                <td>
                  <input type="date" class="form-control form-control-sm" id="gpdate_${gp.id}" value="${gp.deadline_date || ''}" />
                  <small class="text-muted">Boş = Sürekli Açık</small>
                </td>
                <td>
                  <select class="form-select form-select-sm" id="gpstatus_${gp.id}">
                    <option value="open" ${gp.call_status === 'open' ? 'selected' : ''}>🟢 Başvuruya Açık</option>
                    <option value="closing_soon" ${gp.call_status === 'closing_soon' ? 'selected' : ''}>⏳ Son Günler (Acil)</option>
                    <option value="closed" ${gp.call_status === 'closed' ? 'selected' : ''}>⛔ Çağrı Kapandı</option>
                  </select>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-success fw-bold" onclick="window.saSaveGrantProgram('${gp.id}')">Kaydet</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="window.saDeleteItem('grant_program', '${gp.id}')"><i class="bi bi-trash"></i></button>
                  </div>
                </td>
              </tr>
            `).join('') || '<tr><td colspan="6" class="text-center py-3">Program bulunamadı.</td></tr>';
          }

          // Render 7. Career Jobs
          const jbBody = document.getElementById('saJobsTable');
          if (jbBody) {
            jbBody.innerHTML = (data.jobs || []).map((j) => `
              <tr>
                <td class="fw-bold text-primary tabular-nums">#${j.job_no}</td>
                <td>
                  <div class="fw-bold">${j.title}</div>
                  <small class="text-muted">${j.department} • ${j.work_mode}</small>
                </td>
                <td>${j.company_name}</td>
                <td class="tabular-nums"><strong>${j.salary_range}</strong><div class="text-muted">${j.city}</div></td>
                <td><span class="badge bg-success-subtle text-success">${j.subsidy_note || '-'}</span></td>
                <td>
                  <button class="btn btn-sm btn-outline-danger" onclick="window.saDeleteItem('job', '${j.id}')"><i class="bi bi-trash"></i> Sil</button>
                </td>
              </tr>
            `).join('') || '<tr><td colspan="6" class="text-center py-3">İş ilanı bulunmuyor.</td></tr>';
          }

          // Render 8. Career Talents
          const tlBody = document.getElementById('saTalentsTable');
          if (tlBody) {
            tlBody.innerHTML = (data.talents || []).map((t) => `
              <tr>
                <td>
                  <div class="fw-bold">${t.full_name}</div>
                  <small class="text-muted">${t.masked_name || ''} • ${t.phone || ''}</small>
                </td>
                <td>
                  <div class="fw-semibold">${t.headline}</div>
                  <small class="text-primary">${t.department}</small>
                </td>
                <td>${t.experience_years} Yıl • ${t.city}</td>
                <td><span class="badge bg-success-subtle text-success">${t.subsidy_badge || '-'}</span></td>
                <td>
                  <button class="btn btn-sm ${t.is_verified_skill ? 'btn-success' : 'btn-outline-secondary'}" onclick="window.saToggleTalentVerify('${t.id}', ${t.is_verified_skill ? 0 : 1})">
                    ${t.is_verified_skill ? '✓ Doğrulanmış' : 'Onayla'}
                  </button>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-danger" onclick="window.saDeleteItem('talent', '${t.id}')"><i class="bi bi-trash"></i></button>
                </td>
              </tr>
            `).join('') || '<tr><td colspan="6" class="text-center py-3">Aday profili bulunmuyor.</td></tr>';
          }
        } catch (_) {}
      }

      window.saSaveGrantProgram = async function (progId) {
        const gp = grantProgramsCache.find((x) => x.id === progId);
        if (!gp) return;
        const grant_rate = document.getElementById(`gprate_${progId}`).value;
        const max_amount = document.getElementById(`gpmax_${progId}`).value;
        const deadline_date = document.getElementById(`gpdate_${progId}`).value;
        const call_status = document.getElementById(`gpstatus_${progId}`).value;

        const res = await fetch(`${API_URL}/api/superadmin/grant-program`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ...gp,
            grant_rate,
            max_amount,
            deadline_date,
            call_status
          })
        });
        const out = await res.json();
        if (out.success) {
          notify('✓ Program çağrı takvimi ve limitleri güncellendi!');
          loadOverview();
        }
      };

      document.getElementById('saAddGrantProgramForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          code: document.getElementById('sapCode').value,
          title: document.getElementById('sapTitle').value,
          provider: document.getElementById('sapProvider').value,
          scope: document.getElementById('sapScope').value,
          grant_rate: document.getElementById('sapRate').value,
          max_amount: document.getElementById('sapMaxAmount').value,
          deadline_date: document.getElementById('sapDeadlineDate').value,
          call_status: document.getElementById('sapDeadlineDate').value ? 'closing_soon' : 'open',
          description: 'SuperAdmin tarafından eklenen güncel teşvik/hibe çağrısı.'
        };
        const res = await fetch(`${API_URL}/api/superadmin/grant-program`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const out = await res.json();
        if (out.success) {
          e.target.reset();
          notify('✓ Yeni hibe/fon programı havuza eklendi!');
          loadOverview();
        }
      });

      window.saToggleTalentVerify = async function (id, is_verified_skill) {
        await fetch(`${API_URL}/api/superadmin/career-toggle`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'talent', id, is_verified_skill })
        });
        notify('✓ Aday yetenek doğrulama durumu güncellendi!');
        loadOverview();
      };

      window.saUpdateGrantStep = async function (appId, current_step) {
        const res = await fetch(`${API_URL}/api/grants/application/${appId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ current_step })
        });
        const out = await res.json();
        if (out.success) {
          notify('✓ Başvuru aşaması güncellendi: ' + current_step);
          loadOverview();
        }
      };

      window.saSaveCompany = async function (compId) {
        const trust_level = document.getElementById(`trust_${compId}`).value;
        const membership_tier = document.getElementById(`tier_${compId}`).value;
        const match_credits = document.getElementById(`mcred_${compId}`).value;
        const tender_credits = document.getElementById(`tcred_${compId}`).value;

        const res = await fetch(`${API_URL}/api/superadmin/company-update`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ company_id: compId, trust_level, membership_tier, match_credits, tender_credits })
        });
        const out = await res.json();
        if (out.success) {
          notify('✓ İşletme rozeti, paketi ve kredileri güncellendi!');
          loadOverview();
        }
      };

      window.saToggleListing = async function (listingId, is_vitrin, is_urgent) {
        await fetch(`${API_URL}/api/superadmin/listing-toggle`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ listing_id: listingId, is_vitrin, is_urgent })
        });
        notify('✓ İlan vitrin/acil durumu güncellendi!');
        loadOverview();
      };

      window.saDeleteItem = async function (type, id) {
        if (!confirm('Bu kaydı silmek istediğinize emin misiniz?')) return;
        await fetch(`${API_URL}/api/superadmin/delete/${type}/${id}`, { method: 'DELETE' });
        notify('✓ Kayıt silindi.', 'warning');
        loadOverview();
      };

      function checkSuperAdminGate() {
        const wall = document.getElementById('saLoginWall');
        const dash = document.getElementById('saProtectedDashboard');
        let unlocked = false;
        try {
          const isUnlockedSession = sessionStorage.getItem('mw_sa_unlocked') === '1';
          const user = JSON.parse(localStorage.getItem('mw_user') || 'null');
          if (isUnlockedSession && user && user.role === 'superadmin') {
            unlocked = true;
          }
        } catch (_) {}

        if (unlocked) {
          if (wall) wall.style.display = 'none';
          if (dash) dash.style.display = 'block';
          loadOverview();
        } else {
          if (wall) wall.style.display = 'block';
          if (dash) dash.style.display = 'none';
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        checkSuperAdminGate();

        const loginForm = document.getElementById('saLoginForm');
        if (loginForm) {
          loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('saLoginEmail').value.trim();
            const password = document.getElementById('saLoginPassword').value.trim();
            const errBox = document.getElementById('saLoginErrorBox');
            const submitBtn = document.getElementById('saLoginSubmitBtn');
            if (errBox) errBox.style.display = 'none';
            if (submitBtn) submitBtn.disabled = true;

            try {
              const res = await fetch(`${API_URL}/api/auth/login`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
              });
              const out = await res.json();
              if (out.success && out.user && out.user.role === 'superadmin') {
                localStorage.setItem('mw_user', JSON.stringify(out.user));
                localStorage.setItem('mw_token', out.token || '');
                sessionStorage.setItem('mw_sa_unlocked', '1');
                checkSuperAdminGate();
              } else {
                if (errBox) {
                  errBox.style.display = 'block';
                  errBox.textContent = out.user && out.user.role !== 'superadmin'
                    ? 'Bu hesap SuperAdmin yetkisine sahip değildir!'
                    : (out.message || 'Yönetici e-posta veya şifresi hatalı!');
                }
              }
            } catch (_) {
              if (errBox) {
                errBox.style.display = 'block';
                errBox.textContent = 'Sunucu bağlantı hatası oluştu.';
              }
            } finally {
              if (submitBtn) submitBtn.disabled = false;
            }
          });
        }

        document.getElementById('saRefreshBtn')?.addEventListener('click', loadOverview);
        document.getElementById('saLockBtn')?.addEventListener('click', () => {
          sessionStorage.removeItem('mw_sa_unlocked');
          checkSuperAdminGate();
        });
      });
    })();
  </script>
</BaseLayout>
