---
import BaseLayout from '../layouts/BaseLayout.astro';

const CITIES = [
  'İstanbul', 'Ankara', 'İzmir', 'Bursa', 'Kocaeli', 'Antalya', 'Konya',
  'Gaziantep', 'Adana', 'Kayseri', 'Mersin', 'Eskişehir', 'Sakarya', 'Manisa', 'Denizli'
];
---

<BaseLayout
  title="MeetWork İlan Pazarı | Emlak, Vasıta (Binek/Ticari), Sanayi Makinesi & 2. El"
  description="Doğrulanmış MeetWork üyelerinden satılık ve kiralık daire, dükkan, fabrika, binek otomobil, ticari araç, 2. el sanayi makinesi ve seri sonu fırsat ilanları."
>
  <div class="mw-has-b2b-mobile">
  <div class="mw-desktop-screen">
  <!-- Üst Başlık ve İlan Ver Butonu -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <span class="badge bg-danger mb-1">Güvenilir Ticari & Bireysel İlan Pazarı</span>
      <h1 class="h3 fw-bold mb-0">Emlak, Vasıta (Binek & Ticari), Sanayi Makinesi & 2. El İlanlar</h1>
    </div>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-danger fw-bold" data-bs-toggle="modal" data-bs-target="#newListingModal">
        <i class="bi bi-plus-circle-fill me-1"></i> + Ücretsiz İlan Ver
      </button>
    </div>
  </div>

  <!-- İLAN DETAY GÖRÜNÜMÜ (URL'de ?ilan=... varsa açılır) -->
  <div id="mwListingDetailView" class="mb-5" style="display:none;"></div>

  <!-- ANA İLAN FİLTRE VE LİSTE EKRANI -->
  <div class="row g-4" id="mwListingMainLayout">
    <!-- SOL SÜTUN (%28): Kategori Ağacı ve Dinamik Özellik Filtreleri -->
    <div class="col-lg-3">
      <div class="mw-panel-card p-3 shadow-sm sticky-top" style="top: 90px;">
        <h6 class="fw-bold border-bottom pb-2 mb-3">
          <i class="bi bi-funnel-fill text-danger me-1"></i> Kategori & Detaylı Filtre
        </h6>

        <form id="mwListingFilterForm" class="d-flex flex-column gap-3">
          <div>
            <label class="form-label small fw-bold mb-1">Ana Kategori</label>
            <select id="fltCategory" class="form-select form-select-sm">
              <option value="all">Tüm Kategoriler</option>
              <option value="Emlak">🏠 Emlak (Konut, Dükkan, İş Yeri)</option>
              <option value="Vasıta">🚗 Vasıta (Binek Oto & Ticari Araç)</option>
              <option value="Sanayi & Makine">🏭 Sanayi, İş Makinesi & Stok</option>
              <option value="İkinci El & Demirbaş">📦 2. El Eşya & Ofis Demirbaşı</option>
              <option value="Hizmet & Fason">🛠️ Hizmet, Usta & Fason İş</option>
            </select>
          </div>

          <div>
            <label class="form-label small fw-bold mb-1">Alt Kategori</label>
            <select id="fltSubCategory" class="form-select form-select-sm">
              <option value="all">Tümü</option>
              <!-- Emlak -->
              <option value="Daire">Daire (Konut)</option>
              <option value="Villa & Müstakil">Villa & Müstakil Ev</option>
              <option value="Dükkan & Mağaza">Dükkan & Mağaza</option>
              <option value="Ofis & Plaza">Ofis & Plaza Katı</option>
              <option value="Fabrika & Depo">Fabrika, Üretim & Depo</option>
              <option value="Devren İş Yeri">Devren İş Yeri / Bayilik</option>
              <option value="Arsa & Arazi">Arsa & Sanayi Arazisi</option>
              <!-- Vasıta -->
              <option value="Otomobil (Binek)">Otomobil (Binek)</option>
              <option value="SUV & Pickup">Arazi, SUV & Pickup</option>
              <option value="Ticari Araç & Panelvan">Ticari Araç, Panelvan & Kamyonet</option>
              <option value="Kamyon & Çekici (Tır)">Kamyon, Tır & Dorse</option>
              <option value="Filo & Araç Kiralama">Kiralık Binek / Ticari Filo</option>
              <!-- Sanayi -->
              <option value="Üretim & CNC Tezgahı">CNC, Torna & Üretim Makinesi</option>
              <option value="Forklift & İstif">Forklift, Vinç & İstif</option>
              <option value="Seri Sonu & Fırsat Stok">Seri Sonu & Fazla Stok</option>
            </select>
          </div>

          <div>
            <label class="form-label small fw-bold mb-1">İlan Türü (İşlem)</label>
            <select id="fltType" class="form-select form-select-sm">
              <option value="all">Satılık & Kiralık Tümü</option>
              <option value="Satılık">Satılık</option>
              <option value="Kiralık">Kiralık</option>
              <option value="Devren">Devren</option>
            </select>
          </div>

          <div>
            <label class="form-label small fw-bold mb-1">Şehir</label>
            <select id="fltCity" class="form-select form-select-sm">
              <option value="all">Tüm Türkiye</option>
              {CITIES.map(c => <option value={c}>{c}</option>)}
            </select>
          </div>

          <div>
            <label class="form-label small fw-bold mb-1">Fiyat Aralığı (TL)</label>
            <div class="input-group input-group-sm">
              <input type="number" id="fltMinPrice" class="form-control" placeholder="Min" />
              <span class="input-group-text">-</span>
              <input type="number" id="fltMaxPrice" class="form-control" placeholder="Max" />
            </div>
          </div>

          <!-- Emlak / Vasıta Dinamik Ek Filtre Kutusu -->
          <div id="fltDynamicBox" class="p-2 rounded border small" style="background:var(--mw-surface-alt); border-color:var(--mw-border)!important;">
            <div class="fw-bold text-danger mb-1">Kategoriye Özel Özellikler</div>
            <div class="text-muted" style="font-size:0.75rem;">
              Emlak için <strong>m², Oda Sayısı, Bina Yaşı</strong>; Vasıta için <strong>Marka, Model Yılı, Km, Vites/Yakıt</strong> bilgileri ilan tablosunda doğrudan gösterilir.
            </div>
          </div>

          <div>
            <label class="form-label small fw-bold mb-1">Kelime veya İlan No</label>
            <input type="text" id="fltKeyword" class="form-control form-control-sm" placeholder="İlan no veya kelime..." />
          </div>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-danger btn-sm fw-bold">
              <i class="bi bi-search me-1"></i> İlanları Filtrele
            </button>
            <button type="button" id="fltResetBtn" class="btn btn-outline-secondary btn-sm">
              Filtreyi Temizle
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- SAĞ SÜTUN (%72): Vitrin Özeti + Tablo / Kart Görünümlü İlan Listesi -->
    <div class="col-lg-9">
      <!-- Hızlı Kategori Sekmeleri -->
      <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-sm btn-danger mw-quick-cat" data-cat="all">Tümü</button>
        <button type="button" class="btn btn-sm btn-outline-danger mw-quick-cat" data-cat="Emlak">🏠 Emlak (Daire / Dükkan / İş Yeri)</button>
        <button type="button" class="btn btn-sm btn-outline-danger mw-quick-cat" data-cat="Vasıta">🚗 Vasıta (Binek & Ticari Satılık/Kiralık)</button>
        <button type="button" class="btn btn-sm btn-outline-danger mw-quick-cat" data-cat="Sanayi & Makine">🏭 Sanayi & 2. El Makine</button>
        <button type="button" class="btn btn-sm btn-outline-danger mw-quick-cat" data-cat="İkinci El & Demirbaş">📦 2. El & Fırsat</button>
      </div>

      <div class="mw-panel-card p-3 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
          <div class="fw-bold small">
            Toplam <span id="mwListingCount" class="text-danger">0</span> aktif ilan listeleniyor
          </div>
          <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-danger active" id="viewModeTableBtn">
              <i class="bi bi-table"></i> Liste Görünümü
            </button>
            <button type="button" class="btn btn-outline-danger" id="viewModeGridBtn">
              <i class="bi bi-grid-3x3-gap"></i> Vitrin Görünümü
            </button>
          </div>
        </div>

        <!-- Tablo Görünümü -->
        <div class="table-responsive" id="mwListingsTableWrapper">
          <table class="table table-hover align-middle mb-0 small">
            <thead>
              <tr class="text-muted">
                <th>İlan No / Tür</th>
                <th>İlan Başlığı & Teknik Özellikler</th>
                <th>Kategori</th>
                <th>Fiyat</th>
                <th>İl / İlçe</th>
                <th>Satıcı & Güven</th>
                <th>İşlem</th>
              </tr>
            </thead>
            <tbody id="mwListingsTableBody">
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">İlanlar yükleniyor...</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Vitrin (Grid) Görünümü -->
        <div class="row g-3" id="mwListingsGridWrapper" style="display:none;"></div>
      </div>
    </div>
  </div>
  </div>

  <!-- MOBİL & TABLET SERİ SONU STOK & 2. EL MAKİNE / ARAÇ VİTRİNİ EKRANI (Screen 8) -->
  <div class="mw-b2b-mobile-screen mw-b2b-scope">
    <div class="flex flex-col w-full">
      <!-- Dynamic Gradient Accent & Title Section -->
      <div class="relative px-margin pt-space-md pb-space-lg bg-gradient-to-b from-surface-card to-surface-bg shadow-sm">
        <div class="flex items-center justify-between gap-space-sm mb-space-xs">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-cherry-vibrant/10 text-cherry-vibrant">
            <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">warehouse</span>
            <span class="font-label-sm text-label-sm uppercase tracking-wider">Spot B2B Tedarik Borsası</span>
          </div>
          <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-trust-emerald/10 text-trust-emerald">
            <span class="w-1.5 h-1.5 rounded-full bg-trust-emerald animate-ping"></span>
            <span class="font-label-sm text-label-sm">ERP Senkronize</span>
          </div>
        </div>
        <div class="flex items-baseline justify-between">
          <h1 class="font-headline-xl-mobile text-headline-xl-mobile text-navy-deep tracking-tight">
            Seri Sonu Stok &amp; Endüstriyel Pazar
          </h1>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
          Atıl envanteri likiditeye dönüştürün; ekspertiz onaylı 2. el makineler ve ihracat fazlası spot hammadde fırsatları.
        </p>
        <!-- Quick Stats Bar -->
        <div class="grid grid-cols-3 gap-2 mt-space-md p-space-sm rounded-xl bg-surface-container-low">
          <div class="flex flex-col items-center text-center">
            <span class="font-metric-number text-metric-number text-navy-deep">1.480+</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">Aktif Spot İlan</span>
          </div>
          <div class="flex flex-col items-center text-center">
            <span class="font-metric-number text-metric-number text-trust-emerald">%42</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">Ort. Maliyet Avantajı</span>
          </div>
          <div class="flex flex-col items-center text-center">
            <span class="font-metric-number text-metric-number text-cherry-vibrant">24 Sa</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">Hemen Teslimat</span>
          </div>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="px-margin -mt-2 mb-space-md overflow-x-auto no-scrollbar py-2">
        <div class="flex items-center gap-2 min-w-max" id="categoryFilterContainer">
          <button class="category-pill active flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-navy-deep text-on-primary shadow-sm font-label-md text-label-md transition-all active:scale-95" data-category="all" type="button">
            <span>Tümü</span>
            <span class="px-1.5 py-0.2 rounded-full bg-surface-card/20 text-[10px]">1.482</span>
          </button>
          <button class="category-pill flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-card text-on-surface shadow-sm font-label-md text-label-md transition-all active:scale-95" data-category="raw-materials" type="button">
            <span class="material-symbols-outlined text-[16px] text-cherry-vibrant">layers</span>
            <span>Seri Sonu Hammadde/Stok</span>
          </button>
          <button class="category-pill flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-card text-on-surface shadow-sm font-label-md text-label-md transition-all active:scale-95" data-category="machinery" type="button">
            <span class="material-symbols-outlined text-[16px] text-navy-deep">precision_manufacturing</span>
            <span>2. El Makine &amp; Ekipman</span>
          </button>
          <button class="category-pill flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-surface-card text-on-surface shadow-sm font-label-md text-label-md transition-all active:scale-95" data-category="vehicles" type="button">
            <span class="material-symbols-outlined text-[16px] text-on-surface-variant">local_shipping</span>
            <span>Ticari Araç</span>
          </button>
        </div>
      </div>

      <!-- Listings Stream -->
      <div class="px-margin flex flex-col gap-space-lg pb-space-lg">
        <!-- Tekil İlan Detay Görünümü (Mobil/Tablet ?ilan=...) -->
        <div id="mwMobListingDetailView" style="display:none;"></div>
        <!-- Canlı D1 İlanları (Mobil/Tablet Senkron) -->
        <div id="mwMobileLiveListingsList" class="flex flex-col gap-space-lg"></div>
        <!-- Card 1: 2. El CNC Dik İşleme Merkezi -->
        <article class="relative flex flex-col rounded-2xl bg-surface-card shadow-md overflow-hidden transition-all duration-300 hover:shadow-xl" data-cat-item="machinery">
          <div class="relative w-full h-56 bg-surface-container overflow-hidden">
            <img alt="2021 Model CNC Dik İşleme Merkezi" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA_iOQr6D1yUmPuDyW1pflJqoyhrKBLAz46o9u2KikQ1DmESbp3yEr5tpSnkpIekh1m9ooSWDfhTXnE3PYVEyjD6k4jdWOYpGxGbgvveCnmmbkbl8GuWay-uuSQ4xvbMWMwPJPfuJNIa-Ir9gDfQJOc03zY3yNcoa4ZucWHcgR1k1-74i0mJzAxON_lWVdNp633VaU8zlbcxQXQZ04o3tnZAFw7kPdiFI4Si4oksw"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-deep/80 via-transparent to-black/30"></div>
            <div class="absolute top-3 left-3 right-3 flex items-center justify-between">
              <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-navy-deep/90 text-on-primary backdrop-blur-md">
                <span class="material-symbols-outlined text-[14px] text-gold-badge" style="font-variation-settings: 'FILL' 1;">verified</span>
                <span class="font-label-sm text-label-sm font-bold">2. El Makine</span>
              </div>
              <button aria-label="Favorilere ekle" class="favorite-btn w-9 h-9 flex items-center justify-center rounded-full bg-surface-card/85 text-navy-deep shadow backdrop-blur-md active:scale-90 transition-transform" type="button">
                <span class="material-symbols-outlined text-[20px]">bookmark</span>
              </button>
            </div>
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-on-primary">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1 px-2 py-0.5 rounded bg-surface-card/20 backdrop-blur-sm">
                  <span class="material-symbols-outlined text-[13px]">timer</span>
                  <span class="font-label-sm text-label-sm">4.200 Çalışma Saati</span>
                </div>
                <div class="flex items-center gap-1 px-2 py-0.5 rounded bg-trust-emerald/80 text-on-primary backdrop-blur-sm">
                  <span class="material-symbols-outlined text-[13px]">check_circle</span>
                  <span class="font-label-sm text-label-sm font-bold">Hemen Teslim</span>
                </div>
              </div>
            </div>
          </div>

          <div class="p-space-md flex flex-col gap-3">
            <div class="flex flex-col gap-1">
              <div class="flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm">
                <span>İlan No: #TR-CNC-9428</span>
                <span>•</span>
                <span>Güncellendi: 2 saat önce</span>
              </div>
              <h2 class="font-headline-sm text-headline-sm text-navy-deep line-clamp-2">
                2021 Model CNC Dik İşleme Merkezi - 4 Eksen
              </h2>
            </div>

            <div class="flex items-center justify-between p-2.5 rounded-xl bg-surface-container-low">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-10 h-10 rounded-lg bg-surface-card flex items-center justify-center text-navy-deep font-bold font-headline-sm shadow-sm shrink-0">
                  EH
                </div>
                <div class="flex flex-col min-w-0">
                  <div class="flex items-center gap-1">
                    <span class="font-label-lg text-label-lg text-navy-deep truncate font-semibold">Ege Hassas Torna Ltd.</span>
                    <span class="material-symbols-outlined text-[15px] text-trust-emerald shrink-0" style="font-variation-settings: 'FILL' 1;" title="Onaylı Kurumsal Üye">verified</span>
                  </div>
                  <span class="font-body-sm text-body-sm text-on-surface-variant truncate">İzmir / Çiğli AOSB • Güven Puanı %99</span>
                </div>
              </div>
              <span class="px-2 py-1 rounded bg-trust-emerald/10 text-trust-emerald font-label-sm text-label-sm font-bold shrink-0">
                Onaylı Üye
              </span>
            </div>

            <div class="grid grid-cols-2 gap-2 py-1">
              <div class="flex items-center gap-1.5 p-2 rounded-lg bg-surface-bg">
                <span class="material-symbols-outlined text-[16px] text-navy-deep">receipt_long</span>
                <span class="font-label-sm text-label-sm text-navy-deep font-semibold">Fatura Kesilir (+KDV)</span>
              </div>
              <div class="flex items-center gap-1.5 p-2 rounded-lg bg-surface-bg">
                <span class="material-symbols-outlined text-[16px] text-trust-emerald">assignment_turned_in</span>
                <span class="font-label-sm text-label-sm text-navy-deep font-semibold">Ekspertiz Raporu Var</span>
              </div>
            </div>

            <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">
              Yetkili servis bakımlı, 12.000 RPM fener mili, BT40 takım tutucu magazin ve talaş konveyörü ile eksiksiz faal tezgah.
            </p>

            <div class="flex items-end justify-between pt-1">
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant">Peşin / Kurumsal Teminatlı</span>
                <div class="flex items-baseline gap-1">
                  <span class="font-metric-number text-metric-number text-navy-deep">1.350.000</span>
                  <span class="font-headline-sm text-headline-sm text-navy-deep font-bold">₺</span>
                  <span class="font-label-sm text-label-sm text-on-surface-variant font-medium">(KDV Dahil)</span>
                </div>
              </div>
              <div class="flex flex-col items-end">
                <span class="px-2 py-0.5 rounded bg-surface-container-high text-navy-deep font-label-sm text-label-sm font-semibold">
                  Kondisyon: 9.8/10
                </span>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-1">
              <a href="/mesajlar" class="w-full flex items-center justify-center gap-2 py-3.5 px-space-md rounded-xl bg-cherry-vibrant text-on-primary font-label-lg text-label-lg font-bold shadow-md shadow-cherry-vibrant/25 transition-transform active:scale-[0.98] hover:bg-cherry-hover no-underline">
                <span class="material-symbols-outlined text-[20px]">call</span>
                <span>Satıcıyla Görüş / Randevu</span>
              </a>
              <button onclick="window.mwMobMarkSold(this, 'lst_cnc_9428', '2021 Model CNC Dik İşleme Merkezi')" class="w-full flex items-center justify-center gap-1.5 py-3 px-3 rounded-xl bg-surface-container text-navy-deep font-label-md text-label-md font-bold hover:bg-surface-variant transition-colors" type="button">
                <span class="material-symbols-outlined text-[18px] text-trust-emerald">sync_saved_locally</span>
                <span>Satıldı İşaretle (ERP Düş)</span>
              </button>
            </div>
          </div>
        </article>

        <!-- Card 2: Seri Sonu Pamuklu Gabardin Kumaş -->
        <article class="relative flex flex-col rounded-2xl bg-surface-card shadow-md overflow-hidden transition-all duration-300 hover:shadow-xl" data-cat-item="raw-materials">
          <div class="relative w-full h-56 bg-surface-container overflow-hidden">
            <img alt="450 Rulo Pamuklu Gabardin Kumaş" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDwHTvINUk7zTVUtbRjLTQRj4F21s3UDZUaAo8UbDqnuo8cePxx1XzomH8ovyVd4pH1lAWMKp30jdfl9-N8l4khW3dpWZgcOnhinaXVqHld3WGgRyNi9i35DjNVAod-B9NSleEikDdIkT3rW9Jmb6oHkXPIMLB9ER6z5PuyMlApJyNzCSy1_DhHnTBx1HwM9G9NCsv7G954P4Dz_kzNgUhcTPD85Q3IgkULbPX_Pw"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-deep/85 via-transparent to-black/30"></div>
            <div class="absolute top-3 left-3 right-3 flex items-center justify-between">
              <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-bold shadow">
                <span class="material-symbols-outlined text-[14px]">local_offer</span>
                <span class="font-label-sm text-label-sm font-bold">%47 Seri Sonu İndirimi</span>
              </div>
              <button aria-label="Favorilere ekle" class="favorite-btn w-9 h-9 flex items-center justify-center rounded-full bg-surface-card/85 text-navy-deep shadow backdrop-blur-md active:scale-90 transition-transform" type="button">
                <span class="material-symbols-outlined text-[20px]">bookmark</span>
              </button>
            </div>
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-on-primary">
              <div class="flex items-center gap-2">
