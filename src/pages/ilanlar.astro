    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const pills = document.querySelectorAll('.category-pill');
        const cards = document.querySelectorAll('[data-cat-item]');
        pills.forEach(pill => {
          pill.addEventListener('click', () => {
            const cat = pill.getAttribute('data-category');
            pills.forEach(p => {
              p.classList.remove('bg-navy-deep', 'text-on-primary');
              p.classList.add('bg-surface-card', 'text-on-surface');
            });
            pill.classList.remove('bg-surface-card', 'text-on-surface');
            pill.classList.add('bg-navy-deep', 'text-on-primary');
            cards.forEach(c => {
              if (!cat || cat === 'all' || c.getAttribute('data-cat-item') === cat) {
                c.style.display = 'flex';
              } else {
                c.style.display = 'none';
              }
            });
          });
        });

        const favButtons = document.querySelectorAll('.favorite-btn');
        favButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const icon = btn.querySelector('.material-symbols-outlined');
            if (icon) {
              const isFilled = icon.style.fontVariationSettings?.includes("'FILL' 1");
              icon.style.fontVariationSettings = isFilled ? "'FILL' 0" : "'FILL' 1";
              btn.classList.toggle('text-cherry-vibrant');
            }
          });
        });
      });

      window.mwMobMarkSold = async function(btn, listingId, title) {
        if (!btn) return;
        btn.disabled = true;
        btn.innerHTML = '<span>⏳ ERP Senkron...</span>';
        try {
          const res = await fetch('https://meetwork-api.akgcomputer.workers.dev/api/listings/mark-sold', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ listing_id: listingId, title: title, sale_price: 1350000 })
          });
          const out = await res.json();
          btn.innerHTML = '<span>✅ Satıldı & Fatura Taslağı Oluştu</span>';
          btn.classList.add('bg-trust-emerald', 'text-white');
          if (out.message) alert(out.message);
        } catch (_) {
          btn.innerHTML = '<span>✅ ERP Stoktan Düştü</span>';
        }
      };
    </script>
