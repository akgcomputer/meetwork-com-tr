  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.mw-mob-match-crm-btn').forEach((btn) => {
        btn.addEventListener('click', async function () {
          const name = this.getAttribute('data-company-name') || 'MeetWork Eşleşen Firma';
          const vkn = this.getAttribute('data-vkn') || '2720912021';
          const sector = this.getAttribute('data-sector') || 'Sanayi';
          const city = this.getAttribute('data-city') || 'İstanbul';
          this.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">sync</span><span>Aktarılıyor...</span>';
          try {
            await fetch('https://meetwork-api.akgcomputer.workers.dev/api/bridge/crm-cari-sync', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                partner_company_name: name,
                partner_vkn: vkn,
                partner_sector: sector,
                partner_city: city,
                match_source: '2+1 Akıllı Eşleşme (Mobil)',
                create_sample_quote_draft: false
              })
            });
          } catch (_) {}
          this.innerHTML = '<span class="material-symbols-outlined text-[18px] text-trust-emerald">check_circle</span><span>StokPratik CRM & Cariye Aktarıldı!</span>';
        });
      });
    });
  </script>
