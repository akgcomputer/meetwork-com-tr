---
import BaseLayout from '../layouts/BaseLayout.astro';

const SECTORS = [
  'Metal & Çelik Üretim',
  'Makine & Ekipman Üretimi',
  'Otomotiv & Yan Sanayi',
  'İnşaat, Yapı & Gayrimenkul',
  'Tekstil & Konfeksiyon',
  'Gıda, Tarım & İçecek',
  'Plastik, Kauçuk & Ambalaj',
  'Elektrik, Elektronik & Enerji',
  'Teknoloji, Yazılım & E-Ticaret',
  'Lojistik, Nakliyat & Filo',
  'Kimya, Kozmetik & Medikal',
  'Mobilya, Ahşap & Dekorasyon',
  'Toptan & Dış Ticaret (İhracat/İthalat)',
  'Hizmet, Danışmanlık & Mali Müşavirlik'
];
---

<BaseLayout
  title="Akıllı Eşleşme Motoru | MeetWork B2B Networking"
  description="Tanışmak istediğiniz en fazla 5 sektörü seçin; MeetWork algoritması size uygun nokta atışı hedef firmaları ve farklı sektörden sürpriz fırsat firmasını eşleştirsin."
>
  <div class="mw-has-b2b-mobile">
  <div class="mw-desktop-screen">
  <!-- Üst Bilgi Özeti -->
  <div class="mw-panel-card p-4 mb-4 shadow-sm" style="border-left: 5px solid var(--mw-red) !important;">
    <div class="row align-items-center g-3">
      <div class="col-lg-8">
        <span class="badge bg-danger mb-2">MeetWork Özel Algoritması: Hedef + Sürpriz Sektör</span>
        <h1 class="h3 fw-bold mb-1">Akıllı İş Eşleştirme Motoru</h1>
        <div class="text-danger fw-semibold small mb-2">(Zaman Kaybetmeden Doğru Bağlantı)</div>
        <p class="small text-muted mb-0">
          Örneğin <strong>Demir-Çelik Üretimi</strong> yapıyorsunuz; tanışmak istediğiniz <strong>en fazla 5 sektörü</strong> (Makine Üreticisi, Çelik Hammadde, Beyaz Eşya, Oto Kaporta vb.) aşağıdan seçin. Sistem seçtiğiniz sektörlerden <strong>nokta atışı işletmeleri</strong> ve hiç beklemediğiniz bir sinerji yaratmak için <strong>farklı bir sektörden sürpriz işletmeyi</strong> karşınıza çıkarır!
        </p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <div class="p-3 rounded border d-inline-block text-start" style="background:var(--mw-surface-alt);">
          <div class="small text-muted">Eşleşme Durumu</div>
          <div class="h5 fw-bolder text-danger mb-1"><i class="bi bi-check2-circle me-1"></i>Canlı Eşleştirme Aktif</div>
          <a href="/uye-ol-pro" class="small fw-bold text-danger text-decoration-none">PRO Üyelik Avantajlarını İncele →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- 5 HEDEF SEKTÖR SEÇİCİ PANELİ -->
  <div class="mw-panel-card p-4 mb-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h5 class="fw-bold mb-0">
        <i class="bi bi-sliders text-danger me-1"></i> Kimlerle Network Kurmak İstiyorsunuz? (En Fazla 5 Sektör Seçin)
      </h5>
      <span class="badge bg-danger-subtle text-danger" id="mwSelectedSectorBadge">0 / 5 Sektör Seçildi</span>
    </div>

    <div class="row g-2 mb-3">
      {SECTORS.map((sec, i) => (
        <div class="col-md-4 col-sm-6">
          <label class="p-2 rounded border d-flex align-items-center gap-2 w-100" style="cursor:pointer; border-color:var(--mw-border)!important;">
            <input type="checkbox" class="form-check-input mw-match-sec-cb m-0" value={sec} checked={i < 3} />
            <span class="small fw-semibold">{sec}</span>
          </label>
        </div>
      ))}
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2 border-top">
      <small class="text-muted">İlk bağlantılarınız ücretsizdir; tek tıkla eşleşmeyi yenileyebilir ve doğrudan WhatsApp / Kurumsal Profil üzerinden tanışabilirsiniz.</small>
      <button type="button" id="mwRunSmartMatchBtn" class="btn btn-danger fw-bold px-4">
        <i class="bi bi-magic me-1"></i> 2 Hedef + 1 Sürpriz Eşleşmeyi Çalıştır
      </button>
    </div>
  </div>

  <!-- EŞLEŞME SONUÇ KARTLARI (2 HEDEF + 1 SÜRPRİZ) -->
  <div class="mb-5">
    <h5 class="fw-bold mb-3"><i class="bi bi-stars text-danger me-1"></i> Size Özel Eşleşen İşletmeler (2 Hedef + 1 Sürpriz)</h5>
    <div class="row g-4" id="mwSmartMatchResults">
      <div class="col-12 text-center py-4 text-muted">Eşleşmeler hesaplanıyor...</div>
    </div>
  </div>

  <!-- BİLGİLENDİRME BÖLÜMÜ (MEVCUT AKILLI EŞLEŞME ANLATIMI KORUNDU) -->
  <div class="mw-panel-card p-4 shadow-sm">
    <h5 class="fw-bold mb-3">Neden "2 Hedef + 1 Sürpriz" Modeli?</h5>
    <div class="row g-3 small text-muted">
      <div class="col-md-4">
        <div class="p-3 rounded border h-100">
          <strong class="text-danger d-block mb-1">1. Hedef Odaklı Ticaret (2 Firma)</strong>
          Doğrudan tedarikçiniz veya müşteriniz olabilecek, sizin seçtiğiniz 5 sektör içerisinden en yüksek güven skoruna sahip 2 firma listelenir.
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 rounded border h-100">
          <strong class="text-danger d-block mb-1">2. Tesadüfi Ticaret Sinerjisi (1 Sürpriz Firma)</strong>
          Yüz yüze MeetWork toplantılarında masada yanınıza oturan farklı sektördeki bir iş insanından doğan sürpriz ortaklıkları dijitale taşır.
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-3 rounded border h-100">
          <strong class="text-danger d-block mb-1">3. Sıfır Zaman Kaybı</strong>
          Binlerce profil arasında kaybolmak yerine her gün nokta atışı 3 nitelikli karar vericiyle doğrudan tanışırsınız.
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';

      function updateBadgeCount() {
        const count = document.querySelectorAll('.mw-match-sec-cb:checked').length;
        const badge = document.getElementById('mwSelectedSectorBadge');
        if (badge) badge.textContent = `${count} / 5 Sektör Seçildi`;
      }

      async function runMatch() {
        const resultsEl = document.getElementById('mwSmartMatchResults');
        const selected = Array.from(document.querySelectorAll('.mw-match-sec-cb:checked')).map(cb => cb.value);

        let user = null;
        try { user = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}

        const qs = new URLSearchParams();
        if (user && user.company_id) qs.set('company_id', user.company_id);
        if (selected.length > 0) qs.set('targets', selected.join(','));

        try {
          const res = await fetch(`${API_URL}/api/smart-match?${qs.toString()}`);
          const data = await res.json();
          const targets = (data.matches && data.matches.target_firms) || [];
          const surprise = data.matches && data.matches.surprise_firm;

          const cards = [];
          targets.forEach((f, idx) => {
            cards.push({
              ...f,
              cardTitle: `${idx + 1}. Nokta Atışı Hedef Eşleşme`,
              badgeClass: 'bg-danger',
              icon: 'bi-bullseye'
            });
          });
          if (surprise) {
            cards.push({
              ...surprise,
              cardTitle: `3. Sürpriz Sektör Eşleşmesi (Fırsat)`,
              badgeClass: 'bg-dark',
              icon: 'bi-shuffle'
            });
          }

          if (cards.length === 0) {
            resultsEl.innerHTML = `
              <div class="col-12">
                <div class="mw-panel-card p-4 text-center">
                  <h6 class="fw-bold">Eşleşme Havuzu Hazırlanıyor</h6>
                  <p class="small text-muted mb-2">Seçtiğiniz sektörlerde yeni işletmeler eklendikçe burada 2 Hedef + 1 Sürpriz olarak listelenecektir.</p>
                  <a href="/giris?tab=register" class="btn btn-sm btn-danger fw-bold">+ İşletmenizi Havuza Ekleyin</a>
                </div>
              </div>`;
            return;
          }

          window.mwSyncMatchToCrm = async function (name, vkn, sector, city, phone, email, btnEl) {
            if (btnEl) {
              btnEl.disabled = true;
              btnEl.innerHTML = '⏳ StokPratik CRM’e Aktarılıyor...';
            }
            try {
              const r = await fetch(`${API_URL}/api/bridge/crm-cari-sync`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  action: 'match_handshake',
                  matched_company: { company_name: name, vkn: vkn || '2720912021', sector, city, phone, email }
                })
              });
              const d = await r.json();
              if (btnEl) {
                btnEl.className = 'btn btn-success btn-sm fw-bold';
                btnEl.innerHTML = '✅ StokPratik Cari & CRM’e Aktarıldı';
              }
              alert(d.message || 'Firma StokPratik Cari Kartlarınıza ve CRM Fırsatlarınıza aktarıldı.');
            } catch (_) {
              if (btnEl) btnEl.disabled = false;
            }
          };

          resultsEl.innerHTML = cards.map((c, idx) => `
            <div class="col-md-4">
              <div class="mw-panel-card p-4 h-100 d-flex flex-column justify-content-between shadow-sm" style="border-top: 4px solid ${idx === 2 ? '#f59e0b' : 'var(--mw-red)'}!important;">
                <div>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge ${c.badgeClass}"><i class="bi ${c.icon} me-1"></i> ${c.cardTitle}</span>
                    <span class="badge bg-warning-subtle text-dark border border-warning" style="font-size:0.65rem;">💎 ${c.payment_score_tier || 'A+'} Ödeme Disiplini</span>
                  </div>
                  <h5 class="fw-bold mb-1">${c.name}</h5>
                  <div class="small text-danger fw-semibold mb-2">${c.sector} • ${c.city || 'İstanbul'}</div>
                  ${c.match_explanation ? `
                    <div class="p-2 rounded border mb-2 small fw-semibold" style="background: ${idx === 2 ? 'rgba(245, 158, 11, 0.1)' : 'rgba(220, 53, 69, 0.06)'}; border-color: ${idx === 2 ? '#f59e0b' : 'var(--mw-border)'} !important;">
                      ${c.match_explanation}
                    </div>
                  ` : ''}
                  <p class="small text-muted mb-3">
                    ${c.description || 'MeetWork doğrulanmış kurumsal üyesi. Toptan tedarik, fason üretim ve B2B iş birliğine açık işletme.'}
                  </p>
                </div>

                <div class="d-grid gap-2 pt-3 border-top" style="border-color:var(--mw-border)!important;">
                  <button
                    type="button"
                    class="btn btn-outline-success btn-sm fw-bold"
                    onclick="window.mwSyncMatchToCrm('${(c.name || '').replace(/'/g, '')}', '${c.vkn || '2720912021'}', '${(c.sector || '').replace(/'/g, '')}', '${c.city || 'İstanbul'}', '${c.phone || '05412465429'}', '${c.email || 'info@meetwork.com.tr'}', this)"
                  >
                    📇 Onayla & StokPratik CRM / Cari Kartlarıma Aktar
                  </button>
                  <a href="/isletmeler?firma=${encodeURIComponent(c.slug)}" class="btn btn-danger btn-sm fw-bold">
                    <i class="bi bi-person-plus-fill me-1"></i> Ağına Ekle & Toptan Vitrinini İncele
                  </a>
                  <a href="/ihaleler?yeni=1" class="btn btn-outline-secondary btn-sm fw-semibold">
                    <i class="bi bi-hammer me-1"></i> Alım İhalesine Davet Et
                  </a>
                </div>
              </div>
            </div>
          `).join('');
        } catch (_) {}
      }

      document.addEventListener('DOMContentLoaded', () => {
        updateBadgeCount();

        document.querySelectorAll('.mw-match-sec-cb').forEach((cb) => {
          cb.addEventListener('change', () => {
            const checked = document.querySelectorAll('.mw-match-sec-cb:checked');
            if (checked.length > 5) {
              cb.checked = false;
              alert('En fazla 5 hedef sektör seçebilirsiniz!');
            }
            updateBadgeCount();
          });
        });

        document.getElementById('mwRunSmartMatchBtn').addEventListener('click', runMatch);
        runMatch();
      });
    })();
  </script>
  </div><!-- /.mw-desktop-screen -->

  <!-- EKRAN 3: MOBİL & TABLET 2+1 AKILLI EŞLEŞME EKRANI (meetwork_b2b_ekosistemi/3._2_1_ak_ll_e_le_me_ekran) -->
  <div class="mw-b2b-mobile-screen mw-b2b-scope bg-surface-bg text-on-surface antialiased flex flex-col w-full pb-8" style="display:none;">
    <!-- AI Bilgilendirme ve Radar Başlık Alanı -->
    <section class="px-margin pt-space-md pb-space-sm flex flex-col gap-space-xs">
      <div class="flex items-center justify-between">
        <div class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container-high text-navy-deep">
          <span class="material-symbols-outlined text-[14px] text-cherry-vibrant animate-pulse" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-navy-deep">Günün B2B Analitiği</span>
        </div>
        <div class="flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm">
          <span class="material-symbols-outlined text-[15px] text-gold-badge">schedule</span>
          <span>Yenilenme: 14s 28dk</span>
        </div>
      </div>
      <h1 class="font-headline-xl-mobile text-headline-xl-mobile text-navy-deep mt-1 leading-snug">
        Yapay Zeka Destekli Günlük Ticari Eşleşmeleriniz
      </h1>
      <!-- Bilgi Şeridi -->
      <div class="mt-space-xs p-space-sm rounded-xl bg-surface-container-low flex items-start gap-space-sm shadow-sm">
        <div class="w-8 h-8 rounded-lg bg-navy-deep text-on-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[18px]">psychology</span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
          Her gün sektörünüze, cironuza ve alım geçmişinize göre <strong class="text-navy-deep font-semibold">2 doğrudan</strong>, <strong class="text-cherry-vibrant font-semibold">1 çapraz fırsat</strong> eşleşir.
        </p>
      </div>
    </section>

    <!-- Eşleşme Akışı Kapsayıcısı -->
    <div class="px-margin flex flex-col gap-space-md mt-space-sm">
      <!-- KART 1: Doğrudan Alıcı (%96 Uyum) -->
      <article class="bg-surface-card rounded-xl p-space-md shadow-md border border-border-light flex flex-col gap-space-sm relative overflow-hidden transition-all duration-200 hover:shadow-xl">
        <div class="absolute top-0 left-0 bottom-0 w-1.5 bg-trust-emerald"></div>
        <div class="flex items-start justify-between gap-space-sm pl-1">
          <div class="flex items-center gap-space-sm min-w-0">
            <div class="w-12 h-12 rounded-xl bg-surface-container-low overflow-hidden shrink-0 flex items-center justify-center shadow-inner">
              <img class="w-full h-full object-cover" alt="Borusan Tedarik Grubu" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD-Qe18dMavOAnTVEpDg3krEa3-LLryzDgYXiwX2cA4n3c6cVGHQXyK2lzoLRC3wGl-7rXguwbPIAV9hkHB8TOt7UmRk84MgFXS6SK_YsseBn0-rGC8T--_PHVp--mie4SECeSE1-AHGXiGsb-VFzVgfAMTANX_cgdxqhirmW12lehQ5isHoEjjMwXtLVL283rARGG5vGdMWHUlIyjAyrGayqFqYmgvhXF7SfEL0w">
            </div>
            <div class="flex flex-col min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <h2 class="font-headline-sm text-headline-sm text-navy-deep truncate">Borusan Tedarik Grubu</h2>
                <span class="material-symbols-outlined text-[16px] text-trust-emerald" style="font-variation-settings: 'FILL' 1;" title="Doğrulanmış">verified</span>
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant truncate">Alüminyum Enjeksiyon Parça Alıcısı</p>
            </div>
          </div>
          <div class="shrink-0 flex flex-col items-end">
            <div class="px-2.5 py-1 rounded-full bg-tertiary-container text-on-tertiary-container flex items-center gap-1 shadow-sm">
              <span class="material-symbols-outlined text-[14px]">tune</span>
              <span class="font-label-lg text-label-lg font-bold">%96 Uyum</span>
            </div>
            <span class="font-label-sm text-label-sm text-trust-emerald mt-0.5">Doğrudan Alıcı</span>
          </div>
        </div>
        <div class="ml-1 p-space-sm rounded-lg bg-surface-bg flex items-start gap-2">
          <span class="material-symbols-outlined text-[18px] text-trust-emerald shrink-0 mt-0.5">hub</span>
          <p class="font-body-sm text-body-sm text-navy-deep">
            <strong class="font-semibold text-navy-deep">Uyum Nedeni:</strong> Son 30 günde aradıkları NACE 25.50 kodu sizin üretim kapasitenizle %96 örtüşüyor.
          </p>
        </div>
        <div class="ml-1 flex flex-wrap items-center gap-1.5 pt-1">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-surface-container-high text-navy-deep font-label-sm text-label-sm">
            <span>🏅</span> Doğrulanmış Büyük İşletme
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-surface-container-high text-navy-deep font-label-sm text-label-sm">
            <span>💎</span> A+ Ödeme Disiplini
          </span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-surface-variant text-on-surface-variant font-label-sm text-label-sm ml-auto">
            <span class="material-symbols-outlined text-[13px]">location_on</span> Kocaeli / Dilovası
          </span>
        </div>
        <div class="ml-1 flex flex-col sm:flex-row items-center gap-2 pt-space-xs">
          <button class="mw-mob-match-crm-btn w-full sm:flex-1 min-h-[44px] px-space-sm py-2 rounded-xl bg-navy-deep text-on-primary font-label-md text-label-md flex items-center justify-center gap-1.5 shadow-sm active:scale-[0.98] transition-all" data-company-name="Borusan Tedarik Grubu" data-vkn="4100829102" data-sector="Metal & Otomotiv Yan Sanayi" data-city="Kocaeli" type="button">
            <span class="material-symbols-outlined text-[18px]">contact_page</span>
            <span>Onayla &amp; Cari Kartlarıma Aktar</span>
          </button>
          <a href="/isletmeler" class="w-full sm:w-auto min-h-[44px] px-space-md py-2 rounded-xl bg-secondary-container text-on-secondary-container font-label-md text-label-md flex items-center justify-center gap-1.5 shadow-sm active:scale-[0.98] transition-all">
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>Tanışma Mesajı Gönder</span>
          </a>
        </div>
      </article>

      <!-- KART 2: Doğrudan Tedarikçi (%94 Uyum) -->
      <article class="bg-surface-card rounded-xl p-space-md shadow-md border border-border-light flex flex-col gap-space-sm relative overflow-hidden transition-all duration-200 hover:shadow-xl">
        <div class="absolute top-0 left-0 bottom-0 w-1.5 bg-navy-deep"></div>
        <div class="flex items-start justify-between gap-space-sm pl-1">
          <div class="flex items-center gap-space-sm min-w-0">
            <div class="w-12 h-12 rounded-xl bg-surface-container-low overflow-hidden shrink-0 flex items-center justify-center shadow-inner">
              <img class="w-full h-full object-cover" alt="Kardemir Rulo Sac Dağıtım" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDtb-Zghf5nrl9kQMhqSb-J42Y06WFGAc0wK08_edS7TyMku1aQGFsNBfcdNswuVcH4mXbErqUq5_wjhmKoDBPAzXdngn2lhry6GjpiocnnIYInHEmvgMTmtYukedVsxneDIK8CFTp_XZoNw9iK9DAIefZaYEdTERox3L4Br7oXqvFfDeol5Ok1AAlysXjR917G9cSPdkvqfBy8XAHWIvbhSO_OzkcrHyA7wlnA5w">
            </div>
            <div class="flex flex-col min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <h2 class="font-headline-sm text-headline-sm text-navy-deep truncate">Kardemir Rulo Sac Dağıtım</h2>
                <span class="material-symbols-outlined text-[16px] text-trust-emerald" style="font-variation-settings: 'FILL' 1;" title="Doğrulanmış Tedarikçi">verified</span>
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant truncate">Yassı Çelik ve Profil Tedarikçisi</p>
            </div>
          </div>
          <div class="shrink-0 flex flex-col items-end">
            <div class="px-2.5 py-1 rounded-full bg-surface-container-high text-navy-deep flex items-center gap-1 shadow-sm">
              <span class="material-symbols-outlined text-[14px]">tune</span>
              <span class="font-label-lg text-label-lg font-bold">%94 Uyum</span>
            </div>
            <span class="font-label-sm text-label-sm text-on-surface-variant mt-0.5">Doğrudan Tedarikçi</span>
          </div>
        </div>
        <div class="ml-1 p-space-sm rounded-lg bg-surface-bg flex items-start gap-2">
          <span class="material-symbols-outlined text-[18px] text-navy-deep shrink-0 mt-0.5">request_quote</span>
          <p class="font-body-sm text-body-sm text-navy-deep">
            <strong class="font-semibold text-navy-deep">Uyum Nedeni:</strong> Hammadde alım ihalelerinizdeki teknik şartnameleri en rekabetçi fiyatla karşılayan tedarikçi.
          </p>
        </div>
        <div class="ml-1 flex flex-wrap items-center gap-1.5 pt-1">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-surface-container-high text-navy-deep font-label-sm text-label-sm">
            <span>⚡</span> Aynı Gün Stok Teslim
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-surface-container-high text-navy-deep font-label-sm text-label-sm">
            <span>🛡️</span> Sigortalı Sevk
          </span>
