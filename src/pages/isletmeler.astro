            <button class="sector-pill shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-label-md transition-all bg-border-subtle text-navy-deep hover:bg-surface-variant" data-sector="ambalaj" type="button">Tekstil &amp; Ambalaj</button>
            <button class="sector-pill shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-label-md transition-all bg-border-subtle text-navy-deep hover:bg-surface-variant" data-sector="kimya" type="button">Kimya &amp; Plastik</button>
            <button class="sector-pill shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-label-md transition-all bg-border-subtle text-navy-deep hover:bg-surface-variant" data-sector="metal" type="button">Metal &amp; Makine</button>
            <button class="sector-pill shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-label-md transition-all bg-border-subtle text-navy-deep hover:bg-surface-variant" data-sector="gida" type="button">Gıda &amp; Tarım</button>
          </div>
        </div>

        <!-- City Selector & Verified Toggle Bar -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm pt-1">
          <div class="relative">
            <select class="w-full appearance-none bg-surface-bg text-navy-deep font-body-sm text-body-sm px-3.5 py-2.5 rounded-xl outline-none font-medium pr-8 cursor-pointer border border-border-light" id="city-filter">
              <option value="">Tüm Şehirler (Türkiye)</option>
