          <span class="material-symbols-outlined text-[16px]">add_circle</span>
          <span>+ Hikaye Ekle</span>
        </button>
        <button type="button" data-bs-toggle="modal" data-bs-target="#mwCompanyPostJobModal" class="flex items-center gap-1 px-3 py-1.5 rounded-xl bg-trust-emerald text-white font-label-sm text-label-sm font-bold shadow-sm">
          <span class="material-symbols-outlined text-[16px]">work</span>
          <span>+ Personel İlanı Aç</span>
        </button>
        <a href="/qr-kartvizit" class="flex items-center gap-1 px-3 py-1.5 rounded-xl bg-navy-deep text-white font-label-sm text-label-sm font-bold shadow-sm">
          <span class="material-symbols-outlined text-[16px]">qr_code_2</span>
          <span>QR Kartvizit</span>
        </a>
        <a href="/profilim" class="flex items-center gap-1 px-3 py-1.5 rounded-xl bg-surface-card border border-border-light text-navy-deep font-label-sm text-label-sm font-bold shadow-sm">
          <span class="material-symbols-outlined text-[16px]">manage_accounts</span>
          <span>Profilim</span>
        </a>
      </div>
