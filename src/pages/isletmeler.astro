---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Vitrin, Kurumsal İşletmeler & CariNet Mağazaları | MeetWork"
  description="MeetWork üyesi doğrulanmış işletmeler, işletme hikayeleri, kurumsal ilan mağazaları, DepodanDirekt toptan ihracat vitrinleri ve StokPratik CariNet B2B bayi portalları."
>
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <span class="badge bg-danger mb-1">Doğrulanmış Kurumsal İş Ağı & B2B Vitrin</span>
      <h1 class="h3 fw-bold mb-0">İşletme Vitrini & Kurumsal Mağazalar</h1>
    </div>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-outline-danger fw-bold" data-bs-toggle="modal" data-bs-target="#mwCompanyAddStoryModal">
        <i class="bi bi-play-circle-fill me-1"></i> + Hikaye Ekle
      </button>
      <a href="/giris?tab=register" class="btn btn-danger fw-bold">
        <i class="bi bi-building-add me-1"></i> + İşletmeni Ücretsiz Ekle
      </a>
    </div>
  </div>

  <!-- TEKİL İŞLETME PROFİLİ GÖRÜNÜMÜ (URL'de ?firma=... varsa veya seçili işletme için) -->
  <div id="mwCompanyProfileContainer" class="mb-5" style="display:none;"></div>

  <!-- VİTRİN GENEL HİKAYELER BARI (Misafirlerin ve Üyelerin Son Hikayeleri Görebilmesi İçin) -->
  <div class="mw-panel-card p-3 mb-4 shadow-sm" id="mwVitrinGeneralStoriesCard">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="small fw-bold"><i class="bi bi-play-circle-fill text-danger me-1"></i> Son Eklenen İşletme Hikayeleri</span>
      <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-bold" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#mwCompanyAddStoryModal">
        + Hikaye Paylaş
      </button>
    </div>
    <div class="mw-stories-row" id="mwVitrinStoriesRow">
      <div class="mw-story-item" data-bs-toggle="modal" data-bs-target="#mwCompanyAddStoryModal">
        <div class="mw-story-add-ring"><i class="bi bi-plus-lg"></i></div>
        <span class="fw-bold text-truncate w-100 text-center" style="font-size: 0.7rem;">Hikaye Ekle</span>
      </div>
    </div>
  </div>

  <!-- TÜM İŞLETMELER REHBERİ VE FİLTRESİ -->
  <div class="mw-panel-card p-4 shadow-sm mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color:var(--mw-border)!important;">
      <h5 class="fw-bold mb-0"><i class="bi bi-buildings-fill text-danger me-1"></i> Kayıtlı & Doğrulanmış İşletmeler</h5>
      <div class="d-flex gap-2">
        <a href="/akilli-eslesme" class="btn btn-sm btn-outline-danger fw-bold">
          <i class="bi bi-diagram-3-fill me-1"></i> Akıllı Eşleşmeye Git
        </a>
      </div>
    </div>

    <div id="mwCompaniesGrid" class="row g-3">
      <div class="col-12 text-center py-4 text-muted">İşletmeler yükleniyor...</div>
    </div>
  </div>

  <!-- HİKAYE GÖRÜNTÜLEYİCİ (STORY VIEWER) MODALI -->
  <div class="modal fade" id="mwCompanyStoryViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
      <div class="modal-content border-0 overflow-hidden shadow-lg" style="border-radius: 18px;">
        <div id="mwCompStoryModalBody" class="p-4 text-white d-flex flex-column justify-content-between" style="min-height: 460px; background: linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%);">
          <div>
            <div class="progress mb-3" style="height: 3px; background: rgba(255,255,255,0.25);">
              <div class="progress-bar bg-white" style="width: 100%;"></div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-2">
                <div id="mwCompStoryViewAvatar" class="rounded-circle bg-white text-danger fw-black d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: 900;">
                  MW
                </div>
                <div>
                  <div class="fw-bold small text-white" id="mwCompStoryViewCompany">İşletme</div>
                  <small class="text-white-50" style="font-size: 0.72rem;" id="mwCompStoryViewCategory">İş Gündemi</small>
                </div>
              </div>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
          </div>

          <div class="my-4 py-3">
            <span class="badge bg-light text-dark mb-2" id="mwCompStoryViewBadge">Gold Onaylı İşletme</span>
            <h4 class="fw-bold mb-3 text-white" id="mwCompStoryViewTitle">Hikaye Başlığı</h4>
            <p class="mb-0 text-white" style="font-size: 0.95rem; line-height: 1.6; opacity: 0.95;" id="mwCompStoryViewContent"></p>
          </div>

          <div class="d-flex gap-2 pt-3 border-top border-light border-opacity-25">
            <a href="/isletmeler" id="mwCompStoryViewCta" class="btn btn-light text-danger fw-bold w-100">
              İşletme Vitrinini İncele →
            </a>
            <a href="/ihaleler?yeni=1" class="btn btn-outline-light fw-semibold flex-shrink-0">
              Teklif İste
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- İŞLETME HİKAYE EKLEME MODALI -->
  <div class="modal fade" id="mwCompanyAddStoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content mw-panel-card border-danger">
        <div class="modal-header border-bottom" style="border-color:var(--mw-border)!important;">
          <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle-fill text-danger me-1"></i> İşletme Hikayesi Ekle</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>
        <div class="modal-body">
          <form id="mwCompanyAddStoryForm">
            <div class="mb-2">
              <label class="form-label small fw-semibold mb-1">Kategori</label>
              <select id="mwCompStoryCategory" class="form-select form-select-sm">
                <option value="Üretim & Yatırım">🏭 Üretim & Yeni Yatırım</option>
                <option value="Fırsat & Stok">🔥 Fırsat İlanı / Hazır Stok</option>
                <option value="Canlı E-İhale">⚖️ Satın Alma & İhale Duyurusu</option>
                <option value="B2B Etkinlik">☕ B2B Toplantı & İş Birliği</option>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold mb-1">Başlık</label>
              <input type="text" id="mwCompStoryTitle" class="form-control form-control-sm" placeholder="Örn: Yeni İhracat Sevkiyatımız" required />
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold mb-1">Açıklama</label>
              <textarea id="mwCompStoryContent" class="form-control form-control-sm" rows="3" placeholder="İşletmenizden güncel gelişmeyi paylaşın..." required></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-semibold mb-1">Tema</label>
              <select id="mwCompStoryGradient" class="form-select form-select-sm">
                <option value="linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%)">Kırmızı & Siyah (MeetWork Kurumsal)</option>
                <option value="linear-gradient(135deg, #111115 0%, #b45309 50%, #f59e0b 100%)">Gold / Hardal (Gold Vitrin)</option>
                <option value="linear-gradient(135deg, #0f172a 0%, #334155 50%, #64748b 100%)">Gümüş / Antrasit (Kurumsal Silver)</option>
                <option value="linear-gradient(135deg, #052e16 0%, #15803d 100%)">Zümrüt Yeşili (İhracat & Lojistik)</option>
              </select>
            </div>
            <div id="mwCompAddStoryFeedback" class="small mb-2" style="display:none;"></div>
            <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">
              <i class="bi bi-send-fill me-1"></i> Hikayeyi Yayınla
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- İŞLETME SAHİBİNE ÖZEL PERSONEL / DÖNEMSEL UZMAN İLANI AÇMA MODALI -->
  <div class="modal fade" id="mwCompanyPostJobModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content mw-panel-card border-success">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold">
            <i class="bi bi-briefcase-fill text-success me-1"></i> İşletmeniz İçin Personel veya Dönemsel Uzman İlanı Açın
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>
        <div class="modal-body">
          <form id="mwCompanyPostJobForm" class="row g-3">
            <div class="col-md-8">
              <label class="form-label small fw-bold mb-1">Aranan Pozisyon Başlığı *</label>
              <input type="text" id="cpJobTitle" class="form-control form-control-sm" placeholder="Örn: Dış Ticaret & İhracat Uzmanı / CNC Lazer Operatörü / IT Uzmanı" required />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold mb-1">Departman *</label>
              <select id="cpJobDepartment" class="form-select form-select-sm" required>
                <option value="Yazılım, Teknoloji & Ar-Ge">Yazılım, Teknoloji & Ar-Ge</option>
                <option value="Dış Ticaret & İhracat">Dış Ticaret & İhracat</option>
                <option value="Üretim, Mühendislik & Fabrika">Üretim, Mühendislik & Fabrika</option>
                <option value="Finans, Muhasebe & ERP">Finans, Muhasebe & ERP</option>
                <option value="B2B Satış & Satınalma">B2B Satış & Satınalma</option>
                <option value="Lojistik, Depo & Filo">Lojistik, Depo & Filo</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold mb-1">Şehir *</label>
              <input type="text" id="cpJobCity" class="form-control form-control-sm" value="İstanbul" required />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold mb-1">Çalışma Şekli *</label>
              <select id="cpJobWorkMode" class="form-select form-select-sm">
                <option value="Tam Zamanlı / Hibrit">Tam Zamanlı / Hibrit</option>
                <option value="Tam Zamanlı (Fabrika / Saha)">Tam Zamanlı (Fabrika / Saha)</option>
                <option value="Uzaktan (Remote) / Proje Bazlı">⚡ Uzaktan (Remote) / Proje Bazlı</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold mb-1">Teklif Edilen Maaş / Hakediş *</label>
              <input type="text" id="cpJobSalary" class="form-control form-control-sm" placeholder="Örn: 55.000 TL – 75.000 TL + Prim" required />
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold mb-1">Aranan Yetenek Etiketleri (Virgülle Ayırın) *</label>
              <input type="text" id="cpJobSkills" class="form-control form-control-sm" placeholder="Örn: StokPratik ERP, İngilizce C1, İhracat Operasyonu, SolidWorks" required />
            </div>
            <div class="col-12">
              <label class="form-label small fw-bold mb-1">Pozisyon Açıklaması & Yan Haklar *</label>
              <textarea id="cpJobDesc" class="form-control form-control-sm" rows="3" placeholder="İş tanımını, çalışma koşullarını ve yan hakları kısaca yazınız..." required></textarea>
            </div>
            <div id="cpJobFeedback" class="col-12 small" style="display:none;"></div>
            <div class="col-12">
              <button type="submit" class="btn btn-success w-100 fw-bold">
                <i class="bi bi-check2-circle me-1"></i> İş İlanını İşletme Profilimde ve Kariyer Vitrininde Yayınla
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- 📱 QR DİJİTAL KARTVİZİT & TANIŞMA MODALI (KURAL 5: Otomatik İrsaliye Kesmez, Onaylı CRM Aktarımı Yapar) -->
  <div class="modal fade" id="mwQrCardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content mw-panel-card border-danger">
        <div class="modal-header border-bottom">
          <h6 class="modal-title fw-bold">
            <i class="bi bi-qr-code-scan text-danger me-1"></i> Dijital Kurumsal Kartvizit & Tanışma Masası
          </h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>
        <div class="modal-body text-center">
          <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-4 border border-danger mb-3" style="background:#fff;">
            <i class="bi bi-qr-code text-dark" style="font-size: 5.5rem; line-height: 1;"></i>
          </div>
          <h5 class="fw-bold mb-1" id="mwQrModalCompName">İşletme Adı</h5>
          <div class="small text-muted mb-2" id="mwQrModalCompSector">Sektör • Şehir</div>
          <div class="d-flex justify-content-center flex-wrap gap-1 mb-3">
            <span class="badge bg-warning text-dark">💎 A+ Ödeme Disiplini</span>
            <span class="badge bg-success">🏅 GİB e-Fatura Doğrulandı</span>
          </div>
          <div class="p-2 rounded border text-start small mb-3" style="background: var(--mw-surface-alt);">
            <div><strong>VKN / Kurumsal Kimlik:</strong> <span id="mwQrModalCompVkn">2720912021</span></div>
            <div><strong>Telefon:</strong> <span id="mwQrModalCompPhone">0541 246 54 29</span></div>
            <div><strong>E-Posta:</strong> <span id="mwQrModalCompEmail">yonetim@meetwork.com.tr</span></div>
          </div>
          <div class="alert alert-light border small text-start py-2 mb-3" style="font-size:0.75rem;">
            <i class="bi bi-shield-check text-success me-1"></i> <strong>Güvenli Tanışma Kuralı:</strong> QR Kartvizit açıldığında otomatik irsaliye veya fatura kesilmez. Yalnızca aşağıdaki onayınızla rehberinize eklenir.
          </div>
          <div id="mwQrModalFeedback" class="small fw-bold mb-2" style="display:none;"></div>
          <div class="d-grid gap-2">
            <button type="button" class="btn btn-danger btn-sm fw-bold" id="mwQrSaveCrmBtn">
              📇 Rehberime & StokPratik CRM / Cari Kartlarıma Kaydet
            </button>
            <button type="button" class="btn btn-outline-dark btn-sm fw-semibold" id="mwQrSaveWithQuoteBtn">
              📝 İsteğe Bağlı: StokPratik’te Numune / Teklif Taslağı Hazırla
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ ONAYLI İŞE ALIM -> STOKPRATİK PDKS PERSONEL KARTI AKTARIM MODALI (KURAL 3) -->
  <div class="modal fade" id="mwHireToPdksModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content mw-panel-card border-success">
        <div class="modal-header border-bottom">
          <h6 class="modal-title fw-bold">
            <i class="bi bi-person-check-fill text-success me-1"></i> Adayı İşe Aldık → StokPratik PDKS’ye Aktar
          </h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-success py-2 small mb-3">
            <strong>Kullanıcı Onaylı Aktarım:</strong> Mülakat süreci tamamlanan aday, yalnızca aşağıdaki bilgileri onayladığınızda StokPratik <code>Personel & Puantaj (PDKS)</code> modülünüze aktarılır.
          </div>
          <form id="mwHireToPdksForm">
            <div class="mb-2">
              <label class="form-label small fw-bold mb-1">İşe Alınan Aday</label>
              <input type="text" id="pdksCandName" class="form-control form-control-sm fw-bold" readonly />
            </div>
            <div class="row g-2 mb-2">
              <div class="col-6">
                <label class="form-label small fw-bold mb-1">Görev / Pozisyon</label>
                <input type="text" id="pdksCandPosition" class="form-control form-control-sm" required />
              </div>
              <div class="col-6">
                <label class="form-label small fw-bold mb-1">Şube / Fabrika</label>
                <input type="text" id="pdksCandBranch" class="form-control form-control-sm" value="Merkez Kampüs / Fabrika" required />
              </div>
            </div>
            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label small fw-bold mb-1">İşe Başlama Tarihi *</label>
                <input type="date" id="pdksStartDate" class="form-control form-control-sm" value="2026-11-01" required />
              </div>
              <div class="col-6">
                <label class="form-label small fw-bold mb-1">Anlaşılan Net Maaş (TL) *</label>
                <input type="number" id="pdksAgreedSalary" class="form-control form-control-sm" value="65000" required />
              </div>
            </div>
            <div id="pdksTransferFeedback" class="small fw-bold mb-2" style="display:none;"></div>
            <button type="submit" class="btn btn-success btn-sm w-100 fw-bold">
              ✅ Onayla & StokPratik PDKS Personel Kartını Aç
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';
      let currentActiveCompany = null;

      function getTrustBadge(level, paymentTier) {
        const payBadge = `<span class="badge bg-warning-subtle text-dark border border-warning ms-1" title="Ticari sırlar gizli tutularak StokPratik & DepodanDirekt ödeme disiplini doğrulanmıştır">💎 ${paymentTier || 'A+'} Ödeme Disiplini</span>`;
        if (Number(level) >= 3) return `<span class="mw-trust-badge-3"><i class="bi bi-patch-check-fill"></i> Gold Onaylı</span>${payBadge}`;
        if (Number(level) === 2) return `<span class="mw-trust-badge-2"><i class="bi bi-shield-check"></i> Silver / VKN Onaylı</span>${payBadge}`;
        return `<span class="mw-trust-badge-1"><i class="bi bi-check-circle"></i> Doğrulanmış Üye</span>${payBadge}`;
      }

      window.mwOpenQrCardModal = function (name, sector, city, vkn, phone, email) {
        document.getElementById('mwQrModalCompName').textContent = name || 'MeetWork Üye İşletme';
        document.getElementById('mwQrModalCompSector').textContent = `${sector || 'Sanayi & Ticaret'} • ${city || 'İstanbul'}`;
        document.getElementById('mwQrModalCompVkn').textContent = vkn || '2720912021';
        document.getElementById('mwQrModalCompPhone').textContent = phone || '0541 246 54 29';
        document.getElementById('mwQrModalCompEmail').textContent = email || 'yonetim@meetwork.com.tr';
        const fb = document.getElementById('mwQrModalFeedback');
        if (fb) fb.style.display = 'none';
        window.__qrModalPartner = { company_name: name, sector, city, vkn: vkn || '2720912021', phone, email };
        const modalEl = document.getElementById('mwQrCardModal');
        if (modalEl && window.bootstrap) new window.bootstrap.Modal(modalEl).show();
      };

      window.mwOpenHirePdksModal = function (candName, position) {
        document.getElementById('pdksCandName').value = candName || 'Uzman Aday';
        document.getElementById('pdksCandPosition').value = position || 'B2B Satış & Operasyon Uzmanı';
        const fb = document.getElementById('pdksTransferFeedback');
        if (fb) fb.style.display = 'none';
        const modalEl = document.getElementById('mwHireToPdksModal');
        if (modalEl && window.bootstrap) new window.bootstrap.Modal(modalEl).show();
      };

      function buildStoriesRowHtml(stories) {
        window.__mwCompStoriesList = stories || [];
        const addBtn = `
          <div class="mw-story-item" data-bs-toggle="modal" data-bs-target="#mwCompanyAddStoryModal">
            <div class="mw-story-add-ring"><i class="bi bi-plus-lg"></i></div>
            <span class="fw-bold text-truncate w-100 text-center" style="font-size: 0.7rem;">Hikaye Ekle</span>
          </div>
        `;
        const circles = (stories || []).map((st, idx) => {
          const initials = (st.company_name || 'MW').slice(0, 2).toUpperCase();
          const isSilver = Number(st.trust_level) === 2;
          const bg = st.bg_gradient || 'linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%)';
          return `
            <div class="mw-story-item" onclick="window.mwOpenCompStory(${idx})">
              <div class="mw-story-ring ${isSilver ? 'mw-story-ring-silver' : ''}">
                <div class="mw-story-inner" style="background: ${bg};">${initials}</div>
              </div>
              <span class="fw-semibold text-truncate w-100 text-center" style="font-size: 0.69rem;">${st.title || st.company_name}</span>
            </div>
          `;
        }).join('');
        return addBtn + circles;
      }

      window.mwOpenCompStory = function (idx) {
        const list = window.__mwCompStoriesList || [];
        const st = list[idx];
        if (!st) return;

        document.getElementById('mwCompStoryModalBody').style.background = st.bg_gradient || 'linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%)';
        document.getElementById('mwCompStoryViewAvatar').textContent = (st.company_name || 'MW').slice(0, 2).toUpperCase();
        document.getElementById('mwCompStoryViewCompany').textContent = st.company_name || 'MeetWork İşletmesi';
        document.getElementById('mwCompStoryViewCategory').textContent = st.category || 'İş Gündemi';
        document.getElementById('mwCompStoryViewBadge').textContent = Number(st.trust_level) >= 3 ? '★ Gold Onaylı İşletme' : '✓ Silver Onaylı İşletme';
        document.getElementById('mwCompStoryViewTitle').textContent = st.title || '';
        document.getElementById('mwCompStoryViewContent').textContent = st.content || '';
        const cta = document.getElementById('mwCompStoryViewCta');
        if (cta) {
          cta.textContent = (st.cta_label || 'İşletme Vitrinini İncele') + ' →';
          cta.setAttribute('href', st.cta_url || (st.company_slug ? `/isletmeler?firma=${st.company_slug}` : '/isletmeler'));
        }

        const modalEl = document.getElementById('mwCompanyStoryViewerModal');
        if (modalEl && window.bootstrap) {
          const modal = new window.bootstrap.Modal(modalEl);
          modal.show();
        }
      };

      async function loadGeneralStories() {
        const row = document.getElementById('mwVitrinStoriesRow');
