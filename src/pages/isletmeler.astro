---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Vitrin, Kurumsal İşletmeler & CariNet Mağazaları | MeetWork"
  description="MeetWork üyesi doğrulanmış işletmeler, işletme hikayeleri, kurumsal ilan mağazaları, DepodanDirekt toptan ihracat vitrinleri ve StokPratik CariNet B2B bayi portalları."
>
  <div class="mw-has-b2b-mobile">
  <div class="mw-desktop-screen">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <span class="badge bg-danger mb-1">Doğrulanmış Kurumsal İş Ağı & B2B Vitrin</span>
      <h1 class="h3 fw-bold mb-0">İşletme Vitrini & Kurumsal Mağazalar</h1>
    </div>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-outline-danger fw-bold" data-bs-toggle="modal" data-bs-target="#mwCompanyAddStoryModal">
        <i class="bi bi-play-circle-fill me-1"></i> + Hikaye Ekle
      </button>
      <a href="/giris?tab=register" class="btn btn-danger fw-bold">
        <i class="bi bi-building-add me-1"></i> + İşletmeni Ücretsiz Ekle
      </a>
    </div>
  </div>

  <!-- TEKİL İŞLETME PROFİLİ GÖRÜNÜMÜ (URL'de ?firma=... varsa veya seçili işletme için) -->
  <div id="mwCompanyProfileContainer" class="mb-5" style="display:none;"></div>

  <!-- VİTRİN GENEL HİKAYELER BARI (Misafirlerin ve Üyelerin Son Hikayeleri Görebilmesi İçin) -->
  <div class="mw-panel-card p-3 mb-4 shadow-sm" id="mwVitrinGeneralStoriesCard">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="small fw-bold"><i class="bi bi-play-circle-fill text-danger me-1"></i> Son Eklenen İşletme Hikayeleri</span>
      <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-bold" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#mwCompanyAddStoryModal">
        + Hikaye Paylaş
      </button>
    </div>
    <div class="mw-stories-row" id="mwVitrinStoriesRow">
      <div class="mw-story-item" data-bs-toggle="modal" data-bs-target="#mwCompanyAddStoryModal">
        <div class="mw-story-add-ring"><i class="bi bi-plus-lg"></i></div>
        <span class="fw-bold text-truncate w-100 text-center" style="font-size: 0.7rem;">Hikaye Ekle</span>
      </div>
    </div>
  </div>

  <!-- TÜM İŞLETMELER REHBERİ VE FİLTRESİ -->
  <div class="mw-panel-card p-4 shadow-sm mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color:var(--mw-border)!important;">
      <h5 class="fw-bold mb-0"><i class="bi bi-buildings-fill text-danger me-1"></i> Kayıtlı & Doğrulanmış İşletmeler</h5>
      <div class="d-flex gap-2">
        <a href="/akilli-eslesme" class="btn btn-sm btn-outline-danger fw-bold">
          <i class="bi bi-diagram-3-fill me-1"></i> Akıllı Eşleşmeye Git
        </a>
      </div>
    </div>

    <div id="mwCompaniesGrid" class="row g-3">
      <div class="col-12 text-center py-4 text-muted">İşletmeler yükleniyor...</div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';
      let currentActiveCompany = null;

      function getTrustBadge(level, paymentTier) {
        const payBadge = `<span class="badge bg-warning-subtle text-dark border border-warning ms-1" title="Ticari sırlar gizli tutularak StokPratik & DepodanDirekt ödeme disiplini doğrulanmıştır">💎 ${paymentTier || 'A+'} Ödeme Disiplini</span>`;
        if (Number(level) >= 3) return `<span class="mw-trust-badge-3"><i class="bi bi-patch-check-fill"></i> Gold Onaylı</span>${payBadge}`;
        if (Number(level) === 2) return `<span class="mw-trust-badge-2"><i class="bi bi-shield-check"></i> Silver / VKN Onaylı</span>${payBadge}`;
        return `<span class="mw-trust-badge-1"><i class="bi bi-check-circle"></i> Doğrulanmış Üye</span>${payBadge}`;
      }

      window.mwOpenQrCardModal = function (name, sector, city, vkn, phone, email) {
        document.getElementById('mwQrModalCompName').textContent = name || 'MeetWork Üye İşletme';
        document.getElementById('mwQrModalCompSector').textContent = `${sector || 'Sanayi & Ticaret'} • ${city || 'İstanbul'}`;
        document.getElementById('mwQrModalCompVkn').textContent = vkn || '2720912021';
        document.getElementById('mwQrModalCompPhone').textContent = phone || '0541 246 54 29';
        document.getElementById('mwQrModalCompEmail').textContent = email || 'yonetim@meetwork.com.tr';
        const fb = document.getElementById('mwQrModalFeedback');
        if (fb) fb.style.display = 'none';
        window.__qrModalPartner = { company_name: name, sector, city, vkn: vkn || '2720912021', phone, email };
        const modalEl = document.getElementById('mwQrCardModal');
        if (modalEl && window.bootstrap) new window.bootstrap.Modal(modalEl).show();
      };

      window.mwOpenHirePdksModal = function (candName, position) {
        document.getElementById('pdksCandName').value = candName || 'Uzman Aday';
        document.getElementById('pdksCandPosition').value = position || 'B2B Satış & Operasyon Uzmanı';
        const fb = document.getElementById('pdksTransferFeedback');
        if (fb) fb.style.display = 'none';
        const modalEl = document.getElementById('mwHireToPdksModal');
        if (modalEl && window.bootstrap) new window.bootstrap.Modal(modalEl).show();
      };

      function buildStoriesRowHtml(stories) {
        window.__mwCompStoriesList = stories || [];
        const addBtn = `
          <div class="mw-story-item" data-bs-toggle="modal" data-bs-target="#mwCompanyAddStoryModal">
            <div class="mw-story-add-ring"><i class="bi bi-plus-lg"></i></div>
            <span class="fw-bold text-truncate w-100 text-center" style="font-size: 0.7rem;">Hikaye Ekle</span>
          </div>
        `;
        const circles = (stories || []).map((st, idx) => {
          const initials = (st.company_name || 'MW').slice(0, 2).toUpperCase();
          const isSilver = Number(st.trust_level) === 2;
          const bg = st.bg_gradient || 'linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%)';
          return `
            <div class="mw-story-item" onclick="window.mwOpenCompStory(${idx})">
              <div class="mw-story-ring ${isSilver ? 'mw-story-ring-silver' : ''}">
                <div class="mw-story-inner" style="background: ${bg};">${initials}</div>
              </div>
              <span class="fw-semibold text-truncate w-100 text-center" style="font-size: 0.69rem;">${st.title || st.company_name}</span>
            </div>
          `;
        }).join('');
        return addBtn + circles;
      }

      window.mwOpenCompStory = function (idx) {
        const list = window.__mwCompStoriesList || [];
        const st = list[idx];
        if (!st) return;

        document.getElementById('mwCompStoryModalBody').style.background = st.bg_gradient || 'linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%)';
        document.getElementById('mwCompStoryViewAvatar').textContent = (st.company_name || 'MW').slice(0, 2).toUpperCase();
        document.getElementById('mwCompStoryViewCompany').textContent = st.company_name || 'MeetWork İşletmesi';
        document.getElementById('mwCompStoryViewCategory').textContent = st.category || 'İş Gündemi';
        document.getElementById('mwCompStoryViewBadge').textContent = Number(st.trust_level) >= 3 ? '★ Gold Onaylı İşletme' : '✓ Silver Onaylı İşletme';
        document.getElementById('mwCompStoryViewTitle').textContent = st.title || '';
        document.getElementById('mwCompStoryViewContent').textContent = st.content || '';
        const cta = document.getElementById('mwCompStoryViewCta');
        if (cta) {
          cta.textContent = (st.cta_label || 'İşletme Vitrinini İncele') + ' →';
          cta.setAttribute('href', st.cta_url || (st.company_slug ? `/isletmeler?firma=${st.company_slug}` : '/isletmeler'));
        }

        const modalEl = document.getElementById('mwCompanyStoryViewerModal');
        if (modalEl && window.bootstrap) {
          const modal = new window.bootstrap.Modal(modalEl);
          modal.show();
        }
      };

      async function loadGeneralStories() {
        const row = document.getElementById('mwVitrinStoriesRow');
        if (!row) return;
        try {
          const res = await fetch(`${API_URL}/api/stories`);
          const data = await res.json();
          if (data.stories && data.stories.length > 0) {
            row.innerHTML = buildStoriesRowHtml(data.stories);
          }
        } catch (_) {}
      }

      async function loadCompanyProfile(slugOrId) {
        const container = document.getElementById('mwCompanyProfileContainer');
        if (!container) return;
        try {
          const res = await fetch(`${API_URL}/api/companies/${encodeURIComponent(slugOrId)}`);
          const data = await res.json();
          if (!data.success || !data.company) return;

          const comp = data.company;
          currentActiveCompany = comp;
          const compStories = data.stories || [];
          const listings = data.listings || [];
          const tenders = data.tenders || [];
          const careerJobs = data.career_jobs || [];
          const matchedTalents = data.matched_talents || [];
          const grantMatches = data.grant_matches || [];
          const grantApps = data.grant_applications || [];
          const grantProfile = data.grant_profile || { founded_year: 2021 };

          // Canlı Toptan Ürün Kataloğu & Birlikte Alalım Havuzlarını Çek (/api/bridge/company-catalog)
          let liveCatalogProducts = [];
          let liveGroupBuys = [];
          try {
            const catRes = await fetch(`${API_URL}/api/bridge/company-catalog?company_id=${encodeURIComponent(comp.id)}&vkn=${encodeURIComponent(comp.vkn || '')}`);
            const catData = await catRes.json();
            liveCatalogProducts = catData.products || [];
            liveGroupBuys = catData.active_group_buys || [];
          } catch (_) {}

          let targets = [];
          try { targets = JSON.parse(comp.target_sectors || '[]'); } catch (_) {}

          let loggedUser = null;
          try { loggedUser = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}
          const isMyOwnCompany = Boolean(
            loggedUser && (loggedUser.company_id === comp.id || loggedUser.company_slug === comp.slug)
          );

          const avatarStyle = Number(comp.trust_level) >= 3
            ? 'background: linear-gradient(135deg, #f59e0b 0%, #b45309 100%); color: #fff; border: 3px solid #fde68a;'
            : 'background: linear-gradient(135deg, #cbd5e1 0%, #64748b 100%); color: #fff; border: 3px solid #f1f5f9;';

          container.style.display = 'block';
          container.innerHTML = `
            <div class="mw-panel-card overflow-hidden shadow">
              <!-- Üst Kurumsal Kapak Bandı -->
              <div class="p-4 text-white" style="background: linear-gradient(135deg, #0b0b0e 0%, #dc3545 100%);">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded-4 fw-black d-flex align-items-center justify-content-center shadow flex-shrink-0" style="width:70px;height:70px;font-size:1.6rem;font-weight:900;${avatarStyle}">
                      ${(comp.name || 'MW').slice(0, 2).toUpperCase()}
                    </div>
                    <div>
                      <div class="mb-1 d-flex flex-wrap align-items-center gap-1">
                        ${getTrustBadge(comp.trust_level, comp.payment_score_tier)}
                        <span class="badge bg-success border border-light border-opacity-25" style="font-size:0.7rem;">
                          🏅 Doğrulanmış Toptan & İhracat Tedarikçisi
                        </span>
                        ${isMyOwnCompany ? `
                          <span class="badge bg-dark border border-light border-opacity-25" style="font-size:0.7rem;">
                            <i class="bi bi-lock-fill me-1"></i>Kendi İşletme Profilim (Kuruluş: ${grantProfile.founded_year || 2021})
                          </span>
                        ` : ''}
                      </div>
                      <h2 class="h4 fw-bold mb-1 text-white">${comp.name}</h2>
                      <div class="small text-white-50">
                        <i class="bi bi-briefcase-fill me-1"></i> ${comp.sector} • <i class="bi bi-geo-alt-fill ms-2 me-1"></i> ${comp.city || 'İstanbul'}, ${comp.country || 'Türkiye'}
                      </div>
                    </div>
                  </div>

                  <!-- Kurumsal Aksiyon Butonları -->
                  <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-light btn-sm fw-bold text-dark" onclick="window.mwOpenQrCardModal('${(comp.name || '').replace(/'/g, '')}', '${(comp.sector || '').replace(/'/g, '')}', '${comp.city || 'İstanbul'}', '${comp.vkn || '2720912021'}', '${comp.phone || '05412465429'}', '${comp.email || 'yonetim@meetwork.com.tr'}')">
                      <i class="bi bi-qr-code text-danger me-1"></i> 📱 QR Dijital Kartvizit & Tanış
                    </button>
                    ${isMyOwnCompany ? `
                      <a href="/hibe-kredi-eslesme" class="btn btn-warning btn-sm fw-bold text-dark">
                        <i class="bi bi-shield-lock-fill me-1"></i> Hibe, Fon & Kredi Eşleşmem (${grantMatches.length})
                      </a>
                      <button type="button" class="btn btn-success btn-sm fw-bold text-white" data-bs-toggle="modal" data-bs-target="#mwCompanyPostJobModal">
                        <i class="bi bi-person-plus-fill me-1"></i> + Personel / Uzman İlanı Aç
                      </button>
                    ` : ''}
                    <a href="/ihaleler?yeni=1" class="btn btn-light btn-sm fw-bold text-danger">
                      <i class="bi bi-hammer me-1"></i> Alım İhalesine Davet Et
                    </a>
                    <a href="https://stokpratik.com" target="_blank" class="btn btn-dark btn-sm fw-bold border-light">
                      <i class="bi bi-box-seam text-danger me-1"></i> StokPratik CariNet
                    </a>
                    <a href="https://depodandirekt.com" target="_blank" class="btn btn-danger btn-sm fw-bold border-light">
                      <i class="bi bi-globe2 me-1"></i> DepodanDirekt Vitrin
                    </a>
                  </div>
                </div>
              </div>

              <!-- İşletmeye Özel Yuvarlak Hikayeler Alanı -->
              <div class="px-4 pt-3 pb-2 border-bottom" style="background: var(--mw-surface-alt); border-color: var(--mw-border) !important;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-bold"><i class="bi bi-play-circle-fill text-danger me-1"></i> ${comp.name} — İşletme Hikayeleri & Güncellemeler</span>
                  ${isMyOwnCompany ? `
                    <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-bold" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#mwCompanyAddStoryModal">
                      + Yeni Hikaye Ekle
                    </button>
                  ` : ''}
                </div>
                <div class="mw-stories-row" id="mwSingleCompanyStoriesRow">
                  ${buildStoriesRowHtml(compStories)}
                </div>
              </div>

              <!-- Kurumsal İçerik -->
              <div class="p-4">
                <div class="mb-3">
                  <span class="small fw-bold text-muted me-2">İş Birliği Aradığı Hedef Sektörler (Akıllı Eşleşme):</span>
                  ${targets.length > 0 ? targets.map(t => `<span class="badge bg-danger-subtle text-danger me-1">${t}</span>`).join('') : '<span class="small text-muted">Tüm sektörlerle iş birliğine açık</span>'}
                </div>

                <!-- 🛍️ CANLI TOPTAN ÜRÜN KATALOĞU (KOLİ / PALET) & BİRLİKTE ALALIM VİTRİNİ -->
                <div class="p-3 rounded border border-primary-subtle mb-4" style="background: var(--mw-surface-alt);">
                  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <div>
                      <span class="badge bg-danger me-1">🛍️ CANLI TOPTAN KATALOG</span>
                      <span class="badge bg-success">⚡ MeetWork Üyelerine Özel İskontolu</span>
                      <h6 class="fw-bold mb-0 mt-1">
                        Koli / Palet Toptan Ürün Fiyatları & Aktif "Birlikte Alalım" Havuzları
                      </h6>
                    </div>
                    <div class="d-flex gap-2">
                      <a href="/talepler" class="btn btn-sm btn-outline-success fw-bold">
                        🤝 Birlikte Alalım Havuzları (${liveGroupBuys.length})
                      </a>
                      <a href="https://depodandirekt.com" target="_blank" class="btn btn-sm btn-danger fw-bold">
                        🛡️ Ödeme Korumalı Sipariş Ver →
                      </a>
                    </div>
                  </div>
                  <div class="row g-2">
                    ${liveCatalogProducts.map(prod => `
                      <div class="col-md-4">
                        <div class="p-3 rounded border h-100 d-flex flex-column justify-content-between" style="background: var(--mw-surface);">
                          <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                              <span class="badge bg-dark" style="font-size:0.65rem;">SKU: ${prod.sku}</span>
                              <span class="badge bg-danger-subtle text-danger fw-bold" style="font-size:0.68rem;">-%${prod.mw_member_discount_rate || 15} Üye İskontosu</span>
                            </div>
                            <div class="fw-bold small mb-2">${prod.name}</div>
                            <div class="d-flex justify-content-between small text-muted mb-1">
                              <span>📦 Koli Fiyatı:</span>
                              <strong class="text-dark">${Number(prod.box_price).toLocaleString('tr-TR')} TL</strong>
                            </div>
                            <div class="d-flex justify-content-between small text-success fw-bold mb-2">
                              <span>🏗️ Palet Fiyatı:</span>
                              <strong>${Number(prod.pallet_price).toLocaleString('tr-TR')} TL / ${prod.unit}</strong>
                            </div>
                          </div>
                          <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <small class="text-muted" style="font-size:0.7rem;">Min. Sipariş: ${prod.min_order_qty} ${prod.unit}</small>
                            <a href="${prod.dd_product_url || 'https://depodandirekt.com'}" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold" style="font-size:0.73rem;">
                              Toptan Al →
                            </a>
                          </div>
                        </div>
                      </div>
                    `).join('')}
                  </div>
                </div>

                ${isMyOwnCompany ? `
                  <!-- SADECE İŞLETME SAHİBİNE GÖRÜNEN GİZLİ ALAN 1: AKILLI TEŞVİK, HİBE, AB FONU & KREDİ EŞLEŞMESİ -->
                  <div class="p-3 rounded border border-danger mb-3" style="background: var(--mw-surface-alt);">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--mw-border) !important;">
                      <div>
                        <span class="badge bg-danger me-1"><i class="bi bi-shield-lock-fill me-1"></i>SADECE SİZE ÖZEL (DIŞARIYA KAPALI)</span>
                        <span class="badge bg-success">${grantProfile.founded_year || 2021} Kuruluş • 4 Katmanlı Resmi Kılavuz Kilidi Aktif</span>
                        <h6 class="fw-bold mb-0 mt-1">
                          <i class="bi bi-cash-coin text-danger me-1"></i> İşletmeniz İçin Doğrulanmış Hibe, AB Fonu & Krediler (${grantMatches.length})
                        </h6>
                      </div>
                      <a href="/hibe-kredi-eslesme" class="btn btn-sm btn-danger fw-bold">
                        <i class="bi bi-rocket-takeoff me-1"></i> Tüm Fonlarımı & Başvuru Masamı Aç (${grantApps.length} Aktif Başvuru) →
                      </a>
                    </div>

                    <div class="row g-2">
                      ${grantMatches.slice(0, 4).map((gm) => `
                        <div class="col-md-6">
                          <div class="p-2 rounded border h-100 d-flex flex-column justify-content-between" style="background: var(--mw-surface); border-color: var(--mw-border) !important;">
                            <div>
                              <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge ${gm.scope === 'ab' ? 'bg-primary' : gm.scope === 'global' ? 'bg-info text-dark' : 'bg-danger'}" style="font-size:0.65rem;">
                                  ${gm.scope === 'ab' ? '🇪🇺 AB Fonu' : gm.scope === 'global' ? '🌍 Global Hibe' : '🇹🇷 Yerel Kamu'} • ${gm.provider}
                                </span>
                                <span class="badge bg-success tabular-nums" style="font-size:0.68rem;">%${gm.match_score} Uyumlu</span>
                              </div>
                              <div class="fw-bold small mb-1">${gm.title}</div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-1 border-top mt-1" style="border-color: var(--mw-border) !important;">
                              <small class="fw-bold text-success tabular-nums" style="font-size:0.72rem;">${gm.grant_rate} (${gm.max_amount})</small>
                              <a href="/hibe-kredi-eslesme" class="small fw-bold text-danger text-decoration-none" style="font-size:0.72rem;">Başvur →</a>
                            </div>
                          </div>
                        </div>
                      `).join('')}
                    </div>
                  </div>

                  <!-- SADECE İŞLETME SAHİBİNE GÖRÜNEN GİZLİ ALAN 2: İŞVEREN İK, PERSONEL İLANI AÇMA & ONAYLI PDKS AKTARIMI -->
                  <div id="mwEmployerHrPanel" class="p-3 rounded border border-success mb-4" style="background: var(--mw-surface-alt);">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--mw-border) !important;">
                      <div>
                        <span class="badge bg-success me-1"><i class="bi bi-people-fill me-1"></i>İŞVEREN İK & ONAYLI PDKS AKTARIM MASASI (SADECE SİZE ÖZEL)</span>
                        <span class="badge bg-warning text-dark">💰 %70 KOSGEB & SGK 6111 Maaş Teşviki Entegreli</span>
                        <h6 class="fw-bold mb-0 mt-1">
                          Doğrulanmış Adayları İnceleyin & İşe Aldığınız Adayı Onayınızla StokPratik PDKS’ye Aktarın
                        </h6>
                      </div>
                      <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#mwCompanyPostJobModal">
                          <i class="bi bi-plus-circle-fill me-1"></i> + Personel / Dönemsel Uzman İlanı Aç
                        </button>
                        <a href="/kariyer" class="btn btn-sm btn-outline-dark fw-bold">
                          🔍 Doğrulanmış Adayları Bul (${matchedTalents.length}) →
                        </a>
                      </div>
                    </div>

                    <div class="row g-2">
                      ${matchedTalents.slice(0, 3).map((tl) => `
                        <div class="col-md-4">
                          <div class="p-2 rounded border h-100 d-flex flex-column justify-content-between" style="background: var(--mw-surface); border-color: var(--mw-border) !important; border-left: 3px solid #10b981 !important;">
                            <div>
                              <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small">👤 ${tl.full_name}</span>
                                <span class="badge bg-success tabular-nums" style="font-size:0.65rem;">Doğrulanmış</span>
                              </div>
                              <div class="small text-danger fw-semibold mb-1" style="font-size:0.72rem;">${tl.role_subtitle || tl.headline}</div>
                              <div class="small text-success fw-semibold" style="font-size:0.68rem;">${tl.subsidy_badge || '💰 KOSGEB / İŞKUR Teşvikine Uygun'}</div>
                            </div>
                            <div class="pt-2 border-top mt-2" style="border-color: var(--mw-border) !important;">
                              <div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="text-muted tabular-nums" style="font-size:0.7rem;">📍 ${tl.city} • ${tl.salary_expectation}</small>
                                <a href="/kariyer" class="small fw-bold text-success text-decoration-none" style="font-size:0.72rem;">İncele →</a>
                              </div>
                              <button type="button" class="btn btn-outline-success btn-sm w-100 fw-bold py-1" style="font-size:0.71rem;" onclick="window.mwOpenHirePdksModal('${(tl.full_name || '').replace(/'/g, '')}', '${(tl.target_position || tl.role_subtitle || 'Uzman').replace(/'/g, '')}')">
                                ✅ Adayı İşe Aldık → StokPratik PDKS’ye Aktar
                              </button>
                            </div>
                          </div>
                        </div>
                      `).join('')}
                    </div>
                  </div>
                ` : ''}

                <div class="row g-4">
                  <!-- Kurumsal Mağaza İlanları -->
                  <div class="col-md-6">
                    <h6 class="fw-bold border-bottom pb-2"><i class="bi bi-shop-window text-danger me-1"></i> Aktif Ticari & Demirbaş İlanları (${listings.length})</h6>
                    ${listings.length === 0 ? `<p class="small text-muted">Firmanın şu an aktif satılık/kiralık ilanı bulunmuyor.</p>` : listings.map(l => `
                      <a href="/ilanlar?ilan=${encodeURIComponent(l.slug)}" class="p-2 rounded border d-flex justify-content-between align-items-center mb-2 text-decoration-none" style="color:var(--mw-text);">
                        <div>
                          <div class="fw-bold small">${l.title}</div>
                          <small class="text-muted">${l.main_category} • ${l.listing_type}</small>
                        </div>
                        <span class="fw-bold text-danger small tabular-nums">${Number(l.price).toLocaleString('tr-TR')} ${l.currency}</span>
                      </a>
                    `).join('')}
                  </div>

                  <!-- Açık E-İhaleleri -->
                  <div class="col-md-6">
                    <h6 class="fw-bold border-bottom pb-2"><i class="bi bi-hammer text-danger me-1"></i> Açık Alım İhaleleri & Birlikte Alalım Havuzları</h6>
                    ${tenders.map(t => `
                      <a href="/ihaleler" class="p-2 rounded border d-flex justify-content-between align-items-center mb-2 text-decoration-none" style="color:var(--mw-text);">
                        <div>
                          <span class="badge bg-danger me-1">ALIM İHALESİ</span>
                          <span class="fw-bold small">${t.title}</span>
                        </div>
                        <small class="text-danger fw-bold">Teklif Ver →</small>
                      </a>
                    `).join('')}
                    ${liveGroupBuys.slice(0, 2).map(gb => `
                      <a href="/talepler" class="p-2 rounded border d-flex justify-content-between align-items-center mb-2 text-decoration-none" style="color:var(--mw-text);">
                        <div>
                          <span class="badge bg-success me-1">🤝 BİRLİKTE ALALIM</span>
                          <span class="fw-bold small">${gb.title}</span>
                        </div>
                        <small class="text-success fw-bold">${gb.current_qty}/${gb.target_qty} ${gb.unit} →</small>
                      </a>
                    `).join('')}
                  </div>

                  <!-- HERKESE AÇIK KURUMSAL İK VİTRİNİ: AÇIK İŞ & UZMAN İLANLARIMIZ -->
                  <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                      <h6 class="fw-bold mb-0"><i class="bi bi-briefcase-fill text-primary me-1"></i> 📢 Açık İş & Dönemsel Uzman İlanlarımız (${careerJobs.length})</h6>
                      <div class="d-flex gap-2">
                        ${isMyOwnCompany ? `
                          <button type="button" class="btn btn-sm btn-success py-0 px-2 fw-bold" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#mwCompanyPostJobModal">
                            + Yeni İş İlanı Ekle
                          </button>
                        ` : ''}
                        <a href="/kariyer/is-ara" class="small fw-bold text-primary text-decoration-none">Tüm İş İlanlarını Gör →</a>
                      </div>
                    </div>
                    ${careerJobs.length === 0 ? `
                      <div class="p-3 rounded border d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: var(--mw-surface-alt);">
                        <span class="small text-muted">Bu işletmenin şu an açık personel ilanı bulunmuyor. Özgeçmişinizi bırakarak gelecekteki pozisyonlar için mülakat teklifi alabilirsiniz.</span>
                        <a href="/kariyer/cv-olustur" class="btn btn-sm btn-outline-danger fw-bold">İş Arıyorum / Özgeçmiş (CV) Oluştur</a>
                      </div>
                    ` : `
                      <div class="row g-2">
                        ${careerJobs.map((cj) => `
                          <div class="col-md-6">
                            <div class="p-3 rounded border d-flex flex-column justify-content-between h-100" style="background: var(--mw-surface); border-left: 4px solid #f59e0b !important;">
                              <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                  <span class="badge bg-warning text-dark fw-bold">${cj.work_mode}</span>
                                  <small class="text-muted tabular-nums">#${cj.job_no} • 📍 ${cj.city}</small>
                                </div>
                                <div class="fw-bold mb-1">${cj.title}</div>
                                <div class="small text-success fw-semibold mb-2">${cj.subsidy_note || ''}</div>
                              </div>
                              <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <strong class="small text-danger tabular-nums">${cj.salary_range}</strong>
                                <a href="/kariyer/is-ara" class="btn btn-sm btn-danger fw-bold">⚡ Başvur</a>
                              </div>
                            </div>
                          </div>
                        `).join('')}
                      </div>
                    `}
                  </div>
                </div>
              </div>
            </div>
          `;
          const mobProfileContainer = document.getElementById('mwMobCompanyProfileContainer');
          if (mobProfileContainer) {
            mobProfileContainer.style.display = 'block';
            mobProfileContainer.innerHTML = container.innerHTML;
          }
        } catch (_) {}
      }

      async function loadAllCompanies() {
        const grid = document.getElementById('mwCompaniesGrid');
        if (!grid) return;
        try {
          const res = await fetch(`${API_URL}/api/companies`);
          const data = await res.json();
          const list = data.companies || [];
          if (list.length === 0) {
            grid.innerHTML = `
              <div class="col-12 text-center py-4">
                <p class="small text-muted mb-2">Henüz kayıtlı işletme bulunmuyor. İlk kurumsal profili siz oluşturun!</p>
                <a href="/giris?tab=register" class="btn btn-sm btn-danger fw-bold">+ İşletmemi Kaydet</a>
              </div>`;
            return;
          }

          grid.innerHTML = list.map((c) => `
            <div class="col-md-4 col-sm-6">
              <div class="mw-vitrin-card p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div class="rounded-3 bg-danger text-white fw-bold d-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                    ${(c.name || 'MW').slice(0, 2).toUpperCase()}
                  </div>
                  <div class="text-end">
                    ${getTrustBadge(c.trust_level, c.payment_score_tier)}
                  </div>
                </div>
                <h6 class="fw-bold mb-1">${c.name}</h6>
                <div class="small text-muted mb-2">
                  <i class="bi bi-tag-fill text-danger me-1"></i> ${c.sector} • ${c.city || 'İstanbul'}
                </div>
                <div class="d-flex flex-wrap gap-1 mb-3">
                  <span class="badge bg-success-subtle text-success" style="font-size:0.65rem;">🏅 Doğrulanmış Toptan Tedarikçi</span>
                  <span class="badge bg-danger-subtle text-danger" style="font-size:0.65rem;">📦 Koli / Palet Katalog</span>
                </div>
                <div class="mt-auto d-flex gap-2 pt-2 border-top" style="border-color:var(--mw-border)!important;">
                  <a href="/isletmeler?firma=${encodeURIComponent(c.slug)}" class="btn btn-sm btn-danger w-100 fw-bold">
                    Kurumsal Profil & Toptan Vitrin
                  </a>
                  <button type="button" class="btn btn-sm btn-outline-dark" title="QR Dijital Kartvizit" onclick="window.mwOpenQrCardModal('${(c.name || '').replace(/'/g, '')}', '${(c.sector || '').replace(/'/g, '')}', '${c.city || 'İstanbul'}', '${c.vkn || '2720912021'}', '${c.phone || '05412465429'}', '${c.email || 'info@meetwork.com.tr'}')">
                    <i class="bi bi-qr-code"></i>
                  </button>
                </div>
              </div>
            </div>
          `).join('');
        } catch (_) {}
      }

      document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        if (params.get('firma')) {
          const genCard = document.getElementById('mwVitrinGeneralStoriesCard');
          if (genCard) genCard.style.display = 'none';
          loadCompanyProfile(params.get('firma'));
        } else {
          loadGeneralStories();
        }
        loadAllCompanies();

        const storyForm = document.getElementById('mwCompanyAddStoryForm');
        if (storyForm) {
          storyForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            let user = null;
            try { user = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}

            const compId = currentActiveCompany ? currentActiveCompany.id : (user ? user.company_id : '');
            const compName = currentActiveCompany ? currentActiveCompany.name : (user ? user.company_name : 'MeetWork Üye İşletme');
            const compSlug = currentActiveCompany ? currentActiveCompany.slug : (user ? user.company_slug : '');
            const trustLvl = currentActiveCompany ? currentActiveCompany.trust_level : (user ? user.trust_level : 2);

            const title = document.getElementById('mwCompStoryTitle').value.trim();
            const content = document.getElementById('mwCompStoryContent').value.trim();
            const category = document.getElementById('mwCompStoryCategory').value;
            const bg_gradient = document.getElementById('mwCompStoryGradient').value;
            const fb = document.getElementById('mwCompAddStoryFeedback');

            try {
              const res = await fetch(`${API_URL}/api/stories`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  company_id: compId,
                  company_name: compName,
                  company_slug: compSlug,
                  author_name: user ? user.full_name : 'Firma Yetkilisi',
                  trust_level: trustLvl,
                  title,
                  content,
                  category,
                  bg_gradient
                })
              });
              const out = await res.json();
              if (out.success) {
                storyForm.reset();
                if (fb) {
                  fb.style.display = 'block';
                  fb.className = 'small mb-2 text-success fw-bold';
                  fb.textContent = '✓ İşletme hikayeniz yayınlandı!';
                }
                if (params.get('firma')) {
                  loadCompanyProfile(params.get('firma'));
                } else {
                  loadGeneralStories();
                }
              }
            } catch (_) {}
          });
        }

        const postJobForm = document.getElementById('mwCompanyPostJobForm');
        if (postJobForm) {
          postJobForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            let user = null;
            try { user = JSON.parse(localStorage.getItem('mw_user') || 'null'); } catch (_) {}

            const compId = currentActiveCompany ? currentActiveCompany.id : (user ? user.company_id : '');
            const compName = currentActiveCompany ? currentActiveCompany.name : (user ? user.company_name : 'MeetWork Üye İşletme');
            const compSlug = currentActiveCompany ? currentActiveCompany.slug : (user ? user.company_slug : '');
            const trustLvl = currentActiveCompany ? currentActiveCompany.trust_level : (user ? user.trust_level : 2);
            const skillsArr = (document.getElementById('cpJobSkills').value || '').split(',').map(s => s.trim()).filter(Boolean);
            const fb = document.getElementById('cpJobFeedback');

            try {
              const res = await fetch(`${API_URL}/api/career/job`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  company_id: compId,
                  company_name: compName,
                  company_slug: compSlug,
                  trust_level: trustLvl,
                  title: document.getElementById('cpJobTitle').value.trim(),
                  department: document.getElementById('cpJobDepartment').value,
                  city: document.getElementById('cpJobCity').value.trim(),
                  work_mode: document.getElementById('cpJobWorkMode').value,
                  salary_range: document.getElementById('cpJobSalary').value.trim(),
                  required_skills: skillsArr,
                  description: document.getElementById('cpJobDesc').value.trim()
                })
              });
              const out = await res.json();
              if (out.success) {
                postJobForm.reset();
                if (fb) {
                  fb.style.display = 'block';
                  fb.className = 'col-12 small fw-bold text-success';
                  fb.textContent = out.message || '✓ İş ilanınız başarıyla yayınlandı!';
                }
                if (params.get('firma')) {
                  loadCompanyProfile(params.get('firma'));
                }
              }
            } catch (_) {}
          });
        }

        // 📱 QR Dijital Kartvizit -> Onaylı CRM & Cari Kart Aktarımı (KURAL 5)
        async function triggerQrCrmSync(createSampleQuote) {
          const partner = window.__qrModalPartner || {};
          const fb = document.getElementById('mwQrModalFeedback');
          try {
            const res = await fetch(`${API_URL}/api/bridge/crm-cari-sync`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'qr_card_handshake',
                create_sample_quote: Boolean(createSampleQuote),
                matched_company: partner
              })
            });
            const out = await res.json();
            if (fb) {
              fb.style.display = 'block';
              fb.className = 'small fw-bold mb-2 text-success';
              fb.textContent = out.message || '✓ Rehberinize ve StokPratik Cari/CRM kartlarınıza kaydedildi!';
            }
          } catch (_) {}
        }

        const qrSaveBtn = document.getElementById('mwQrSaveCrmBtn');
        const qrQuoteBtn = document.getElementById('mwQrSaveWithQuoteBtn');
        if (qrSaveBtn) qrSaveBtn.addEventListener('click', () => triggerQrCrmSync(false));
        if (qrQuoteBtn) qrQuoteBtn.addEventListener('click', () => triggerQrCrmSync(true));

        // ✅ Onaylı İşe Alım -> StokPratik PDKS Personel Kartı Aktarımı (KURAL 3)
        const pdksForm = document.getElementById('mwHireToPdksForm');
        if (pdksForm) {
          pdksForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const fb = document.getElementById('pdksTransferFeedback');
            try {
              const res = await fetch(`${API_URL}/api/bridge/career-to-pdks`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  action: 'approve_hire_to_pdks',
                  candidate: {
                    full_name: document.getElementById('pdksCandName').value,
                    position: document.getElementById('pdksCandPosition').value,
                    branch_name: document.getElementById('pdksCandBranch').value,
                    start_date: document.getElementById('pdksStartDate').value,
                    agreed_salary: Number(document.getElementById('pdksAgreedSalary').value || 65000)
                  }
                })
              });
              const out = await res.json();
              if (fb) {
                fb.style.display = 'block';
                fb.className = 'small fw-bold mb-2 text-success';
                fb.textContent = out.message || '✓ Personel kartı StokPratik PDKS modülüne aktarıldı!';
              }
            } catch (_) {}
          });
        }
      });
    })();
  </script>
  </div><!-- /.mw-desktop-screen -->

  <!-- EKRAN 4: MOBİL & TABLET İŞLETMELER REHBERİ VE CANLI TOPTAN KATALOG VİTRİNİ (meetwork_b2b_ekosistemi/4._i_letmeler_rehberi_canl_toptan_katalog) -->
