    <!-- Tekil İşletme Vitrin & Yönetim Paneli (Mobil/Tablet ?firma=... görünümü) -->
    <div id="mwMobCompanyProfileContainer" class="px-margin my-2" style="display:none;"></div>

    <!-- Search & Smart Filter Module -->
    <div class="px-margin mt-space-sm">
      <div class="bg-surface-card p-space-md rounded-2xl shadow-sm border border-border-light flex flex-col gap-space-md">
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3.5 text-outline text-[20px]">search</span>
          <input class="w-full bg-surface-bg text-navy-deep placeholder:text-outline font-body-md text-body-md pl-11 pr-10 py-3 rounded-xl outline-none focus:bg-surface-card border border-border-light transition-all" id="company-search-input" placeholder="Firma, VKN, ürün veya NACE kodu ara..." type="text">
          <a href="/qr-kartvizit" class="absolute right-3 text-outline hover:text-navy-deep transition-colors" title="Barkod & Karekod Tara">
