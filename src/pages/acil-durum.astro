  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "MeetWork Acil Durum Destek Platformu",
    "description": "KOBİ'ler ve girişimciler için acil durum destek platformu",
    "url": "https://meetwork.com/acil-durum",
    "publisher": {
      "@type": "Organization",
      "name": "MeetWork",
      "url": "https://meetwork.com",
      "logo": "https://meetwork.com/logo.png"
    },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {meta.toplamAktif},
      "itemListElement": [
        {acilDurumlar.filter(d => d.durum === 'aktif').slice(0, 3).map((durum, index) => `{
          "@type": "Organization",
          "position": ${index + 1},
          "name": "${durum.firmaAdi}",
          "description": "${durum.aciklama}",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "${durum.konum.split('/')[0].trim()}",
            "addressRegion": "${durum.konum.split('/')[1] ? durum.konum.split('/')[1].trim() : durum.konum.split('/')[0].trim()}"
          }
        }`).join(',')}
      ]
    }
  }
  </script>

