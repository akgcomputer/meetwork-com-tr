---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="İhale Onay & Güvenli Ödeme Havuzu (Proforma) | MeetWork B2B Ağı"
  description="Kazanan ihale teklifini onaylayın; mal bedeli, KDV, navlun ve teslim şekli (EXW/DDP) ayrımıyla sözleşme bedeli MeetWork & DepodanDirekt Güvenli Ödeme Havuzu'na aktarılsın."
>
  <div class="mw-b2b-scope bg-surface-bg text-on-surface antialiased flex flex-col w-full max-w-2xl mx-auto pb-8 rounded-2xl">
    <!-- Adım İlerleme Çubuğu & Durum Göstergesi -->
    <div class="px-margin pt-space-md pb-space-xs">
      <div class="bg-surface-container rounded-xl p-space-sm shadow-sm flex items-center justify-between gap-space-xs">
        <div class="flex items-center gap-space-xs min-w-0">
          <div class="w-7 h-7 rounded-full bg-trust-emerald text-surface-card flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[16px]">check</span>
          </div>
          <div class="flex flex-col min-w-0">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Adım 3 / 3</span>
            <span class="font-label-md text-label-md text-navy-deep truncate">Kesinleşme &amp; Güvenli Havuz</span>
          </div>
        </div>
        <div class="flex items-center gap-1.5 shrink-0 px-2.5 py-1 bg-surface-card rounded-full shadow-sm">
          <span class="w-2 h-2 rounded-full bg-trust-emerald animate-pulse"></span>
          <span class="font-label-sm text-label-sm text-navy-deep font-semibold">Aktif Oturum</span>
        </div>
      </div>
    </div>

    <!-- Açıklama Metni -->
    <div class="px-margin pt-space-xs pb-space-sm">
      <p class="font-body-md text-body-md text-on-surface-variant">
        Kazanan teklifi onaylayın; sözleşme ve proforma bedeli <span class="font-semibold text-navy-deep">MeetWork &amp; DepodanDirekt Güvenli Ödeme Havuzu</span>'na bloke edilsin, teslimat tamamlanana kadar riskiniz sıfırlansın.
      </p>
    </div>

    <!-- Özet İhale Kartı -->
    <div class="px-margin pb-space-md">
      <div class="bg-surface-card rounded-xl p-space-md shadow-sm border border-border-light relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-trust-emerald"></div>
        <div class="pl-2">
          <div class="flex items-start justify-between gap-space-sm mb-space-xs">
            <div class="flex items-center gap-space-xs flex-wrap">
              <span class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-navy-deep font-label-sm text-label-sm font-bold tracking-wide">
                #İHL-2024-88
              </span>
              <span class="px-2.5 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm">
                Açık Eksiltme Sonucu
              </span>
            </div>
            <span class="inline-flex items-center gap-1 text-trust-emerald font-label-sm text-label-sm font-bold bg-surface-container-low px-2 py-0.5 rounded-full shrink-0">
              <span class="material-symbols-outlined text-[14px]">verified</span>
              En Düşük Teklif
            </span>
          </div>
          <h2 class="font-headline-sm text-headline-sm text-navy-deep mb-space-sm">
            304 Kalite Paslanmaz Sac (5 Ton)
          </h2>
          <!-- Kazanan Tedarikçi Bilgi Bloğu -->
          <div class="bg-surface-container-low rounded-xl p-space-sm flex items-center justify-between gap-space-sm">
            <div class="flex items-center gap-space-sm min-w-0">
              <div class="w-10 h-10 rounded-lg bg-navy-deep text-surface-card flex items-center justify-center font-headline-sm text-headline-sm shrink-0">
                K
              </div>
              <div class="flex flex-col min-w-0">
                <div class="flex items-center gap-1">
                  <span class="font-label-lg text-label-lg text-navy-deep font-bold truncate">
                    Kardemir Rulo Sac &amp; Çelik A.Ş.
                  </span>
                  <span class="material-symbols-outlined text-trust-emerald text-[16px] shrink-0" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                </div>
                <div class="flex items-center gap-2 mt-0.5">
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-surface-card text-navy-deep font-label-sm text-label-sm font-bold shadow-sm">
                    💎 A+ Ödeme Disiplini
                  </span>
                  <span class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-0.5">
                    <span class="material-symbols-outlined text-gold-badge text-[14px]" style="font-variation-settings: 'FILL' 1;">star</span>
                    %98 Güven Skoru
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mali Kırılım & Proforma Tablosu -->
    <div class="px-margin pb-space-md">
      <div class="bg-surface-card rounded-xl p-space-md shadow-sm border border-border-light">
        <div class="flex items-center justify-between mb-space-sm">
          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-navy-deep text-[20px]">receipt_long</span>
            <h3 class="font-headline-sm text-headline-sm text-navy-deep">Mali Kırılım &amp; Proforma</h3>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-2 py-0.5 rounded-full">
            Resmi Taslak
          </span>
        </div>
        <div class="space-y-space-xs pt-space-xs">
          <div class="flex items-center justify-between py-1.5 text-on-surface-variant font-body-md text-body-md">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant opacity-40"></span>
              Mal Bedeli <span class="font-body-sm text-body-sm text-on-surface-variant opacity-75">(5 Ton x 80.000 ₺)</span>
            </span>
            <span class="font-semibold text-navy-deep">400.000 ₺</span>
          </div>
          <div class="flex items-center justify-between py-1.5 text-trust-emerald font-body-md text-body-md bg-surface-container-low px-2 rounded-lg">
            <span class="flex items-center gap-1.5 font-medium">
              <span class="material-symbols-outlined text-[16px]">trending_down</span>
              İhale Eksiltme Tasarrufu
            </span>
            <span class="font-bold">-20.000 ₺</span>
          </div>
          <div class="flex items-center justify-between py-1.5 text-on-surface-variant font-body-md text-body-md">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant opacity-40"></span>
              KDV (%20)
            </span>
            <span class="font-semibold text-navy-deep">76.000 ₺</span>
          </div>
          <div class="flex items-center justify-between py-1.5 text-on-surface-variant font-body-md text-body-md">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-on-surface-variant opacity-40"></span>
              Sigortalı Navlun &amp; Lojistik Bedeli
            </span>
            <span class="font-semibold text-navy-deep">14.500 ₺</span>
          </div>
          <div class="flex items-center justify-between py-1.5 text-cherry-vibrant font-body-md text-body-md bg-surface-container-low px-2 rounded-lg">
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px]">redeem</span>
              MeetWork Havuz Komisyonu
            </span>
            <span class="font-bold uppercase font-label-md text-label-md">0 ₺ (Ücretsiz Kampanya)</span>
          </div>
          <div class="mt-space-sm pt-space-sm bg-navy-deep text-surface-card rounded-xl p-space-md shadow-md flex items-center justify-between">
            <div class="flex flex-col">
              <span class="font-label-sm text-label-sm text-surface-variant uppercase tracking-wider">Ödenecek Havuz Blokesi</span>
              <span class="font-label-lg text-label-lg text-surface-card font-bold">TOPLAM PROFORMA</span>
            </div>
            <div class="text-right">
              <span class="font-display-lg-mobile text-display-lg-mobile font-extrabold tracking-tight text-surface-card">
                470.500 <span class="font-headline-sm text-headline-sm text-tertiary-fixed-dim">₺</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Teslim Şekli ve Lojistik Seçimi -->
    <div class="px-margin pb-space-md">
      <div class="bg-surface-card rounded-xl p-space-md shadow-sm border border-border-light">
        <div class="flex items-center gap-space-xs mb-space-sm">
          <span class="material-symbols-outlined text-navy-deep text-[20px]">local_shipping</span>
          <h3 class="font-headline-sm text-headline-sm text-navy-deep">Teslimat &amp; Güvence Şartları</h3>
        </div>
        <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase font-bold tracking-wider mb-2">
          Teslim Şekli (Incoterms 2020)
        </label>
        <div class="grid grid-cols-2 gap-space-xs p-1 bg-surface-container-low rounded-xl mb-space-md" id="deliveryModeSelector">
          <button class="delivery-btn py-2.5 px-3 rounded-lg text-center transition-all flex flex-col items-center justify-center gap-0.5 bg-surface-card shadow-sm text-navy-deep" onclick="window.selectMwDelivery && window.selectMwDelivery(this, 'EXW')" type="button">
            <span class="font-label-lg text-label-lg font-bold">Fabrikada Teslim</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">EXW (Alıcı Alır)</span>
          </button>
          <button class="delivery-btn py-2.5 px-3 rounded-lg text-center transition-all flex flex-col items-center justify-center gap-0.5 bg-navy-deep text-surface-card shadow-sm" onclick="window.selectMwDelivery && window.selectMwDelivery(this, 'DDP')" type="button">
            <span class="font-label-lg text-label-lg font-bold flex items-center gap-1">
              Adrese Teslim
              <span class="material-symbols-outlined text-[14px] text-tertiary-fixed-dim" style="font-variation-settings: 'FILL' 1;">check</span>
            </span>
            <span class="font-label-sm text-label-sm text-surface-variant font-medium">DDP (Gümrük &amp; Sigortalı)</span>
          </button>
        </div>

        <div class="bg-surface-container-low rounded-xl p-space-sm flex items-start gap-space-sm mb-space-md">
          <div class="w-9 h-9 rounded-xl bg-trust-emerald text-surface-card flex items-center justify-center shrink-0 shadow-sm mt-0.5">
            <span class="material-symbols-outlined text-[20px]">shield</span>
          </div>
          <div class="flex flex-col min-w-0">
            <span class="font-label-lg text-label-lg text-navy-deep font-bold">
              Güvenli Havuz Blokesi Koruma Modeli
            </span>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5 leading-relaxed">
              Paranız doğrudan satıcıya gitmez. MeetWork &amp; DepodanDirekt BDDK lisanslı güvenli ödeme havuzunda bloke edilir; malzeme deponuza ulaşıp muayene onayınız verilene kadar korunur.
            </p>
          </div>
        </div>

        <div class="bg-surface-container rounded-xl p-space-sm flex items-start gap-space-sm cursor-pointer select-none" onclick="window.toggleMwAgreement && window.toggleMwAgreement()">
          <input checked class="mt-1 w-5 h-5 rounded accent-navy-deep cursor-pointer" id="contractConsent" onclick="event.stopPropagation(); window.updateMwConsentState && window.updateMwConsentState();" type="checkbox"/>
          <label class="font-body-sm text-body-sm text-navy-deep cursor-pointer leading-snug" for="contractConsent">
            <span class="font-bold underline decoration-navy-deep/40">Elektronik B2B Ticaret Sözleşmesini</span> ve 
            <span class="font-bold underline decoration-navy-deep/40">Muayene / Mal Kabul Şartlarını</span> okudum, eksiksiz onaylıyorum.
          </label>
        </div>
      </div>
    </div>

    <!-- Büyük Aksiyon Alanı & Güvenlik Rozetleri -->
    <div class="px-margin pb-space-xl">
      <div class="bg-surface-card rounded-xl p-space-md shadow-md border border-border-light flex flex-col gap-space-sm">
        <button class="w-full py-4 px-space-md rounded-xl bg-navy-deep text-surface-card font-label-lg text-label-lg font-bold flex items-center justify-center gap-space-sm shadow-lg hover:bg-slate-800 active:scale-[0.99] transition-all relative overflow-hidden group" id="submitTenderBtn" onclick="window.triggerMwTenderApproval && window.triggerMwTenderApproval()" type="button">
          <span class="w-7 h-7 rounded-lg bg-trust-emerald text-surface-card flex items-center justify-center shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[18px]">verified_user</span>
          </span>
          <span class="truncate" id="btnText">İhaleyi Onayla &amp; Güvenli Ödeme Havuzuna Aktar</span>
        </button>
        <div class="flex items-center justify-center gap-2 py-1 text-center">
          <span class="material-symbols-outlined text-trust-emerald text-[18px]" style="font-variation-settings: 'FILL' 1;">lock</span>
          <span class="font-label-sm text-label-sm text-on-surface-variant font-semibold">
            BDDK Lisanslı Ödeme ve Blokaj Altyapısı ile %100 Güvence Altındadır
          </span>
        </div>
        <div class="grid grid-cols-3 gap-space-xs pt-space-xs text-center">
          <div class="bg-surface-container-low rounded-lg p-2 flex flex-col items-center">
            <span class="material-symbols-outlined text-navy-deep text-[18px] mb-1">security</span>
            <span class="font-label-sm text-label-sm text-navy-deep font-bold">256-Bit SSL</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant scale-90">Banka Düzeyi</span>
          </div>
          <div class="bg-surface-container-low rounded-lg p-2 flex flex-col items-center">
            <span class="material-symbols-outlined text-navy-deep text-[18px] mb-1">fact_check</span>
            <span class="font-label-sm text-label-sm text-navy-deep font-bold">Mal Kabul Şartı</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant scale-90">Onaysız Aktarılmaz</span>
          </div>
          <div class="bg-surface-container-low rounded-lg p-2 flex flex-col items-center">
            <span class="material-symbols-outlined text-navy-deep text-[18px] mb-1">balance</span>
            <span class="font-label-sm text-label-sm text-navy-deep font-bold">Tahkim Koruması</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant scale-90">MeetWork Hukuk</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Başarı Durumu Modalı -->
    <div class="hidden fixed inset-0 z-50 flex items-center justify-center p-margin bg-navy-deep/60 backdrop-blur-sm" id="successModal">
      <div class="bg-surface-card rounded-2xl p-space-lg w-full max-w-sm shadow-2xl flex flex-col items-center text-center">
        <div class="w-16 h-16 rounded-full bg-trust-emerald/10 text-trust-emerald flex items-center justify-center mb-space-sm">
          <span class="material-symbols-outlined text-[36px]" style="font-variation-settings: 'FILL' 1;">task_alt</span>
        </div>
        <h3 class="font-headline-sm text-headline-sm text-navy-deep font-bold mb-1">
          Tutar Başarıyla Bloke Edildi!
        </h3>
        <p class="font-body-md text-body-md text-on-surface-variant mb-space-md">
          470.500 ₺ MeetWork &amp; DepodanDirekt Güvenli Ödeme Havuzu'na aktarıldı. <span class="font-semibold text-navy-deep">Kardemir Rulo Sac &amp; Çelik A.Ş.</span> sevkiyat hazırlığına başladı.
        </p>
        <div class="w-full bg-surface-container-low rounded-xl p-space-sm mb-space-md text-left font-body-sm text-body-sm space-y-1">
          <div class="flex justify-between">
            <span class="text-on-surface-variant">Blokaj Referansı:</span>
            <span class="font-bold text-navy-deep" id="mwEscrowRefNo">MW-GÖH-892401</span>
          </div>
          <div class="flex justify-between">
            <span class="text-on-surface-variant">Teslim Şekli:</span>
            <span class="font-bold text-navy-deep" id="mwEscrowIncoterms">DDP (Adrese Teslim)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-on-surface-variant">Tahmini Teslimat:</span>
            <span class="font-bold text-navy-deep">3 İş Günü</span>
          </div>
        </div>
        <a href="/ihaleler" class="w-full py-3 bg-navy-deep text-surface-card font-label-lg text-label-lg font-bold rounded-xl shadow-md text-center">
          İhale &amp; Sipariş Takip Ekranına Dön
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';
      let selectedIncoterms = 'DDP';

      window.selectMwDelivery = function (btn, mode) {
        selectedIncoterms = mode;
        const buttons = document.querySelectorAll('.delivery-btn');
        buttons.forEach((b) => {
          b.className = 'delivery-btn py-2.5 px-3 rounded-lg text-center transition-all flex flex-col items-center justify-center gap-0.5 bg-surface-card shadow-sm text-navy-deep';
          const checkIcon = b.querySelector('.material-symbols-outlined');
          if (checkIcon) checkIcon.remove();
        });

        btn.className = 'delivery-btn py-2.5 px-3 rounded-lg text-center transition-all flex flex-col items-center justify-center gap-0.5 bg-navy-deep text-surface-card shadow-sm';
        const titleSpan = btn.querySelector('.font-label-lg');
        if (titleSpan && !titleSpan.querySelector('.material-symbols-outlined')) {
          titleSpan.innerHTML += ' <span class="material-symbols-outlined text-[14px] text-tertiary-fixed-dim" style="font-variation-settings: \'FILL\' 1;">check</span>';
        }
      };

      window.toggleMwAgreement = function () {
        const cb = document.getElementById('contractConsent');
        if (!cb) return;
        cb.checked = !cb.checked;
        window.updateMwConsentState();
      };

      window.updateMwConsentState = function () {
        const cb = document.getElementById('contractConsent');
        const btn = document.getElementById('submitTenderBtn');
        if (!cb || !btn) return;
        if (!cb.checked) {
          btn.classList.add('opacity-50', 'pointer-events-none');
        } else {
          btn.classList.remove('opacity-50', 'pointer-events-none');
        }
      };

      window.triggerMwTenderApproval = async function () {
        const btn = document.getElementById('submitTenderBtn');
        const btnText = document.getElementById('btnText');
        const modal = document.getElementById('successModal');
        const refEl = document.getElementById('mwEscrowRefNo');
        const incoEl = document.getElementById('mwEscrowIncoterms');

        if (btnText) btnText.textContent = 'Güvenli Havuz İşlemi Yapılıyor...';
        if (btn) btn.classList.add('opacity-75');

        try {
          const res = await fetch(`${API_URL}/api/bridge/tender-to-escrow`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              tender_id: 'tender_mw_88',
              tender_no: 'İHL-2024-88',
              title: '304 Kalite Paslanmaz Sac (5 Ton)',
              buyer_vkn: '2720912021',
              buyer_name: 'Özkan Metal San. A.Ş.',
              supplier_vkn: '7800491823',
              supplier_name: 'Kardemir Rulo Sac & Çelik A.Ş.',
              subtotal: 380000,
              vat_total: 76000,
              freight_cost: 14500,
              currency: 'TRY',
              incoterms: selectedIncoterms
            })
          });
          const data = await res.json();
          if (refEl && data.proforma_no) refEl.textContent = data.proforma_no;
        } catch (_) {}

        if (incoEl) incoEl.textContent = selectedIncoterms === 'EXW' ? 'EXW (Fabrikada Teslim)' : 'DDP (Adrese Teslim)';
        if (btnText) btnText.textContent = 'İhaleyi Onayla & Güvenli Ödeme Havuzuna Aktar';
        if (btn) btn.classList.remove('opacity-75');
        if (modal) modal.classList.remove('hidden');
      };
    })();
  </script>
</BaseLayout>
