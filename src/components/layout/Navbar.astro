---
import { menuItems } from '../../data/menu';
const currentPath = Astro.url.pathname;
---

<header class="mw-super-header sticky-top">
  <!-- Üst Ekosistem & Kurumsal Bilgi Bandı (Büyütülmüş Okunaklı Yazı Boyutu) -->
  <div class="mw-topbar d-none d-lg-block">
    <div class="container-fluid px-lg-4 d-flex justify-content-between align-items-center py-2">
      <div class="d-flex align-items-center gap-3">
        <span class="badge bg-danger">B2B Super-Network</span>
        <a href="https://stokpratik.com" data-sso-target="stokpratik" class="mw-toplink mw-sso-jump-link" title="StokPratik Bulut ERP & CariNet Paneline Tek Tıkla Şifresiz Geçiş">
          <i class="bi bi-box-seam text-danger me-1"></i>StokPratik ERP & CariNet <span class="badge bg-danger-subtle text-danger ms-1" style="font-size:0.65rem;">⚡ Şifresiz Geçiş</span>
        </a>
        <a href="https://depodandirekt.com" data-sso-target="depodandirekt" class="mw-toplink mw-sso-jump-link" title="DepodanDirekt Toptan & İhracat Pazaryerine Tek Tıkla Şifresiz Geçiş">
          <i class="bi bi-globe2 text-danger me-1"></i>DepodanDirekt Toptan & İhracat <span class="badge bg-success-subtle text-success ms-1" style="font-size:0.65rem;">⚡ Şifresiz Geçiş</span>
        </a>
        <a href="/talepler" class="mw-toplink">
          <i class="bi bi-people-fill text-danger me-1"></i>Birlikte Alalım (Ortak Alım Havuzu)
        </a>
      </div>
      <div class="d-flex align-items-center gap-3">
        <!-- Görünüm Modu Seçici (Sadece İkon) -->
        <div class="d-inline-flex align-items-center bg-dark border border-secondary rounded-pill p-1 gap-1">
          <button type="button" onclick="window.setMwViewMode && window.setMwViewMode('mobile')" class="btn btn-sm py-0.5 px-2 rounded-pill text-white-50 hover-text-white border-0" style="font-size:0.8rem;" title="Telefon Görünümü" aria-label="Telefon Görünümü">
            <i class="bi bi-phone"></i>
          </button>
          <button type="button" onclick="window.setMwViewMode && window.setMwViewMode('tablet')" class="btn btn-sm py-0.5 px-2 rounded-pill text-white-50 hover-text-white border-0" style="font-size:0.8rem;" title="Tablet Görünümü" aria-label="Tablet Görünümü">
            <i class="bi bi-tablet"></i>
          </button>
          <button type="button" onclick="window.setMwViewMode && window.setMwViewMode('desktop')" class="btn btn-sm py-0.5 px-2 rounded-pill bg-danger text-white fw-bold border-0" style="font-size:0.8rem;" title="Geniş Ekran Görünümü" aria-label="Geniş Ekran Görünümü">
            <i class="bi bi-display"></i>
          </button>
        </div>
        <a href="/hibe-kredi-eslesme" class="mw-toplink text-success fw-bold">
          <i class="bi bi-patch-check-fill me-1"></i>4 Katmanlı Resmi Hibe Radarı
        </a>
        <a href="/acil-durum" class="mw-toplink text-danger fw-bold">
          <i class="bi bi-exclamation-triangle-fill me-1"></i>Acil Durum Destek
        </a>
        <a href="/uye-ol" class="mw-toplink">
          <i class="bi bi-award-fill text-warning me-1"></i>PRO Üyelik Avantajları
        </a>
        <a href="/sss" class="mw-toplink" title="Sıkça Sorulan Sorular">
          <i class="bi bi-patch-question-fill text-info me-1"></i>SSS
        </a>
        <a href="/iletisim" class="mw-toplink" title="İletişim">
          <i class="bi bi-envelope-fill text-warning me-1"></i>İletişim
        </a>
      </div>
    </div>
  </div>

  <!-- Ana Navigasyon Barı -->
  <nav class="navbar navbar-expand-xl py-2">
    <div class="container-fluid px-lg-4">
      <!-- Dinamik MeetWork Logosu -->
      <a class="navbar-brand d-flex align-items-center me-3" href="/" aria-label="MeetWork Ana Sayfa">
        <span class="mw-logo-meet">Meet</span><span class="mw-logo-work">Work</span>
      </a>

      <!-- Site Geneli Hızlı Arama Çubuğu (Sosyal Medya, İlan, İhale, Talep, İşletme) -->
      <form class="mw-global-search d-none d-md-flex me-auto my-0" action="/arama" method="get" autocomplete="off">
        <div class="input-group input-group-sm">
          <span class="input-group-text border-end-0 bg-transparent text-danger">
            <i class="bi bi-search"></i>
          </span>
          <input
            type="search"
            name="q"
            id="mwGlobalSearchInput"
            class="form-control border-start-0 ps-0"
            placeholder="Arama yapın..."
            aria-label="Arama yapın"
          />
          <button class="btn btn-danger px-3 fw-semibold" type="submit">Ara</button>
        </div>
        <!-- Canlı Anlık Arama Sonuçları Kutusu -->
        <div id="mwLiveSearchDropdown" class="mw-search-dropdown p-2"></div>
      </form>

      <!-- Mobil Sağ Aksiyonlar (Görünüm Seçici, LED +, Bildirim Zili, Tema, Giriş/Profil & Hamburger) -->
      <div class="d-flex align-items-center gap-1 gap-sm-2 d-xl-none">
        <div class="d-inline-flex align-items-center bg-light border rounded-pill p-0.5 gap-0.5">
          <button type="button" onclick="window.setMwViewMode && window.setMwViewMode('mobile')" class="btn btn-sm py-0.5 px-2 rounded-pill text-dark border-0" style="font-size:0.78rem;" title="Telefon Görünümü" aria-label="Telefon Görünümü">
            <i class="bi bi-phone"></i>
          </button>
          <button type="button" onclick="window.setMwViewMode && window.setMwViewMode('tablet')" class="btn btn-sm py-0.5 px-2 rounded-pill text-secondary border-0" style="font-size:0.78rem;" title="Tablet Görünümü" aria-label="Tablet Görünümü">
            <i class="bi bi-tablet"></i>
          </button>
          <button type="button" onclick="window.setMwViewMode && window.setMwViewMode('desktop')" class="btn btn-sm py-0.5 px-2 rounded-pill bg-danger text-white border-0" style="font-size:0.78rem;" title="Geniş Ekran Görünümü" aria-label="Geniş Ekran Görünümü">
            <i class="bi bi-display"></i>
          </button>
        </div>
        <a href="/ilanlar?yeni=1" class="mw-led-plus-btn" title="İlan veya İhale Ver" aria-label="İlan veya İhale Ver">
          <i class="bi bi-plus-lg"></i>
        </a>
        <button type="button" class="btn btn-sm mw-theme-btn" id="mwThemeToggleMobile" aria-label="Tema Değiştir" title="Açık / Koyu Tema Değiştir">
          <span class="mw-theme-icon"><i class="bi bi-moon-stars-fill mw-moon-silver"></i></span>
        </button>

        <!-- Mobil Tekil Giriş / Profil Butonu (Giriş yoksa İkon+Giriş, Giriş varsa Sadece İkon + Alt Menü) -->
        <div class="dropdown">
          <a
            href="/giris"
            class="btn btn-sm btn-danger fw-bold px-2 d-inline-flex align-items-center gap-1 mw-unified-auth-btn"
            aria-expanded="false"
            title="Giriş / Profilim"
          >
            <i class="bi bi-person-circle fs-6 mw-auth-icon"></i>
            <span class="mw-auth-text">Giriş</span>
          </a>
          <div class="dropdown-menu dropdown-menu-end shadow-lg p-2" style="min-width: 245px; border-top: 3px solid var(--mw-red);">
            <div class="px-2 py-2 border-bottom mb-1" style="border-color:var(--mw-border)!important;">
              <div class="fw-bold small text-truncate mw-drop-company">İşletmem</div>
              <div class="text-muted text-truncate mw-drop-user" style="font-size:0.74rem;">Üye</div>
              <div class="mt-1 mw-drop-badge"></div>
            </div>
            <a class="dropdown-item rounded py-1 small fw-semibold mw-drop-profile-link" href="/isletmeler">
              <i class="bi bi-building text-danger me-2"></i>Profilim & İşletme Vitrini
            </a>
            <a class="dropdown-item rounded py-1 small fw-semibold" href="/akilli-eslesme">
              <i class="bi bi-magic text-danger me-2"></i>Akıllı Eşleşmelerim
            </a>
            <a class="dropdown-item rounded py-1 small fw-semibold" href="/hibe-kredi-eslesme">
              <i class="bi bi-cash-coin text-success me-2"></i>Hibe, Fon & Kredi Eşleşmesi
            </a>
            <a class="dropdown-item rounded py-1 small fw-semibold" href="/kariyer">
              <i class="bi bi-people-fill text-primary me-2"></i>Kariyer, İK & Yetenek Havuzu
            </a>
            <a class="dropdown-item rounded py-1 small fw-semibold" href="/kariyer/profilim">
              <i class="bi bi-person-badge-fill text-info me-2"></i>Aday Profilim & Başvurularım
            </a>
            <hr class="dropdown-divider my-1" />
            <a class="dropdown-item rounded py-1 small fw-semibold mw-sso-jump-link" href="https://stokpratik.com" data-sso-target="stokpratik">
              <i class="bi bi-box-seam text-danger me-2"></i>⚡ StokPratik ERP’ye Şifresiz Geç
            </a>
            <a class="dropdown-item rounded py-1 small fw-semibold mw-sso-jump-link" href="https://depodandirekt.com" data-sso-target="depodandirekt">
              <i class="bi bi-globe2 text-success me-2"></i>⚡ DepodanDirekt’e Şifresiz Geç
            </a>
            <button type="button" class="dropdown-item rounded py-1 small fw-semibold" data-bs-toggle="modal" data-bs-target="#mwChangePasswordModal">
              <i class="bi bi-key-fill text-warning me-2"></i>Şifre Değiştir
            </button>
            <a class="dropdown-item rounded py-1 small fw-bold text-danger mw-drop-admin-link" href="/yonetim" style="display:none;">
              <i class="bi bi-shield-lock-fill me-2"></i>SuperAdmin Paneli
            </a>
            <hr class="dropdown-divider my-1" />
            <button type="button" class="dropdown-item rounded py-1 small fw-bold text-danger mw-drop-logout-btn">
              <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
            </button>
          </div>
        </div>

        <button
          class="navbar-toggler border-0 p-1"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mwMainNavbar"
          aria-controls="mwMainNavbar"
          aria-expanded="false"
          aria-label="Menüyü Aç"
        >
          <i class="bi bi-list fs-2 text-danger"></i>
        </button>
      </div>

      <!-- Orta & Sağ Menü -->
      <div class="collapse navbar-collapse" id="mwMainNavbar">
        <!-- Mobil Arama Çubuğu -->
        <form class="d-md-none my-2" action="/arama" method="get">
          <div class="input-group input-group-sm">
            <input type="search" name="q" class="form-control" placeholder="Arama yapın..." />
            <button class="btn btn-danger fw-bold" type="submit"><i class="bi bi-search"></i> Ara</button>
          </div>
        </form>

        <ul class="navbar-nav mx-auto mb-2 mb-xl-0 align-items-xl-center gap-xl-1">
          <li class="nav-item">
            <a class={`nav-link mw-nav-pill ${currentPath === '/' ? 'active' : ''}`} href="/">
              <i class="bi bi-compass-fill text-danger"></i> Keşfet
            </a>
          </li>
          <li class="nav-item">
            <a class={`nav-link mw-nav-pill ${currentPath.startsWith('/ilanlar') ? 'active' : ''}`} href="/ilanlar">
              <i class="bi bi-shop-window text-danger"></i> İlanlar
            </a>
          </li>
          <li class="nav-item">
            <a class={`nav-link mw-nav-pill ${currentPath.startsWith('/ihaleler') || currentPath.startsWith('/talepler') ? 'active' : ''}`} href="/ihaleler">
              <i class="bi bi-hammer text-danger"></i> E-İhale
            </a>
          </li>
          <li class="nav-item">
            <a class={`nav-link mw-nav-pill ${currentPath.startsWith('/akilli-eslesme') ? 'active' : ''}`} href="/akilli-eslesme">
              <i class="bi bi-diagram-3-fill text-danger"></i> Akıllı Eşleşme
            </a>
          </li>
          <li class="nav-item">
            <a class={`nav-link mw-nav-pill ${currentPath.startsWith('/kariyer') ? 'active' : ''}`} href="/kariyer">
              <i class="bi bi-people-fill text-danger"></i> Kariyer & İK
            </a>
          </li>
          <li class="nav-item">
            <a class={`nav-link mw-nav-pill ${currentPath.startsWith('/isletmeler') ? 'active' : ''}`} href="/isletmeler">
              <i class="bi bi-buildings-fill text-danger"></i> Vitrin
            </a>
          </li>

          <!-- İşleyiş Mega Dropdown (Sayfaya Tam Sığan Kompakt ve Kaydırılabilir Yapı) -->
          <li class="nav-item dropdown">
            <a
              class="nav-link mw-nav-pill dropdown-toggle"
              href="#"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <i class="bi bi-info-circle-fill text-danger"></i> İşleyiş
            </a>
            <div class="dropdown-menu dropdown-menu-end mw-mega-dropdown shadow-lg p-3">
              <div class="row g-2" style="min-width: 660px; max-width: 90vw;">
                {menuItems.filter(m => m.subItems && m.subItems.length > 0).map((group) => (
                  <div class="col-md-4 col-sm-6">
                    <div class="fw-bold text-danger small text-uppercase mb-1 border-bottom pb-1" style="font-size:0.75rem;">
                      {group.icon && <i class={`${group.icon} me-1`}></i>} {group.title}
                    </div>
                    <ul class="list-unstyled mb-1">
                      {group.subItems!.slice(0, 7).map((sub) => (
                        <li>
                          <a class="dropdown-item py-1 px-2 rounded" href={sub.url} target={sub.target}>
                            {sub.title}
                          </a>
                        </li>
                      ))}
                      {group.title === 'Sektörler' && (
                        <li>
                          <a class="dropdown-item py-1 px-2 rounded fw-bold text-danger" href="/sektorler">
                            Tüm 37 Sektörü Gör →
                          </a>
                        </li>
                      )}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </li>

          <!-- Mobil Görünümde Normal Yazılı Hızlı Ekle ve Üst Bar Linkleri -->
          <li class="nav-item d-xl-none mt-2 pt-2 border-top">
            <div class="d-grid gap-2">
              <a href="/ilanlar?yeni=1" class="btn btn-danger btn-sm fw-bold">
                <i class="bi bi-plus-circle me-1"></i> + Hızlı Oluştur (İlan / İhale / İK)
              </a>
              <div class="d-flex flex-wrap gap-2 small pt-1">
                <a href="/acil-durum" class="text-danger fw-bold text-decoration-none">Acil Durum Destek</a> •
                <a href="/uye-ol" class="text-muted text-decoration-none">PRO Üyelik</a> •
                <a href="/sss" class="text-muted text-decoration-none">SSS</a> •
                <a href="/iletisim" class="text-muted text-decoration-none">İletişim</a>
              </div>
            </div>
          </li>
        </ul>

        <!-- Masaüstü Sağ Aksiyon Butonları: Yanıp Sönen LED + Hızlı Oluştur, Ortak Bildirim Zili, Tema İkonu, Giriş/Profil İkonu -->
        <div class="d-none d-xl-flex align-items-center gap-2 ms-2">
          <div class="dropdown">
            <a
              href="/ilanlar?yeni=1"
              class="mw-led-plus-btn"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              title="+ Hızlı Oluştur: İhale / İlan / Personel İlanı / Hikaye"
              aria-label="Hızlı Oluştur"
            >
              <i class="bi bi-plus-lg"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-danger p-2" style="min-width: 245px;">
              <li class="px-2 py-1 small fw-bold text-danger border-bottom mb-1">+ Hızlı Oluştur Menüsü</li>
              <li>
                <a class="dropdown-item rounded py-2 fw-semibold small" href="/ihaleler?yeni=1">
                  <i class="bi bi-hammer text-danger me-2"></i>Yeni Alım İhalesi / Talep Aç
                </a>
              </li>
              <li>
                <a class="dropdown-item rounded py-2 fw-semibold small" href="/talepler">
                  <i class="bi bi-people-fill text-success me-2"></i>Birlikte Alalım Havuzuna Katıl
                </a>
              </li>
              <li>
                <a class="dropdown-item rounded py-2 fw-semibold small" href="/ilanlar?yeni=1">
                  <i class="bi bi-shop text-danger me-2"></i>Ücretsiz Fırsat / Demirbaş İlanı Ver
                </a>
              </li>
              <li>
                <a class="dropdown-item rounded py-2 fw-semibold small" href="/kariyer">
                  <i class="bi bi-search text-primary me-2"></i>Doğrulanmış Adayı Bulun (İK)
                </a>
              </li>
              <li>
                <a class="dropdown-item rounded py-2 fw-semibold small" href="/kariyer/cv-olustur">
                  <i class="bi bi-person-vcard-fill text-success me-2"></i>İş Arıyorum / Özgeçmiş (CV) Oluştur
                </a>
              </li>
              <li>
                <a class="dropdown-item rounded py-2 fw-semibold small" href="/#mwQuickPostContent">
                  <i class="bi bi-chat-square-text text-warning me-2"></i>Sosyal Akışta & Hikaye Paylaş
                </a>
              </li>
            </ul>
          </div>

          <!-- 🔔 Ortak Ekosistem Bildirim & CariNet e-Mutabakat Zili -->
          <div class="dropdown">
            <button
              type="button"
              class="btn btn-sm mw-theme-btn position-relative"
              id="mwEcosystemBellBtn"
              data-bs-toggle="dropdown"
              data-bs-auto-close="outside"
              aria-expanded="false"
              title="Ortak Ekosistem Bildirimleri & CariNet e-Mutabakat Onayı"
            >
              <i class="bi bi-bell-fill text-danger"></i>
              <span
                id="mwEcosystemBellCount"
                class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                style="font-size: 0.62rem;"
              >
                4
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-end shadow-lg p-2" style="width: 375px; max-width: 92vw; border-top: 3px solid var(--mw-red);">
              <div class="d-flex justify-content-between align-items-center px-2 py-1 border-bottom mb-2">
                <span class="fw-bold small text-danger"><i class="bi bi-bell-fill me-1"></i>Üçlü Ekosistem & CariNet Bildirimleri</span>
                <span class="badge bg-success-subtle text-success" style="font-size:0.65rem;">Canlı Senkron</span>
              </div>
              <div id="mwEcosystemNotificationsList" style="max-height: 360px; overflow-y: auto;">
                <div class="text-center text-muted small py-3">Bildirimler yükleniyor...</div>
              </div>
              <div class="border-top pt-2 mt-1 d-flex justify-content-between px-2 small">
                <a href="https://stokpratik.com" data-sso-target="stokpratik" class="text-danger fw-bold text-decoration-none mw-sso-jump-link">
                  ⚡ StokPratik ERP’ye Geç
                </a>
                <a href="https://depodandirekt.com" data-sso-target="depodandirekt" class="text-success fw-bold text-decoration-none mw-sso-jump-link">
                  ⚡ DepodanDirekt’e Geç
                </a>
              </div>
            </div>
          </div>

          <button
            type="button"
            class="btn btn-sm mw-theme-btn"
            id="mwThemeToggleDesktop"
            aria-label="Açık / Koyu Tema Değiştir"
            title="Açık / Koyu Tema Değiştir"
          >
            <span class="mw-theme-icon"><i class="bi bi-moon-stars-fill mw-moon-silver"></i></span>
          </button>

          <!-- Masaüstü Tekil Giriş / Profil Butonu -->
          <div class="dropdown">
            <a
              href="/giris"
              class="btn btn-sm btn-danger fw-bold px-3 d-inline-flex align-items-center gap-2 mw-unified-auth-btn"
              aria-expanded="false"
              title="Giriş / Profil Menüsü"
            >
              <i class="bi bi-person-circle fs-6 mw-auth-icon"></i>
              <span class="mw-auth-text">Giriş</span>
            </a>
            <div class="dropdown-menu dropdown-menu-end shadow-lg p-2" style="min-width: 265px; border-top: 3px solid var(--mw-red);">
              <div class="px-3 py-2 border-bottom mb-1" style="border-color:var(--mw-border)!important;">
                <div class="fw-bold small text-truncate mw-drop-company">İşletmem</div>
                <div class="text-muted text-truncate mw-drop-user" style="font-size:0.74rem;">Üye</div>
                <div class="mt-1 mw-drop-badge"></div>
              </div>
              <a class="dropdown-item rounded py-2 small fw-semibold" href="/profilim">
                <i class="bi bi-person-gear text-danger me-2"></i>Profilim & Paylaşım Merkezim
              </a>
              <a class="dropdown-item rounded py-2 small fw-semibold mw-drop-profile-link" href="/isletmeler">
                <i class="bi bi-building-fill-check text-danger me-2"></i>İşletme Vitrinim
              </a>
              <a class="dropdown-item rounded py-2 small fw-semibold" href="/akilli-eslesme">
                <i class="bi bi-magic text-danger me-2"></i>Akıllı Eşleşmelerim
              </a>
              <a class="dropdown-item rounded py-2 small fw-semibold" href="/hibe-kredi-eslesme">
                <i class="bi bi-cash-coin text-success me-2"></i>Hibe, Fon & Kredi Eşleşmesi
              </a>
              <a class="dropdown-item rounded py-2 small fw-semibold" href="/kariyer">
                <i class="bi bi-people-fill text-primary me-2"></i>Kariyer, İK & Yetenek Havuzu
              </a>
              <a class="dropdown-item rounded py-2 small fw-semibold" href="/kariyer/profilim">
                <i class="bi bi-person-badge-fill text-info me-2"></i>Aday Profilim & Başvurularım
              </a>
              <hr class="dropdown-divider my-1" />
              <div class="px-3 py-1 text-muted fw-bold" style="font-size:0.68rem;">⚡ TEK TIKLA ŞİFRESİZ GEÇİŞ</div>
              <a class="dropdown-item rounded py-2 small fw-semibold mw-sso-jump-link" href="https://stokpratik.com" data-sso-target="stokpratik">
                <i class="bi bi-box-seam text-danger me-2"></i>StokPratik ERP & CariNet’e Geç
              </a>
              <a class="dropdown-item rounded py-2 small fw-semibold mw-sso-jump-link" href="https://depodandirekt.com" data-sso-target="depodandirekt">
                <i class="bi bi-globe2 text-success me-2"></i>DepodanDirekt Toptan’a Geç
              </a>
              <hr class="dropdown-divider my-1" />
              <button type="button" class="dropdown-item rounded py-2 small fw-semibold" data-bs-toggle="modal" data-bs-target="#mwChangePasswordModal">
                <i class="bi bi-key-fill text-warning me-2"></i>Şifre Değiştir
              </button>
              <a class="dropdown-item rounded py-2 small fw-bold text-danger mw-drop-admin-link" href="/yonetim" style="display:none;">
                <i class="bi bi-shield-lock-fill me-2"></i>SuperAdmin Yönetim Paneli
              </a>
              <hr class="dropdown-divider my-1" />
              <button type="button" class="dropdown-item rounded py-2 small fw-bold text-danger mw-drop-logout-btn">
                <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<!-- Şifre Değiştir Modalı -->
<div class="modal fade" id="mwChangePasswordModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content mw-panel-card border-danger">
      <div class="modal-header border-bottom py-2" style="border-color:var(--mw-border)!important;">
        <h6 class="modal-title fw-bold"><i class="bi bi-key-fill text-warning me-1"></i> Şifre Değiştir</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <div class="modal-body">
        <form id="mwChangePasswordForm">
          <div class="mb-2">
            <label class="form-label small fw-semibold mb-1">Mevcut Şifreniz</label>
            <input type="password" id="mwOldPassword" class="form-control form-control-sm" required />
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold mb-1">Yeni Şifreniz</label>
            <input type="password" id="mwNewPassword" class="form-control form-control-sm" minlength="4" required />
          </div>
          <div id="mwPasswordFeedback" class="small mb-2" style="display:none;"></div>
          <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">Şifremi Güncelle</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'mw_theme_v2';
    const USER_KEY = 'mw_user';
    const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.setAttribute('data-bs-theme', theme);
      const icons = document.querySelectorAll('.mw-theme-icon');
      icons.forEach((el) => {
        if (theme === 'dark') {
          el.innerHTML = '<i class="bi bi-sun-fill mw-sun-glow"></i>';
        } else {
          el.innerHTML = '<i class="bi bi-moon-stars-fill mw-moon-silver"></i>';
        }
      });
    }

    function getBadgeHtml(level) {
      if (Number(level) >= 3) return '<span class="mw-trust-badge-3"><i class="bi bi-patch-check-fill"></i> Gold Onaylı</span>';
      if (Number(level) === 2) return '<span class="mw-trust-badge-2"><i class="bi bi-shield-check"></i> Silver / VKN Onaylı</span>';
      return '<span class="mw-trust-badge-1"><i class="bi bi-check-circle"></i> Kayıtlı Üye</span>';
    }

    const savedTheme = localStorage.getItem(STORAGE_KEY) || 'light';
    applyTheme(savedTheme);

    document.addEventListener('DOMContentLoaded', () => {
      applyTheme(localStorage.getItem(STORAGE_KEY) || 'light');

      const toggleTheme = () => {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        localStorage.setItem(STORAGE_KEY, next);
        applyTheme(next);
      };

      const btnDesktop = document.getElementById('mwThemeToggleDesktop');
      const btnMobile = document.getElementById('mwThemeToggleMobile');
      if (btnDesktop) btnDesktop.addEventListener('click', toggleTheme);
      if (btnMobile) btnMobile.addEventListener('click', toggleTheme);

      // Giriş Durumu: Tek Buton -> Giriş yapılmışsa "Giriş" yazısı kalkar, sadece User İkonu kalır ve tıklayınca mini menü açılır
      try {
        const rawUser = localStorage.getItem(USER_KEY);
        if (rawUser) {
          const user = JSON.parse(rawUser);
          if (user && (user.email || user.user_id || user.id)) {
            document.querySelectorAll('.mw-unified-auth-btn').forEach(btn => {
              btn.setAttribute('href', '#');
              btn.setAttribute('data-bs-toggle', 'dropdown');
              btn.classList.remove('px-3', 'px-2', 'gap-2', 'gap-1');
              btn.classList.add('rounded-circle', 'p-0', 'justify-content-center');
              btn.style.width = '38px';
              btn.style.height = '38px';
              const textSpan = btn.querySelector('.mw-auth-text');
              if (textSpan) textSpan.remove();
              const iconEl = btn.querySelector('.mw-auth-icon');
              if (iconEl) {
                iconEl.className = 'bi bi-person-circle fs-5 mw-auth-icon';
              }
            });

            document.querySelectorAll('.mw-drop-company').forEach(el => {
              el.textContent = user.role === 'candidate'
                ? '👤 İş Arayan / Uzman Aday'
                : (user.company_name || 'Kurumsal İşletmem');
            });
            document.querySelectorAll('.mw-drop-user').forEach(el => {
              el.textContent = `${user.full_name || ''} (${user.email || ''})`;
            });
            document.querySelectorAll('.mw-drop-badge').forEach(el => {
              el.innerHTML = user.role === 'candidate'
                ? '<span class="badge bg-success-subtle text-success border border-success">✓ Doğrulanmış Aday</span>'
                : getBadgeHtml(user.trust_level || 2);
            });
            document.querySelectorAll('.mw-drop-profile-link').forEach(el => {
              if (user.role === 'candidate') {
                el.setAttribute('href', '/kariyer/profilim');
                el.innerHTML = '<i class="bi bi-person-badge-fill text-info me-2"></i>Aday Profilim & Başvurularım';
              } else if (user.company_slug) {
                el.setAttribute('href', `/isletmeler?firma=${encodeURIComponent(user.company_slug)}`);
              }
            });
            if (user.role === 'superadmin') {
              document.querySelectorAll('.mw-drop-admin-link').forEach(el => {
                el.style.display = 'block';
              });
            }
          }
        }
      } catch (_) {}

      // Çıkış Yap Aksiyonu
      document.querySelectorAll('.mw-drop-logout-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          localStorage.removeItem(USER_KEY);
          localStorage.removeItem('mw_token');
          window.location.href = '/';
        });
      });

      // Şifre Değiştir Formu
      const pwdForm = document.getElementById('mwChangePasswordForm');
      if (pwdForm) {
        pwdForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const oldPass = document.getElementById('mwOldPassword').value;
          const newPass = document.getElementById('mwNewPassword').value;
          const fb = document.getElementById('mwPasswordFeedback');
          let user = null;
          try { user = JSON.parse(localStorage.getItem(USER_KEY) || 'null'); } catch (_) {}

          if (!user) return;
          try {
            const res = await fetch(`${API_URL}/api/auth/change-password`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                user_id: user.user_id,
                email: user.email,
                current_password: oldPass,
                new_password: newPass
              })
            });
            const data = await res.json();
            if (fb) {
              fb.style.display = 'block';
              fb.className = `small mb-2 fw-bold ${data.success ? 'text-success' : 'text-danger'}`;
              fb.textContent = data.message || (data.success ? 'Şifreniz güncellendi.' : 'Hata oluştu.');
            }
            if (data.success) {
              pwdForm.reset();
            }
          } catch (_) {}
        });
      }

      // Canlı Site Geneli Arama Önizlemesi
      const searchInput = document.getElementById('mwGlobalSearchInput');
      const dropdown = document.getElementById('mwLiveSearchDropdown');
      let searchCache = null;

      async function ensureSearchCache() {
        if (searchCache) return searchCache;
        try {
          const res = await fetch(`${API_URL}/api/feed`);
          searchCache = await res.json();
        } catch (_) {
          searchCache = {};
        }
        return searchCache;
      }

      if (searchInput && dropdown) {
        searchInput.addEventListener('input', async () => {
          const q = searchInput.value.trim().toLocaleLowerCase('tr-TR');
          if (q.length < 2) {
            dropdown.style.display = 'none';
            return;
          }

          const data = await ensureSearchCache();
          const posts = (data.posts || []).filter(p =>
            String(p.content || '').toLocaleLowerCase('tr-TR').includes(q) ||
            String(p.company_name || '').toLocaleLowerCase('tr-TR').includes(q)
          ).slice(0, 3);

          const listings = (data.vitrinListings || []).filter(l =>
            String(l.title || '').toLocaleLowerCase('tr-TR').includes(q) ||
            String(l.main_category || '').toLocaleLowerCase('tr-TR').includes(q) ||
            String(l.listing_no || '').toLocaleLowerCase('tr-TR').includes(q)
          ).slice(0, 3);

          const tenders = (data.activeTenders || []).filter(t =>
            String(t.title || '').toLocaleLowerCase('tr-TR').includes(q) ||
            String(t.sector || '').toLocaleLowerCase('tr-TR').includes(q)
          ).slice(0, 3);

          const companies = (data.featuredCompanies || []).filter(c =>
            String(c.name || '').toLocaleLowerCase('tr-TR').includes(q) ||
            String(c.sector || '').toLocaleLowerCase('tr-TR').includes(q)
          ).slice(0, 3);

          const htmlParts = [];

          if (listings.length > 0) {
            htmlParts.push(`<div class="small fw-bold text-danger px-2 py-1">🏪 İlanlar</div>`);
            listings.forEach(item => {
              htmlParts.push(`
                <a href="/ilanlar?ilan=${encodeURIComponent(item.slug || item.listing_no)}" class="dropdown-item rounded small py-1 text-truncate">
                  <strong>${item.title}</strong> <span class="text-muted">• ${Number(item.price).toLocaleString('tr-TR')} ${item.currency}</span>
                </a>
              `);
            });
          }

          if (tenders.length > 0) {
            htmlParts.push(`<div class="small fw-bold text-danger px-2 py-1 mt-1">⚖️ E-İhaleler</div>`);
            tenders.forEach(t => {
              htmlParts.push(`
                <a href="/ihaleler" class="dropdown-item rounded small py-1 text-truncate">
                  <strong>${t.title}</strong> <span class="text-muted">• ${t.tender_type || 'İhale'}</span>
                </a>
              `);
            });
          }

          if (companies.length > 0) {
            htmlParts.push(`<div class="small fw-bold text-danger px-2 py-1 mt-1">🏢 Vitrin & İşletmeler</div>`);
            companies.forEach(c => {
              htmlParts.push(`
                <a href="/isletmeler?firma=${encodeURIComponent(c.slug)}" class="dropdown-item rounded small py-1 text-truncate">
                  <strong>${c.name}</strong> <span class="text-muted">• ${c.sector}</span>
                </a>
              `);
            });
          }

          if (posts.length > 0) {
            htmlParts.push(`<div class="small fw-bold text-danger px-2 py-1 mt-1">💬 Sosyal Akış</div>`);
            posts.forEach(p => {
              htmlParts.push(`
                <a href="/" class="dropdown-item rounded small py-1 text-truncate">
                  <strong>${p.company_name || p.author_name}:</strong> ${p.content}
                </a>
              `);
            });
          }

          htmlParts.push(`
            <div class="border-top mt-1 pt-1">
              <a href="/arama?q=${encodeURIComponent(searchInput.value.trim())}" class="dropdown-item rounded small fw-bold text-danger text-center py-1">
                <i class="bi bi-search me-1"></i> "${searchInput.value.trim()}" için tüm sitede (3100+ talep dahil) ara →
              </a>
            </div>
          `);

          dropdown.innerHTML = htmlParts.join('');
          dropdown.style.display = 'block';
        });

        document.addEventListener('click', (e) => {
          if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.style.display = 'none';
          }
        });
      }

      // 🔔 Ortak Ekosistem Bildirim Zili & CariNet Tek Tıkla e-Mutabakat Onayı
      const notifListEl = document.getElementById('mwEcosystemNotificationsList');
      const notifCountEl = document.getElementById('mwEcosystemBellCount');

      async function loadEcosystemNotifications() {
        if (!notifListEl) return;
        let currentUser = null;
        try { currentUser = JSON.parse(localStorage.getItem(USER_KEY) || 'null'); } catch (_) {}
        const compId = (currentUser && currentUser.company_id) || 'comp_meetwork_hq';

        try {
          const res = await fetch(`${API_URL}/api/bridge/notifications?company_id=${encodeURIComponent(compId)}`);
          const data = await res.json();
          const items = data.notifications || [];
          const unread = Number(data.unread_count ?? items.length);
          if (notifCountEl) {
            notifCountEl.textContent = String(unread);
            notifCountEl.style.display = unread > 0 ? 'inline-block' : 'none';
          }

          if (items.length === 0) {
            notifListEl.innerHTML = `<div class="text-center text-muted small py-3">Yeni ekosistem bildirimi bulunmuyor.</div>`;
            return;
          }

          notifListEl.innerHTML = items.map(n => {
            const isMutabakat = n.action_type === 'approve_mutabakat' && Number(n.is_read) === 0;
            return `
              <div class="p-2 mb-2 rounded border ${Number(n.is_read) === 0 ? 'border-danger-subtle bg-danger-subtle bg-opacity-10' : ''}" style="font-size:0.78rem;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="badge bg-dark text-white" style="font-size:0.63rem;">${n.source_app || 'MeetWork Ekosistem'}</span>
                  <span class="text-muted" style="font-size:0.65rem;">${Number(n.is_read) === 0 ? '🟢 Yeni' : '✓ İşlendi'}</span>
                </div>
                <div class="fw-bold mb-1">${n.title}</div>
                <div class="text-muted mb-2" style="font-size:0.73rem;">${n.message}</div>
                ${isMutabakat ? `
                  <button type="button" class="btn btn-success btn-sm w-100 fw-bold py-1 mw-approve-mutabakat-btn" data-notif-id="${n.id}" style="font-size:0.74rem;">
                    ${n.action_label || '✅ Bakiyeyi Onayla (Mutabıkız)'}
                  </button>
                ` : `
                  <a href="${n.action_url || '#'}" class="btn btn-outline-danger btn-sm w-100 fw-semibold py-1" style="font-size:0.73rem;">
                    ${n.action_label || 'Detayı Gör →'}
                  </a>
                `}
              </div>
            `;
          }).join('');

          notifListEl.querySelectorAll('.mw-approve-mutabakat-btn').forEach(btn => {
            btn.addEventListener('click', async (ev) => {
              ev.preventDefault();
              ev.stopPropagation();
              const nid = btn.getAttribute('data-notif-id');
              btn.disabled = true;
              btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Zaman Damgasıyla Onaylanıyor...';
              try {
                const r = await fetch(`${API_URL}/api/bridge/e-mutabakat-approve`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ notification_id: nid })
                });
                const d = await r.json();
                alert(d.message || 'Cari e-Mutabakat onaylandı!');
                await loadEcosystemNotifications();
              } catch (_) {
                btn.disabled = false;
              }
            });
          });
        } catch (_) {}
      }

      loadEcosystemNotifications();

      // ⚡ Tek Tıkla Şifresiz Geçiş (MeetWork -> StokPratik / DepodanDirekt)
      document.querySelectorAll('.mw-sso-jump-link').forEach(link => {
        link.addEventListener('click', async (e) => {
          const targetApp = link.getAttribute('data-sso-target') || 'stokpratik';
          let currentUser = null;
          try { currentUser = JSON.parse(localStorage.getItem(USER_KEY) || 'null'); } catch (_) {}
          if (!currentUser || !currentUser.email) return; // Giriş yapmamışsa doğrudan linke gitsin
          e.preventDefault();
          try {
            const res = await fetch(`${API_URL}/api/auth/sso-exchange`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                source_app: 'meetwork',
                target_app: targetApp,
                email: currentUser.email,
                vkn: currentUser.vkn || '2720912021',
                company_name: currentUser.company_name || 'MeetWork Üye İşletme',
                full_name: currentUser.full_name || 'Firma Yetkilisi'
              })
            });
            const data = await res.json();
            if (data.success && data.auto_login_url) {
              window.open(data.auto_login_url, '_blank');
            } else {
              window.open(link.getAttribute('href'), '_blank');
            }
          } catch (_) {
            window.open(link.getAttribute('href'), '_blank');
          }
        });
      });
    });
  })();
</script>