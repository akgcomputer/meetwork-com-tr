---
const platformLinks = [
  { title: 'Keşfet & Sosyal İş Akışı', url: '/', icon: 'bi-activity' },
  { title: 'Akıllı Eşleşme', url: '/akilli-eslesme', icon: 'bi-magic' },
  { title: 'İlanlar (Emlak / Oto / Sanayi)', url: '/ilanlar', icon: 'bi-shop' },
  { title: 'E-İhale & Satın Alma Talepleri', url: '/ihaleler', icon: 'bi-hammer' },
  { title: 'Vitrin & Doğrulanmış İşletmeler', url: '/isletmeler', icon: 'bi-building-check' },
  { title: 'Ücretsiz Kayıt / Giriş Yap', url: '/giris', icon: 'bi-person-check-fill' }
];

const corporateAndEvents = [
  { title: 'MeetWork Nedir & Nasıl Çalışır?', url: '/meetwork-nedir' },
  { title: 'Mini & Maxi Yüz Yüze Toplantılar', url: '/etkinlik' },
  { title: 'Etkinlik Takvimi', url: '/etkinlik-takvimi' },
  { title: 'Türkiye & Dünya Temsilcilikleri', url: '/meetwork-temsilciler-turkiye' },
  { title: 'Tüm Sektör Grupları (37 Sektör)', url: '/sektorler' },
  { title: 'PRO Dijital Dönüşüm & Avantajlar', url: '/dijital-donusum' },
  { title: 'Ticaret Bakanlığı & İhracat Destekleri', url: '/ticaret-bakanligi-destekler' },
  { title: 'Acil Durum & Şirket Değerleme Merkezi', url: '/acil-durum' }
];

const ecosystemAndTools = [
  { title: 'StokPratik ERP & CariNet B2B', url: 'https://stokpratik.com.tr', external: true },
  { title: 'DepodanDirekt Toptan & İhracat', url: 'https://depodandirekt.com', external: true },
  { title: 'İŞTEP İştirakleri & Markalarımız', url: '/istirakler' },
  { title: 'Ticari Hesaplama & Komisyon Araçları', url: '/hesaplama' },
  { title: 'Sponsorluk & İş Birliği', url: '/sponsor-ol' },
  { title: 'Franchise Başvurusu', url: '/franchise' }
];

const legalPages = [
  { title: 'Gizlilik Politikası', url: '/bilgi-gizlilik-politikasi' },
  { title: 'Kullanım Koşulları', url: '/bilgi-kullanim-kosullari' },
  { title: 'KVKK Aydınlatma Metni', url: '/bilgi-kisisel-verilerin-korunmasi-ve-islenmesi-politikasi-aydinlatma-metni' },
  { title: 'KVKK Açık Rıza', url: '/bilgi-kvkk' }
];
---

<footer class="bg-dark text-white pt-5 pb-4 mt-5 border-top border-danger border-opacity-50">
  <div class="container">
    <div class="row g-4 pb-4">

      <!-- 1. Sütun: MeetWork Kurumsal Kimlik & Hızlı İletişim -->
      <div class="col-lg-3 col-md-6">
        <a href="/" class="text-decoration-none d-inline-flex align-items-center mb-3">
          <span class="mw-logo-meet">Meet</span><span class="text-white fw-black" style="font-weight:900;font-size:1.65rem;letter-spacing:-0.5px;">Work</span>
        </a>
        <p class="text-white-50 small mb-3" style="line-height: 1.6;">
          B2B Sosyal İş Ağı, Akıllı Eşleşme, Emlak/Vasıta/Sanayi İlan Pazarı, E-İhale ve StokPratik ERP / DepodanDirekt İhracat Ekosistemi.
        </p>

        <div class="d-flex flex-column gap-2 small">
          <a
            href="https://wa.me/905412465429?text=Merhaba,%20MeetWork%20hakkında%20bilgi%20almak%20istiyorum."
            target="_blank"
            class="text-white text-decoration-none d-inline-flex align-items-center gap-2"
          >
            <i class="bi bi-whatsapp text-success fs-6"></i>
            <span>WhatsApp Destek Hattı</span>
          </a>
          <a
            href="https://chat.whatsapp.com/KopePcksWpdKf3hQVv15vh"
            target="_blank"
            class="text-white text-decoration-none d-inline-flex align-items-center gap-2"
          >
            <i class="bi bi-people-fill text-warning fs-6"></i>
            <span>WhatsApp İş Ağı Duyuru Grubu</span>
          </a>
          <a
            href="https://whatsapp.com/channel/0029VbBefthHVvTdOqftD91i"
            target="_blank"
            class="text-white text-decoration-none d-inline-flex align-items-center gap-2"
          >
            <i class="bi bi-megaphone-fill text-danger fs-6"></i>
            <span>Resmi WhatsApp Kanalı</span>
          </a>
          <a
            href="/iletisim"
            class="text-white text-decoration-none d-inline-flex align-items-center gap-2"
          >
            <i class="bi bi-geo-alt-fill text-info fs-6"></i>
            <span>Kurumsal İletişim & Ofisler</span>
          </a>
        </div>
      </div>

      <!-- 2. Sütun: Platform & Ticaret Merkezi -->
      <div class="col-lg-3 col-md-6">
        <h6 class="text-uppercase fw-bold text-danger mb-3" style="font-size: 0.82rem; letter-spacing: 0.6px;">
          Platform & Ticaret
        </h6>
        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
          {platformLinks.map((item) => (
            <li>
              <a href={item.url} class="text-white-50 text-decoration-none small footer-min-link d-inline-flex align-items-center gap-2">
                <i class={`bi ${item.icon} text-danger`}></i>
                <span>{item.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 3. Sütun: Kurumsal İşleyiş, Etkinlikler & Rehberler -->
      <div class="col-lg-3 col-md-6">
        <h6 class="text-uppercase fw-bold text-danger mb-3" style="font-size: 0.82rem; letter-spacing: 0.6px;">
          Kurumsal & Etkinlikler
        </h6>
        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
          {corporateAndEvents.map((item) => (
            <li>
              <a href={item.url} class="text-white-50 text-decoration-none small footer-min-link">
                <i class="bi bi-chevron-right text-danger me-1" style="font-size: 0.7rem;"></i>
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 4. Sütun: Ekosistem & Yasal -->
      <div class="col-lg-3 col-md-6">
        <h6 class="text-uppercase fw-bold text-danger mb-3" style="font-size: 0.82rem; letter-spacing: 0.6px;">
          Ekosistem & Araçlar
        </h6>
        <ul class="list-unstyled d-flex flex-column gap-2 mb-3">
          {ecosystemAndTools.map((item) => (
            <li>
              <a
                href={item.url}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="text-white-50 text-decoration-none small footer-min-link"
              >
                <i class={`bi ${item.external ? 'bi-box-arrow-up-right text-danger' : 'bi-chevron-right text-danger'} me-1`} style="font-size: 0.72rem;"></i>
                {item.title}
              </a>
            </li>
          ))}
        </ul>

        <div class="p-2 rounded bg-black bg-opacity-50 border border-secondary border-opacity-25">
          <div class="small fw-bold text-white mb-1" style="font-size: 0.75rem;">
            <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i> Acil Ticari Destek
          </div>
          <a href="/acil-durum" class="small text-danger text-decoration-none fw-semibold" style="font-size: 0.73rem;">
            Acil Durum & Danışmanlık Talebi Aç →
          </a>
        </div>
      </div>

    </div>

    <!-- Alt Yasal & Telif Bandı -->
    <div class="pt-3 border-top border-secondary border-opacity-25 d-flex flex-column flex-lg-row justify-content-between align-items-center gap-2">
      <div class="small text-white-50 text-center text-lg-start">
        Vizyon 2030 © <strong>MeetWork Global</strong> • Türkiye Resmi Temsilciliği: <strong>İşte Birlik Platformu (İŞTEP)</strong>
      </div>
      <div class="d-flex flex-wrap justify-content-center gap-3">
        {legalPages.map((page) => (
          <a href={page.url} class="text-white-50 text-decoration-none footer-min-link" style="font-size: 0.75rem;">
            {page.title}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-min-link {
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .footer-min-link:hover {
    color: #ffffff !important;
    transform: translateX(2px);
  }
</style>