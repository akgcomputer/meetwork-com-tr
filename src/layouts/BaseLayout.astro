---
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.scss';

const isProduction = import.meta.env.PROD;

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'MeetWork ile iş dünyasında yeni bağlantılar kurun, sektörler arası iş birliklerini keşfedin.' } = Astro.props;
const currentPath = Astro.url.pathname;
const isAkis = currentPath === '/';
const isEslesme = currentPath.startsWith('/akilli-eslesme');
const isQr = currentPath.startsWith('/qr-kartvizit');
const isTicaret = currentPath.startsWith('/ihaleler') || currentPath.startsWith('/ihale-onay') || currentPath.startsWith('/talepler') || currentPath.startsWith('/ilanlar') || currentPath.startsWith('/isletmeler');
const isHibe = currentPath.startsWith('/hibe-kredi-eslesme');
---

<!DOCTYPE html>
<html lang="tr" data-theme="light" data-bs-theme="light" data-mw-view="desktop">
<head>
  <meta charset="UTF-8">
  <meta id="mwViewportMeta" name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content={description}>

  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NTZGM3S4');</script>
  <!-- End Google Tag Manager -->

  <!-- MeetWork B2B Intelligence & Commerce Engine Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

  <!-- Tailwind CSS with Preflight Disabled (Zero collision with existing Bootstrap desktop layout) -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline id="tailwind-config">
    tailwind.config = {
      corePlugins: { preflight: false },
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "border-light": "#e2e8f0",
            "secondary-container": "#e21e49",
            "on-secondary-container": "#fffbff",
            "tertiary-fixed-dim": "#4edea3",
            "surface-variant": "#d3e4fe",
            "on-error-container": "#93000a",
            "surface-container-lowest": "#ffffff",
            "error-container": "#ffdad6",
            "on-secondary-fixed-variant": "#920028",
            "surface-container-high": "#dce9ff",
            "primary-fixed": "#dae2fd",
            "cherry-hover": "#be123c",
            "primary-container": "#131b2e",
            "border-subtle": "#f1f5f9",
            "inverse-on-surface": "#eaf1ff",
            "surface-container-highest": "#d3e4fe",
            "error": "#ba1a1a",
            "on-primary-fixed-variant": "#3f465c",
            "on-surface-variant": "#45464d",
            "outline": "#76777d",
            "trust-emerald": "#10b981",
            "on-secondary": "#ffffff",
            "gold-badge": "#f59e0b",
            "on-surface": "#0b1c30",
            "navy-deep": "#0f172a",
            "cherry-vibrant": "#e11d48",
            "on-tertiary-container": "#009668",
            "primary": "#000000",
            "on-tertiary-fixed": "#002113",
            "outline-variant": "#c6c6cd",
            "surface-card": "#ffffff",
            "surface-bg": "#f8fafc",
            "inverse-surface": "#213145",
            "surface": "#f8f9ff",
            "secondary": "#ba0035",
            "on-error": "#ffffff",
            "on-tertiary": "#ffffff",
            "surface-bright": "#f8f9ff",
            "tertiary-container": "#002113",
            "surface-container": "#e5eeff",
            "secondary-fixed": "#ffdada",
            "on-secondary-fixed": "#40000c",
            "inverse-primary": "#bec6e0",
            "surface-tint": "#565e74",
            "surface-dim": "#cbdbf5",
            "on-background": "#0b1c30",
            "on-primary": "#ffffff",
            "surface-container-low": "#eff4ff",
            "tertiary": "#000000",
            "on-primary-fixed": "#131b2e",
            "secondary-fixed-dim": "#ffb3b6",
            "background": "#f8f9ff",
            "tertiary-fixed": "#6ffbbe",
            "on-primary-container": "#7c839b",
            "on-tertiary-fixed-variant": "#005236",
            "primary-fixed-dim": "#bec6e0"
          },
          borderRadius: {
            DEFAULT: "0.25rem",
            lg: "0.5rem",
            xl: "0.75rem",
            full: "9999px"
          },
          spacing: {
            "gutter-desktop": "1.5rem",
            "space-xs": "0.25rem",
            "space-sm": "0.5rem",
            "space-md": "1rem",
            "space-xl": "2rem",
            "space-lg": "1.5rem",
            "space-2xl": "3rem",
            "margin": "1rem",
            "margin-desktop": "2rem",
            "gutter": "1rem",
            "margin-tablet": "1.5rem"
          },
          fontFamily: {
            "body-sm": ["Inter", "sans-serif"],
            "headline-xl": ["Plus Jakarta Sans", "sans-serif"],
            "display-lg": ["Plus Jakarta Sans", "sans-serif"],
            "headline-md": ["Plus Jakarta Sans", "sans-serif"],
            "headline-lg": ["Plus Jakarta Sans", "sans-serif"],
            "headline-sm": ["Plus Jakarta Sans", "sans-serif"],
            "label-sm": ["Plus Jakarta Sans", "sans-serif"],
            "display-lg-mobile": ["Plus Jakarta Sans", "sans-serif"],
            "body-md": ["Inter", "sans-serif"],
            "label-lg": ["Plus Jakarta Sans", "sans-serif"],
            "metric-number": ["Plus Jakarta Sans", "sans-serif"],
            "label-md": ["Plus Jakarta Sans", "sans-serif"],
            "body-lg": ["Inter", "sans-serif"],
            "headline-xl-mobile": ["Plus Jakarta Sans", "sans-serif"]
          },
          fontSize: {
            "body-sm": ["12px", { lineHeight: "18px", fontWeight: "400" }],
            "headline-xl": ["32px", { lineHeight: "40px", fontWeight: "700" }],
            "display-lg": ["48px", { lineHeight: "56px", fontWeight: "800" }],
            "headline-md": ["20px", { lineHeight: "28px", fontWeight: "600" }],
            "headline-lg": ["24px", { lineHeight: "32px", fontWeight: "700" }],
            "headline-sm": ["16px", { lineHeight: "24px", fontWeight: "600" }],
            "label-sm": ["10px", { lineHeight: "14px", fontWeight: "700" }],
            "display-lg-mobile": ["32px", { lineHeight: "40px", fontWeight: "800" }],
            "body-md": ["14px", { lineHeight: "20px", fontWeight: "400" }],
            "label-lg": ["14px", { lineHeight: "20px", fontWeight: "600" }],
            "metric-number": ["28px", { lineHeight: "32px", fontWeight: "800" }],
            "label-md": ["12px", { lineHeight: "16px", fontWeight: "600" }],
            "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
            "headline-xl-mobile": ["24px", { lineHeight: "32px", fontWeight: "700" }]
          }
        }
      }
    };
  </script>

  <!-- Girişte Cihaz Algılama & Görünüm Modu (Telefon / Tablet / Geniş Ekran) -->
  <script is:inline>
    (function () {
      try {
        var urlParams = new URLSearchParams(window.location.search);
        var forcedMode = urlParams.get('gorunum');
        var manualMode = sessionStorage.getItem('mw_view_mode_manual');
        var detectedMode = 'desktop';
        if (forcedMode === 'mobile' || forcedMode === 'tablet' || forcedMode === 'desktop') {
          detectedMode = forcedMode;
          sessionStorage.setItem('mw_view_mode_manual', forcedMode);
          localStorage.setItem('mw_view_mode', forcedMode);
        } else if (manualMode === 'mobile' || manualMode === 'tablet' || manualMode === 'desktop') {
          detectedMode = manualMode;
        } else {
          var w = window.innerWidth || document.documentElement.clientWidth || 1200;
          if (w < 768) {
            detectedMode = 'mobile';
          } else if (w <= 1024) {
            detectedMode = 'tablet';
          } else {
            detectedMode = 'desktop';
          }
        }
        document.documentElement.setAttribute('data-mw-view', detectedMode);
      } catch (e) {}
    })();
  </script>

  <style is:global>
    /* Scoped Preflight Reset for MeetWork B2B Mobile/Tablet Engine */
    :where(.mw-b2b-scope),
    :where(.mw-b2b-scope) *,
    :where(.mw-b2b-scope) ::before,
    :where(.mw-b2b-scope) ::after {
      box-sizing: border-box;
      border-width: 0;
      border-style: solid;
      border-color: #e2e8f0;
    }
    :where(.mw-b2b-scope) a {
      color: inherit;
      text-decoration: none;
    }
    :where(.mw-b2b-scope) h1,
    :where(.mw-b2b-scope) h2,
    :where(.mw-b2b-scope) h3,
    :where(.mw-b2b-scope) h4,
    :where(.mw-b2b-scope) p {
      margin: 0;
    }
    :where(.mw-b2b-scope) button,
    :where(.mw-b2b-scope) input,
    :where(.mw-b2b-scope) select,
    :where(.mw-b2b-scope) textarea {
      font-family: inherit;
      font-size: 100%;
      font-weight: inherit;
      line-height: inherit;
      color: inherit;
      margin: 0;
      padding: 0;
    }
    :where(.mw-b2b-scope) button {
      background-color: transparent;
      background-image: none;
      cursor: pointer;
    }
    :where(.mw-b2b-scope) img,
    :where(.mw-b2b-scope) svg {
      display: block;
      vertical-align: middle;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .pb-safe {
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .pt-safe {
      padding-top: env(safe-area-inset-top, 0px);
    }

    /* Görünüm Modu (Telefon / Tablet / Geniş Ekran) Kuralları */
    html[data-mw-view="desktop"] .mw-b2b-app-header,
    html[data-mw-view="desktop"] .mw-b2b-bottom-nav,
    html[data-mw-view="desktop"] .mw-b2b-mobile-screen {
      display: none !important;
    }
    html[data-mw-view="desktop"] .mw-desktop-screen {
      display: block !important;
    }
    /* Telefondan giren kullanıcı Geniş Ekran moduna geçtiğinde üstte mod değiştirici bar görünür kalsın */
    @media (max-width: 991.98px) {
      html[data-mw-view="desktop"] .mw-desktop-Floating-mode-bar {
        display: flex !important;
      }
    }

    html[data-mw-view="mobile"] .mw-super-header,
    html[data-mw-view="tablet"] .mw-super-header,
    html[data-mw-view="mobile"] footer,
    html[data-mw-view="tablet"] footer,
    html[data-mw-view="mobile"] .mw-mobile-bottom-bar,
    html[data-mw-view="tablet"] .mw-mobile-bottom-bar {
      display: none !important;
    }

    html[data-mw-view="mobile"] .mw-b2b-app-header,
    html[data-mw-view="tablet"] .mw-b2b-app-header {
      display: block !important;
    }
    html[data-mw-view="mobile"] .mw-b2b-bottom-nav,
    html[data-mw-view="tablet"] .mw-b2b-bottom-nav {
      display: block !important;
    }

    /* Özel mobil tasarımı olan ekranlarda Telefon/Tablet modunda yeni ekran gösterilir, masaüstü ekran gizlenir */
    html[data-mw-view="mobile"] .mw-has-b2b-mobile .mw-desktop-screen,
    html[data-mw-view="tablet"] .mw-has-b2b-mobile .mw-desktop-screen {
      display: none !important;
    }
    html[data-mw-view="mobile"] .mw-has-b2b-mobile .mw-b2b-mobile-screen,
    html[data-mw-view="tablet"] .mw-has-b2b-mobile .mw-b2b-mobile-screen {
      display: block !important;
    }

    /* Telefon ve Tablet Modunda Gövde ve Çerçeve Ölçekleme */
    html[data-mw-view="mobile"] body,
    html[data-mw-view="tablet"] body {
      background-color: #e2e8f0;
      padding-top: 64px !important;
      padding-bottom: 88px !important;
    }
    @media (max-width: 767.98px) {
      html[data-mw-view="mobile"] body {
        background-color: #f8fafc;
      }
    }

    html[data-mw-view="mobile"] #mwMainContainer {
      max-width: 480px !important;
      width: 100% !important;
      margin: 0 auto !important;
      padding: 0 !important;
      background-color: #f8fafc;
      min-height: calc(100vh - 64px);
      box-shadow: 0 0 36px rgba(15, 23, 42, 0.08);
    }

    html[data-mw-view="tablet"] #mwMainContainer {
      max-width: 840px !important;
      width: 100% !important;
      margin: 0 auto !important;
      padding: 0 !important;
      background-color: #f8fafc;
      min-height: calc(100vh - 64px);
      box-shadow: 0 0 36px rgba(15, 23, 42, 0.08);
    }

    /* Diğer genel sayfalarda Telefon/Tablet modunda içerik boşluğu */
    html[data-mw-view="mobile"] #mwMainContainer > :not(.mw-has-b2b-mobile),
    html[data-mw-view="tablet"] #mwMainContainer > :not(.mw-has-b2b-mobile) {
      padding: 1rem;
    }
  </style>

  <!-- FAVICON YOLLARI -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="shortcut icon" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/favicon.png">

  <title>{title}</title>

  {isProduction && (
    <>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-9JZMLCVBJN');
      </script>
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-9JZMLCVBJN"></script>
    </>
  )}
</head>
<body>

  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NTZGM3S4"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <!-- MASAÜSTÜ (GENİŞ EKRAN) ÜST NAVBAR -->
  <Navbar />

  <!-- TELEFON / TABLET MODU SABİT ÜST APP HEADER (meetwork_b2b_ekosistemi Tasarımı) -->
  <header class="mw-b2b-app-header mw-b2b-scope fixed top-0 left-0 right-0 w-full z-50 pt-safe bg-surface-card/95 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.06)] border-b border-border-light" style="display:none;">
    <div class="h-16 px-3 sm:px-4 max-w-4xl mx-auto flex items-center justify-between gap-1.5">
      <!-- Sol: MeetWork Logo & B2B AĞI Rozeti -->
      <a href="/" class="flex items-center gap-1.5 shrink-0">
        <span class="font-extrabold text-lg sm:text-xl tracking-tight font-sans select-none">
          <span class="text-[#e11d48]">Meet</span><span class="text-slate-900">Work</span>
        </span>
        <span class="hidden xs:inline-block text-[10px] font-bold px-1.5 py-0.5 rounded bg-rose-50 text-[#e11d48] border border-rose-200">
          B2B AĞI
        </span>
      </a>

      <!-- Orta: 3'lü Görünüm Değiştirici Kapsül (Sadece İkon) -->
      <div class="flex items-center bg-border-subtle p-1 rounded-full shadow-inner border border-border-light gap-0.5">
        <button
          type="button"
          data-set-mw-view="mobile"
          class="mw-view-switch-btn w-9 h-8 flex items-center justify-center rounded-full bg-navy-deep text-on-secondary shadow-sm transition-all"
          title="Telefon Görünümü"
          aria-label="Telefon Görünümü"
        >
          <span class="material-symbols-outlined text-[18px]">smartphone</span>
        </button>
        <button
          type="button"
          data-set-mw-view="tablet"
          class="mw-view-switch-btn w-9 h-8 flex items-center justify-center rounded-full text-on-surface-variant hover:text-navy-deep transition-all"
          title="Tablet Görünümü"
          aria-label="Tablet Görünümü"
        >
          <span class="material-symbols-outlined text-[18px]">tablet_mac</span>
        </button>
        <button
          type="button"
          data-set-mw-view="desktop"
          class="mw-view-switch-btn w-9 h-8 flex items-center justify-center rounded-full text-on-surface-variant hover:text-navy-deep transition-all"
          title="Geniş Ekran Görünümü"
          aria-label="Geniş Ekran Görünümü"
        >
          <span class="material-symbols-outlined text-[18px]">desktop_windows</span>
        </button>
      </div>

      <!-- Sağ: Ekosistem Hızlı Geçiş (⚡), Bildirimler (🔔) ve Profil -->
      <div class="flex items-center gap-1 shrink-0">
        <button
          type="button"
          id="mwMobileBoltBtn"
          class="relative w-10 h-10 flex items-center justify-center rounded-xl bg-border-subtle text-navy-deep hover:bg-surface-variant transition-colors"
          title="Tek Tıkla Ekosistem Geçişi: StokPratik & DepodanDirekt"
        >
          <span class="material-symbols-outlined text-[20px] text-cherry-vibrant">bolt</span>
        </button>
        <button
          type="button"
          id="mwMobileNotifBtn"
          class="relative w-10 h-10 flex items-center justify-center rounded-xl bg-border-subtle text-navy-deep hover:bg-surface-variant transition-colors"
          title="Bildirimler & CariNet e-Mutabakat"
        >
          <span class="material-symbols-outlined text-[20px]">notifications</span>
          <span class=" absolute top-2 right-2 w-2.5 h-2.5 rounded-full bg-cherry-vibrant ring-2 ring-surface-card animate-pulse"></span>
        </button>
        <a href="/profilim" id="mwMobileProfileLink" class="w-10 h-10 flex items-center justify-center pl-0.5" title="Profilim & İşletme Yönetimi">
          <div class="w-8 h-8 rounded-full bg-navy-deep text-white font-bold text-xs flex items-center justify-center ring-2 ring-border-light hover:ring-cherry-vibrant transition-all" id="mwMobileProfileAvatar">
            MW
          </div>
        </a>
      </div>
    </div>

    <!-- Ticaret Modülü Alt Sekme Çubuğu (Ticaret ekranlarındayken hızlı geçiş sağlar) -->
    {isTicaret && (
      <div class="bg-surface-bg/95 border-t border-border-light px-3 py-1.5 overflow-x-auto no-scrollbar">
        <div class="max-w-4xl mx-auto flex items-center gap-1.5 min-w-max">
          <a
            href="/ihaleler"
            class={`px-3 py-1 rounded-full font-label-sm text-[11px] flex items-center gap-1 transition-all ${currentPath.startsWith('/ihaleler') ? 'bg-navy-deep text-white shadow-sm' : 'bg-surface-card text-navy-deep border border-border-light'}`}
          >
            <span class="material-symbols-outlined text-[14px]">gavel</span>
            5. Canlı İhaleler
          </a>
          <a
            href="/ihale-onay"
            class={`px-3 py-1 rounded-full font-label-sm text-[11px] flex items-center gap-1 transition-all ${currentPath.startsWith('/ihale-onay') ? 'bg-trust-emerald text-white shadow-sm' : 'bg-surface-card text-navy-deep border border-border-light'}`}
          >
            <span class="material-symbols-outlined text-[14px]">verified_user</span>
            6. İhale Onay & Güvenli Havuz
          </a>
          <a
            href="/talepler"
            class={`px-3 py-1 rounded-full font-label-sm text-[11px] flex items-center gap-1 transition-all ${currentPath.startsWith('/talepler') ? 'bg-cherry-vibrant text-white shadow-sm' : 'bg-surface-card text-navy-deep border border-border-light'}`}
          >
            <span class="material-symbols-outlined text-[14px]">groups</span>
            7. Birlikte Alalım
          </a>
          <a
            href="/ilanlar"
            class={`px-3 py-1 rounded-full font-label-sm text-[11px] flex items-center gap-1 transition-all ${currentPath.startsWith('/ilanlar') ? 'bg-navy-deep text-white shadow-sm' : 'bg-surface-card text-navy-deep border border-border-light'}`}
          >
            <span class="material-symbols-outlined text-[14px]">warehouse</span>
            8. Seri Sonu & 2.El Makine
          </a>
          <a
            href="/isletmeler"
            class={`px-3 py-1 rounded-full font-label-sm text-[11px] flex items-center gap-1 transition-all ${currentPath.startsWith('/isletmeler') ? 'bg-navy-deep text-white shadow-sm' : 'bg-surface-card text-navy-deep border border-border-light'}`}
          >
            <span class="material-symbols-outlined text-[14px]">storefront</span>
            4. İşletmeler & Toptan Katalog
          </a>
        </div>
      </div>
    )}
  </header>

  <!-- MOBİL EKOSİSTEM HIZLI GEÇİŞ & TÜM EKRANLAR ÇEKMECESİ (⚡ Bolt Butonu) -->
  <div id="mwMobileBoltDrawer" class="mw-b2b-scope hidden fixed inset-0 z-[60] bg-navy-deep/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-surface-card w-full max-w-md rounded-t-2xl sm:rounded-2xl p-4 shadow-2xl flex flex-col gap-3 max-h-[85vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-border-light pb-2.5">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-cherry-vibrant/10 text-cherry-vibrant flex items-center justify-center">
            <span class="material-symbols-outlined text-[20px]">bolt</span>
          </span>
          <div>
            <h3 class="font-headline-sm text-navy-deep font-bold">Üçlü Ekosistem & Hızlı Erişim</h3>
            <p class="font-body-sm text-on-surface-variant text-[11px]">Tek tıkla şifresiz geçiş ve B2B ekranları</p>
          </div>
        </div>
        <button type="button" id="mwCloseBoltDrawer" class="w-8 h-8 rounded-lg bg-border-subtle text-navy-deep flex items-center justify-center">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>

      <!-- Tek Tıkla Şifresiz Geçiş Kartları -->
      <div class="grid grid-cols-1 gap-2">
        <a href="https://stokpratik.com" data-sso-target="stokpratik" class="mw-sso-jump-link flex items-center justify-between p-3 rounded-xl bg-navy-deep text-white shadow-sm hover:opacity-95">
          <div class="flex items-center gap-2.5">
