  <!-- Görünüm Modu (Telefon / Tablet / Geniş Ekran) & Mobil Çekmece Yöneticisi -->
  <script is:inline>
    (function () {
      const API_URL = 'https://meetwork-api.akgcomputer.workers.dev';

      function syncViewButtons(mode) {
        document.querySelectorAll('[data-set-mw-view]').forEach((btn) => {
          const btnMode = btn.getAttribute('data-set-mw-view');
          if (btnMode === mode) {
            btn.className = 'mw-view-switch-btn w-9 h-8 flex items-center justify-center rounded-full bg-navy-deep text-on-secondary shadow-sm transition-all';
          } else {
            btn.className = 'mw-view-switch-btn w-9 h-8 flex items-center justify-center rounded-full text-on-surface-variant hover:text-navy-deep transition-all';
          }
        });
      }

      window.setMwViewMode = function (mode) {
        if (!mode) return;
        document.documentElement.setAttribute('data-mw-view', mode);
        sessionStorage.setItem('mw_view_mode_manual', mode);
        localStorage.setItem('mw_view_mode', mode);
        syncViewButtons(mode);
      };

      document.addEventListener('DOMContentLoaded', () => {
        const currentMode = document.documentElement.getAttribute('data-mw-view') || 'desktop';
        syncViewButtons(currentMode);

        document.querySelectorAll('[data-set-mw-view]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const targetMode = btn.getAttribute('data-set-mw-view');
            window.setMwViewMode(targetMode);
          });
        });

        // Kullanıcı giriş yapmışsa mobil profil ikonunu güncelle
        try {
          const rawUser = localStorage.getItem('mw_user');
          if (rawUser) {
            const user = JSON.parse(rawUser);
            const avatar = document.getElementById('mwMobileProfileAvatar');
            const link = document.getElementById('mwMobileProfileLink');
            if (user && (user.full_name || user.company_name)) {
              const initials = String(user.company_name || user.full_name || 'MW')
                .split(' ')
                .map((w) => w[0])
                .join('')
                .slice(0, 2)
                .toUpperCase();
              if (avatar) avatar.textContent = initials;
              if (link) link.setAttribute('href', '/profilim');
            }
          }
        } catch (_) {}

        // ⚡ Bolt Ekosistem Çekmecesi
        const boltBtn = document.getElementById('mwMobileBoltBtn');
        const boltDrawer = document.getElementById('mwMobileBoltDrawer');
        const closeBolt = document.getElementById('mwCloseBoltDrawer');
        if (boltBtn && boltDrawer) {
          boltBtn.addEventListener('click', () => boltDrawer.classList.remove('hidden'));
        }
        if (closeBolt && boltDrawer) {
          closeBolt.addEventListener('click', () => boltDrawer.classList.add('hidden'));
          boltDrawer.addEventListener('click', (e) => {
            if (e.target === boltDrawer) boltDrawer.classList.add('hidden');
          });
        }

        // 🔔 Mobil Bildirim & CariNet e-Mutabakat Çekmecesi
        const notifBtn = document.getElementById('mwMobileNotifBtn');
        const notifDrawer = document.getElementById('mwMobileNotifDrawer');
        const closeNotif = document.getElementById('mwCloseNotifDrawer');
        const mobileNotifList = document.getElementById('mwMobileNotifList');

        async function loadMobileNotifications() {
          if (!mobileNotifList) return;
          try {
            const res = await fetch(`${API_URL}/api/bridge/notifications?company_id=comp_meetwork_hq`);
            const data = await res.json();
            const items = data.notifications || [];
            if (items.length === 0) {
              mobileNotifList.innerHTML = `<div class="text-center py-4 font-body-sm text-on-surface-variant">Yeni ekosistem bildirimi bulunmuyor.</div>`;
              return;
            }
            mobileNotifList.innerHTML = items.map((n) => {
              const isMutabakat = n.action_type === 'approve_mutabakat' && Number(n.is_read) === 0;
              return `
                <div class="p-3 rounded-xl bg-surface-bg border border-border-light flex flex-col gap-1.5">
                  <div class="flex items-center justify-between">
                    <span class="px-2 py-0.5 rounded bg-navy-deep text-white font-label-sm text-[10px]">${n.source_app || 'MeetWork'}</span>
                    <span class="font-label-sm text-[10px] ${Number(n.is_read) === 0 ? 'text-trust-emerald' : 'text-on-surface-variant'}">${Number(n.is_read) === 0 ? '● Yeni' : '✓ Onaylandı'}</span>
                  </div>
                  <div class="font-label-lg text-navy-deep font-bold">${n.title}</div>
                  <p class="font-body-sm text-on-surface-variant">${n.message}</p>
                  ${isMutabakat ? `
                    <button type="button" data-mobile-notif-id="${n.id}" class="mw-mobile-mutabakat-btn mt-1 w-full py-2 px-3 rounded-xl bg-trust-emerald text-white font-label-md font-bold shadow-sm">
                      ${n.action_label || '✅ Bakiyeyi Onayla (Mutabıkız)'}
                    </button>
                  ` : `
                    <a href="${n.action_url || '#'}" class="mt-1 w-full py-2 px-3 rounded-xl bg-surface-card text-navy-deep border border-border-light font-label-md font-bold text-center">
                      ${n.action_label || 'Detayı İncele →'}
                    </a>
                  `}
                </div>
              `;
            }).join('');

            mobileNotifList.querySelectorAll('.mw-mobile-mutabakat-btn').forEach((b) => {
              b.addEventListener('click', async () => {
                const nid = b.getAttribute('data-mobile-notif-id');
                b.textContent = 'Onaylanıyor...';
                try {
                  const r = await fetch(`${API_URL}/api/bridge/e-mutabakat-approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ notification_id: nid })
                  });
                  const d = await r.json();
                  alert(d.message || 'CariNet e-Mutabakat onaylandı!');
                  await loadMobileNotifications();
                } catch (_) {}
              });
            });
          } catch (_) {}
        }

        if (notifBtn && notifDrawer) {
          notifBtn.addEventListener('click', () => {
            notifDrawer.classList.remove('hidden');
            loadMobileNotifications();
          });
        }
        if (closeNotif && notifDrawer) {
          closeNotif.addEventListener('click', () => notifDrawer.classList.add('hidden'));
          notifDrawer.addEventListener('click', (e) => {
            if (e.target === notifDrawer) notifDrawer.classList.add('hidden');
          });
        }
      });
    })();
  </script>

